<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <!-- Navigation -->
    <%- include('partials/header') %>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Sidebar -->
                <div class="lg:col-span-1">
                    <div class="bg-white shadow rounded-lg p-6">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 rounded-full mx-auto mb-4 overflow-hidden border-2 border-gray-200">
                                <img src="<%= customer.avatar || '/images/avatardefault.jpg' %>" alt="Avatar"
                                    class="w-full h-full object-cover">
                            </div>
                            <h3 class="text-lg font-medium text-gray-900">
                                <%= customer.full_name || customer.name || 'Khách hàng' %>
                            </h3>
                            <p class="text-sm text-gray-500">
                                <%= customer.email || '' %>
                            </p>
                        </div>

                        <nav class="space-y-1">
                            <a href="/customer/profile"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Tài khoản
                            </a>
                            <a href="/customer/orders"
                                class="bg-indigo-50 text-indigo-700 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-indigo-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                Đơn hàng
                            </a>
                            <a href="/customer/settings"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                Cài đặt
                            </a>
                            <a href="/customer/logout"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Đăng xuất
                            </a>
                        </nav>
                    </div>
                </div>

                <!-- Content -->
                <div class="lg:col-span-3">
                    <div class="bg-white shadow rounded-lg p-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6">Đơn hàng của bạn</h2>

                        <% if (orders.length> 0) { %>
                            <div class="space-y-6">
                                <% orders.forEach(order=> { %>
                                    <div class="border rounded-lg p-6">
                                        <div class="flex justify-between items-start mb-4">
                                            <div>
                                                <h3 class="text-lg font-medium text-gray-900">Đơn hàng #<%= order.id %>
                                                </h3>
                                                <p class="text-sm text-gray-500">Ngày đặt: <%= new
                                                        Date(order.created_at).toLocaleDateString('vi-VN') %>
                                                </p>
                                                <p class="text-sm text-gray-500">Phương thức thanh toán: <%=
                                                        order.payment_method || 'COD' %>
                                                </p>
                                            </div>
                                            <span class="px-3 py-1 text-sm font-medium rounded-full 
                                            <% if (order.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } %>
                                            <% if (order.status === 'confirmed') { %>bg-blue-100 text-blue-800<% } %>
                                            <% if (order.status === 'processing') { %>bg-purple-100 text-purple-800<% } %>
                                            <% if (order.status === 'shipped') { %>bg-indigo-100 text-indigo-800<% } %>
                                            <% if (order.status === 'delivered') { %>bg-green-100 text-green-800<% } %>
                                            <% if (order.status === 'cancelled') { %>bg-red-100 text-red-800<% } %>
                                        ">
                                                <%= order.status==='pending' ? 'Chờ xử lý' : '' %>
                                                    <%= order.status==='confirmed' ? 'Đã xác nhận' : '' %>
                                                        <%= order.status==='processing' ? 'Đang xử lý' : '' %>
                                                            <%= order.status==='shipped' ? 'Đang giao' : '' %>
                                                                <%= order.status==='delivered' ? 'Đã giao' : '' %>
                                                                    <%= order.status==='cancelled' ? 'Đã hủy' : '' %>
                                            </span>
                                        </div>

                                        <!-- Order Progress Timeline -->
                                        <div class="mt-4 mb-8">
                                            <div class="relative">
                                                <% const statuses=[ { id: 'pending' , name: 'Chờ xử lý' ,
                                                    icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' }, {
                                                    id: 'confirmed' , name: 'Đã xác nhận' ,
                                                    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' }, {
                                                    id: 'processing' , name: 'Đang xử lý' ,
                                                    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4'
                                                    }, { id: 'shipped' , name: 'Đang giao' ,
                                                    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4' }, {
                                                    id: 'delivered' , name: 'Đã giao' , icon: 'M5 13l4 4L19 7' } ]; let
                                                    currentIndex=-1; if (order.status !=='cancelled' ) {
                                                    currentIndex=statuses.findIndex(s=> s.id === order.status);
                                                    if (currentIndex === -1 && order.status === 'completed')
                                                    currentIndex = 4;
                                                    }
                                                    %>

                                                    <% if (order.status==='cancelled' ) { %>
                                                        <div
                                                            class="bg-red-50 border border-red-200 rounded-md p-4 flex items-center">
                                                            <div class="flex-shrink-0">
                                                                <svg class="h-5 w-5 text-red-400" fill="none"
                                                                    viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                                </svg>
                                                            </div>
                                                            <div class="ml-3">
                                                                <h3 class="text-sm font-medium text-red-800">Đơn hàng đã
                                                                    bị hủy</h3>
                                                                <p class="text-sm text-red-700 mt-1">Đơn hàng này không
                                                                    còn được xử lý.</p>
                                                            </div>
                                                        </div>
                                                        <% } else { %>
                                                            <div class="overflow-hidden">
                                                                <div
                                                                    class="flex items-center justify-between relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full md:before:h-0.5 before:w-0.5 md:before:w-full before:bg-gray-200 before:top-4 md:before:top-5 md:before:left-0 md:before:right-0 z-0">
                                                                    <% statuses.forEach((step, index)=> {
                                                                        const isCompleted = index <= currentIndex; const
                                                                            isCurrent=index===currentIndex; %>
                                                                            <div
                                                                                class="relative z-10 flex md:flex-col items-center gap-3 md:gap-x-0">
                                                                                <div
                                                                                    class="flex items-center justify-center w-10 h-10 rounded-full border-2 <%= isCompleted ? 'bg-indigo-600 border-indigo-600 text-white' : 'bg-white border-gray-300 text-gray-400' %> <%= isCurrent ? 'ring-4 ring-indigo-100' : '' %> transition-colors duration-200">
                                                                                    <svg class="w-5 h-5" fill="none"
                                                                                        stroke="currentColor"
                                                                                        viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round"
                                                                                            stroke-linejoin="round"
                                                                                            stroke-width="2"
                                                                                            d="<%= step.icon %>" />
                                                                                    </svg>
                                                                                </div>
                                                                                <div
                                                                                    class="mt-0 md:mt-2 text-left md:text-center w-24">
                                                                                    <p
                                                                                        class="text-xs font-medium <%= isCompleted ? 'text-indigo-900' : 'text-gray-500' %>">
                                                                                        <%= step.name %>
                                                                                    </p>
                                                                                </div>
                                                                            </div>
                                                                            <% }) %>
                                                                                <!-- Active Progress Line (Desktop) -->
                                                                                <% if (currentIndex> 0) { %>
                                                                                    <div class="hidden md:block absolute top-5 left-0 h-0.5 bg-indigo-600 z-0 transition-all duration-500"
                                                                                        style="width: <%= (currentIndex / (statuses.length - 1)) * 100 %>%">
                                                                                    </div>
                                                                                    <% } %>
                                                                                        <!-- Active Progress Line (Mobile) -->
                                                                                        <% if (currentIndex> 0) { %>
                                                                                            <div class="md:hidden absolute top-4 left-5 w-0.5 bg-indigo-600 z-0 transition-all duration-500"
                                                                                                style="height: <%= (currentIndex / (statuses.length - 1)) * 100 %>%">
                                                                                            </div>
                                                                                            <% } %>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                            </div>
                                        </div>

                                        <% if (order.items && order.items.length> 0) { %>
                                            <div class="mb-4">
                                                <h4 class="text-sm font-medium text-gray-900 mb-2">Sản phẩm:</h4>
                                                <div class="space-y-4">
                                                    <% order.items.forEach(item=> { %>
                                                        <div
                                                            class="flex items-center space-x-4 border-b border-gray-100 pb-4 last:border-0 last:pb-0">
                                                            <% if (item.image_url) { %>
                                                                <img src="<%= item.image_url %>"
                                                                    alt="<%= item.product_name %>"
                                                                    class="w-16 h-16 object-cover text-gray-200 rounded">
                                                                <% } else { %>
                                                                    <div
                                                                        class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                                                                        <svg class="h-8 w-8 text-gray-400" fill="none"
                                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round"
                                                                                stroke-linejoin="round" stroke-width="2"
                                                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                                        </svg>
                                                                    </div>
                                                                    <% } %>
                                                                        <div class="flex-1">
                                                                            <p
                                                                                class="text-sm font-medium text-gray-900">
                                                                                <%= item.product_name %>
                                                                            </p>
                                                                            <% if (item.variant_info) { %>
                                                                                <% let vInfo='' ; try { const
                                                                                    viObj=typeof
                                                                                    item.variant_info==='string' ?
                                                                                    JSON.parse(item.variant_info) :
                                                                                    item.variant_info; vInfo=`Size:
                                                                                    ${viObj.size || '' }, Màu:
                                                                                    ${viObj.color || '' }`; } catch(e) {
                                                                                    vInfo=item.variant_info; } %>
                                                                                    <p class="text-xs text-gray-500">
                                                                                        <%= vInfo %>
                                                                                    </p>
                                                                                    <% } %>
                                                                                        <p
                                                                                            class="text-sm text-gray-500">
                                                                                            Số lượng: <%= item.quantity
                                                                                                %>
                                                                                        </p>
                                                                        </div>
                                                                        <div class="text-right">
                                                                            <p
                                                                                class="text-sm text-gray-900 font-medium">
                                                                                <%= Number(item.price *
                                                                                    item.quantity).toLocaleString('vi-VN')
                                                                                    %>đ
                                                                            </p>
                                                                        </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <div class="border-t pt-4">
                                                    <div class="flex justify-between items-center">
                                                        <div>
                                                            <p class="text-sm text-gray-500">Tạm tính</p>
                                                            <p class="text-sm text-gray-500">Phí vận chuyển</p>
                                                            <p class="text-sm text-gray-500">Giảm giá</p>
                                                            <p class="text-lg font-medium text-gray-900">Tổng cộng</p>
                                                        </div>
                                                        <div class="text-right">
                                                            <p class="text-sm text-gray-900">
                                                                <%= Number(order.subtotal ||
                                                                    order.total_amount).toLocaleString('vi-VN') %>đ
                                                            </p>
                                                            <p class="text-sm text-gray-900">
                                                                <%= Number(order.shipping_amount ||
                                                                    0).toLocaleString('vi-VN') %>đ
                                                            </p>
                                                            <p class="text-sm text-gray-900">-<%=
                                                                    Number(order.discount_amount ||
                                                                    0).toLocaleString('vi-VN') %>đ</p>
                                                            <p class="text-lg font-medium text-gray-900">
                                                                <%= Number(order.total_amount).toLocaleString('vi-VN')
                                                                    %>đ
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mt-4 flex space-x-4">
                                                    <button onclick="openDetailModal('<%= order.id %>')"
                                                        class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                                        Xem chi tiết
                                                    </button>
                                                    <% if (order.status === 'delivered') { %>
                                                        <button onclick="openReviewModal('<%= order.id %>')"
                                                            class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                                            Đánh giá sản phẩm
                                                        </button>
                                                    <% } %>
                                                    <% if (order.status === 'pending') { %>
                                                        <button onclick="cancelOrder('<%= order.id %>')"
                                                            class="text-red-600 hover:text-red-800 text-sm font-medium">
                                                            Hủy đơn hàng
                                                        </button>
                                                    <% } %>
                                                </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <div class="text-center py-12">
                                    <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                    </svg>
                                    <h3 class="text-lg font-medium text-gray-900 mb-2">Chưa có đơn hàng</h3>
                                    <p class="text-gray-500 mb-6">Bạn chưa đặt đơn hàng nào. Hãy mua sắm ngay!</p>
                                    <a href="/products"
                                        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                        Mua sắm ngay
                                    </a>
                                </div>
                                <% } %>
                    </div>
                </div>
            </div>
        </main>

        <!-- Modal Chi tiết đơn hàng -->
        <div id="orderDetailModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title"
            role="dialog" aria-modal="true">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"
                    onclick="closeDetailModal()"></div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div
                    class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full">
                    <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <div class="sm:flex sm:items-start">
                            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title-detail">Chi tiết đơn
                                    hàng</h3>
                                <div class="mt-4" id="modal-content">
                                    <!-- JS content goes here -->
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                        <button type="button" onclick="closeDetailModal()"
                            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                            Đóng
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Review Modal -->
        <div id="reviewModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title"
            role="dialog" aria-modal="true">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"
                    onclick="closeReviewModal()"></div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div
                    class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-xl sm:w-full">
                    <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Đánh giá sản phẩm</h3>
                        
                        <div id="reviewProductList" class="space-y-4 max-h-60 overflow-y-auto mb-4 border-b pb-4">
                            <!-- Products will be listed here -->
                        </div>

                        <div id="reviewForm" class="hidden">
                            <input type="hidden" id="reviewProductId">
                            <input type="hidden" id="reviewOrderId">
                            
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Đánh giá của bạn</label>
                                <div class="flex items-center space-x-1" id="starRating">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <button type="button" onclick="setRating(<%= i %>)" class="star-btn text-gray-300 hover:text-yellow-400 transition-colors" data-rating="<%= i %>">
                                            <svg class="w-8 h-8 fill-current" viewBox="0 0 20 20">
                                                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                                            </svg>
                                        </button>
                                    <% } %>
                                </div>
                                <input type="hidden" id="selectedRating" value="5">
                            </div>

                            <div class="mb-4">
                                <label for="reviewTitle" class="block text-sm font-medium text-gray-700 mb-1">Tiêu đề (Không bắt buộc)</label>
                                <input type="text" id="reviewTitle" class="w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="Nhận xét chung...">
                            </div>

                            <div class="mb-4">
                                <label for="reviewContent" class="block text-sm font-medium text-gray-700 mb-1">Nội dung đánh giá</label>
                                <textarea id="reviewContent" rows="3" class="w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..."></textarea>
                            </div>

                            <div class="flex justify-end space-x-3">
                                <button type="button" onclick="closeReviewModal()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Hủy</button>
                                <button type="button" onclick="submitReview()" id="submitReviewBtn" class="px-4 py-2 bg-indigo-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                    Gửi đánh giá
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const userOrders = <%- JSON.stringify(orders || []) %>;
            let currentRating = 5;

            // Review Modal logic
            function openReviewModal(orderId) {
                const order = userOrders.find(o => o.id == orderId);
                if (!order) return;

                const productList = document.getElementById('reviewProductList');
                productList.innerHTML = '';
                
                order.items.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center justify-between p-3 border rounded-lg hover:bg-gray-50 cursor-pointer transition-colors';
                    div.onclick = () => selectProductToReview(item.product_id, order.id, item.product_name);
                    div.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <img src="${item.image_url || '/images/placeholder.jpg'}" class="w-12 h-12 object-cover rounded">
                            <div>
                                <p class="text-sm font-medium text-gray-900">${item.product_name}</p>
                                <p class="text-xs text-gray-500">${item.variant_info || ''}</p>
                            </div>
                        </div>
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    `;
                    productList.appendChild(div);
                });

                document.getElementById('reviewForm').classList.add('hidden');
                document.getElementById('reviewModal').classList.remove('hidden');
            }

            function selectProductToReview(productId, orderId, productName) {
                document.getElementById('reviewProductId').value = productId;
                document.getElementById('reviewOrderId').value = orderId;
                document.getElementById('reviewForm').classList.remove('hidden');
                
                // Show product name in header or somewhere
                const title = document.querySelector('#reviewModal h3');
                title.textContent = `Đánh giá: ${productName}`;
                
                // Reset form
                setRating(5);
                document.getElementById('reviewTitle').value = '';
                document.getElementById('reviewContent').value = '';
            }

            function setRating(rating) {
                currentRating = rating;
                document.getElementById('selectedRating').value = rating;
                const stars = document.querySelectorAll('.star-btn');
                stars.forEach((star, index) => {
                    if (index < rating) {
                        star.classList.add('text-yellow-400');
                        star.classList.remove('text-gray-300');
                    } else {
                        star.classList.remove('text-yellow-400');
                        star.classList.add('text-gray-300');
                    }
                });
            }

            async function submitReview() {
                const productId = document.getElementById('reviewProductId').value;
                const orderId = document.getElementById('reviewOrderId').value;
                const rating = document.getElementById('selectedRating').value;
                const title = document.getElementById('reviewTitle').value;
                const content = document.getElementById('reviewContent').value;
                const submitBtn = document.getElementById('submitReviewBtn');

                if (!content) {
                    alert('Vui lòng nhập nội dung đánh giá');
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.textContent = 'Đang gửi...';

                try {
                    const response = await fetch('/customer/reviews/submit', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, orderId, rating, title, content })
                    });
                    const result = await response.json();
                    
                    if (result.success) {
                        alert(result.message);
                        closeReviewModal();
                        // Optional: mark item as reviewed in UI or refresh
                        window.location.reload();
                    } else {
                        alert(result.message || 'Lỗi khi gửi đánh giá');
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Gửi đánh giá';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra, vui lòng thử lại sau.');
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Gửi đánh giá';
                }
            }

            function closeReviewModal() {
                document.getElementById('reviewModal').classList.add('hidden');
                document.querySelector('#reviewModal h3').textContent = 'Đánh giá sản phẩm';
            }

            // Hủy đơn hàng
            async function cancelOrder(orderId) {
                if (!confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Thao tác này không thể hoàn tác và hàng tồn kho sẽ được hoàn lạỉ.')) {
                    return;
                }
                try {
                    const response = await fetch(`/customer/orders/${orderId}/cancel`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const result = await response.json();
                    if (result.success) {
                        alert('Hủy đơn hàng thành công!');
                        window.location.reload();
                    } else {
                        alert(result.message || 'Lỗi khi hủy đơn hàng');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Có lỗi xảy ra, vui lòng thử lại sau.');
                }
            }

            // Xem chi tiết
            function openDetailModal(orderId) {
                const order = userOrders.find(o => o.id == orderId);
                if (!order) return;

                const modal = document.getElementById('orderDetailModal');
                const content = document.getElementById('modal-content');

                const dateStr = new Date(order.created_at).toLocaleString('vi-VN');
                const totalStr = Number(order.total_amount).toLocaleString('vi-VN');

                const statusMap = {
                    'pending': 'Chờ xử lý',
                    'confirmed': 'Đã xác nhận',
                    'processing': 'Đang xử lý',
                    'shipped': 'Đang giao',
                    'delivered': 'Đã giao',
                    'cancelled': 'Đã hủy'
                };
                const statusStr = statusMap[order.status] || order.status;

                content.innerHTML = `
                <div class="mb-4">
                    <p class="text-sm text-gray-500">Mã đơn: <strong class="text-gray-900">#${order.id}</strong></p>
                    <p class="text-sm text-gray-500">Ngày đặt: ${dateStr}</p>
                    <p class="text-sm text-gray-500">Trạng thái: <strong class="text-indigo-600 uppercase">${statusStr}</strong></p>
                </div>
                <div class="border-t border-gray-200 pt-4 mb-4">
                    <h4 class="font-medium text-gray-900 mb-2">Thông tin giao hàng</h4>
                    <p class="text-sm text-gray-700">Điện thoại: ${order.phone || 'N/A'}</p>
                    <p class="text-sm text-gray-700">Địa chỉ: ${order.shipping_address || 'N/A'}</p>
                    <p class="text-sm text-gray-700">Thanh toán: ${order.payment_method === 'cod' ? 'Tiền mặt (COD)' : order.payment_method}</p>
                </div>
                <div class="border-t border-gray-200 pt-4">
                    <h4 class="font-medium text-gray-900 mb-2">Tổng kết hóa đơn</h4>
                    <div class="flex justify-between text-sm mb-1"><span class="text-gray-500">Tạm tính:</span><span>${Number(order.subtotal || order.total_amount).toLocaleString('vi-VN')}đ</span></div>
                    <div class="flex justify-between text-sm mb-1"><span class="text-gray-500">Phí Ship:</span><span>${Number(order.shipping_amount || 0).toLocaleString('vi-VN')}đ</span></div>
                    <div class="flex justify-between font-bold text-lg mt-2 text-indigo-600 border-t pt-2"><span>Tổng thu:</span><span>${totalStr}đ</span></div>
                </div>
            `;
                modal.classList.remove('hidden');
            }

            function closeDetailModal() {
                document.getElementById('orderDetailModal').classList.add('hidden');
            }
        </script>
</body>

</html>