<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-2xl font-bold text-indigo-600">DDAWNG</a>
                </div>
                <div class="flex items-center space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600">Trang chủ</a>
                    <a href="/products" class="text-gray-700 hover:text-indigo-600">Sản phẩm</a>
                    <div class="relative">
                        <button class="text-gray-700 hover:text-indigo-600 flex items-center">
                            <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Tài khoản
                        </button>
                    </div>
                    <a href="/cart" class="text-gray-700 hover:text-indigo-600">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white shadow rounded-lg p-6">
                    <div class="text-center mb-6">
                        <div class="w-20 h-20 bg-gray-300 rounded-full mx-auto mb-4 flex items-center justify-center">
                            <svg class="h-10 w-10 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900">Khách hàng</h3>
                        <p class="text-sm text-gray-500">customer@example.com</p>
                    </div>
                    
                    <nav class="space-y-1">
                        <a href="/customer/profile" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Tài khoản
                        </a>
                        <a href="/customer/orders" class="bg-indigo-50 text-indigo-700 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            Đơn hàng
                        </a>
                        <a href="/customer/settings" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            Cài đặt
                        </a>
                        <a href="/customer/logout" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Đăng xuất
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Content -->
            <div class="lg:col-span-3">
                <div class="bg-white shadow rounded-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Đơn hàng của bạn</h2>
                    
                    <% if (orders.length > 0) { %>
                        <div class="space-y-6">
                            <% orders.forEach(order => { %>
                                <div class="border rounded-lg p-6">
                                    <div class="flex justify-between items-start mb-4">
                                        <div>
                                            <h3 class="text-lg font-medium text-gray-900">Đơn hàng #<%= order.id %></h3>
                                            <p class="text-sm text-gray-500">Ngày đặt: <%= new Date(order.created_at).toLocaleDateString('vi-VN') %></p>
                                            <p class="text-sm text-gray-500">Phương thức thanh toán: <%= order.payment_method || 'COD' %></p>
                                        </div>
                                        <span class="px-3 py-1 text-sm font-medium rounded-full 
                                            <% if (order.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } %>
                                            <% if (order.status === 'confirmed') { %>bg-blue-100 text-blue-800<% } %>
                                            <% if (order.status === 'processing') { %>bg-purple-100 text-purple-800<% } %>
                                            <% if (order.status === 'shipped') { %>bg-indigo-100 text-indigo-800<% } %>
                                            <% if (order.status === 'delivered') { %>bg-green-100 text-green-800<% } %>
                                            <% if (order.status === 'cancelled') { %>bg-red-100 text-red-800<% } %>
                                        ">
                                            <%= order.status === 'pending' ? 'Chờ xử lý' : '' %>
                                            <%= order.status === 'confirmed' ? 'Đã xác nhận' : '' %>
                                            <%= order.status === 'processing' ? 'Đang xử lý' : '' %>
                                            <%= order.status === 'shipped' ? 'Đang giao' : '' %>
                                            <%= order.status === 'delivered' ? 'Đã giao' : '' %>
                                            <%= order.status === 'cancelled' ? 'Đã hủy' : '' %>
                                        </span>
                                    </div>
                                    
                                    <% if (order.product_name) { %>
                                        <div class="mb-4">
                                            <h4 class="text-sm font-medium text-gray-900 mb-2">Sản phẩm:</h4>
                                            <div class="flex items-center space-x-4">
                                                <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                                                    <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <p class="text-sm font-medium text-gray-900"><%= order.product_name %></p>
                                                    <p class="text-sm text-gray-500">Số lượng: <%= order.quantity || 1 %></p>
                                                    <p class="text-sm text-gray-500">Đơn giá: <%= Number(order.price || order.total_amount).toLocaleString('vi-VN') %>đ</p>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                    
                                    <div class="border-t pt-4">
                                        <div class="flex justify-between items-center">
                                            <div>
                                                <p class="text-sm text-gray-500">Tạm tính</p>
                                                <p class="text-sm text-gray-500">Phí vận chuyển</p>
                                                <p class="text-sm text-gray-500">Giảm giá</p>
                                                <p class="text-lg font-medium text-gray-900">Tổng cộng</p>
                                            </div>
                                            <div class="text-right">
                                                <p class="text-sm text-gray-900"><%= Number(order.subtotal || order.total_amount).toLocaleString('vi-VN') %>đ</p>
                                                <p class="text-sm text-gray-900"><%= Number(order.shipping_amount || 0).toLocaleString('vi-VN') %>đ</p>
                                                <p class="text-sm text-gray-900">-<%= Number(order.discount_amount || 0).toLocaleString('vi-VN') %>đ</p>
                                                <p class="text-lg font-medium text-gray-900"><%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="mt-4 flex space-x-4">
                                        <button class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                            Xem chi tiết
                                        </button>
                                        <% if (order.status === 'delivered') { %>
                                            <button class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                                Đánh giá sản phẩm
                                            </button>
                                        <% } %>
                                        <% if (order.status === 'pending' || order.status === 'confirmed') { %>
                                            <button class="text-red-600 hover:text-red-800 text-sm font-medium">
                                                Hủy đơn hàng
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <h3 class="text-lg font-medium text-gray-900 mb-2">Chưa có đơn hàng</h3>
                            <p class="text-gray-500 mb-6">Bạn chưa đặt đơn hàng nào. Hãy mua sắm ngay!</p>
                            <a href="/products" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                Mua sắm ngay
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
