<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm sản phẩm mới - DDAWNG Store Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-indigo-600">DDAWNG Admin</h1>
                    <nav class="hidden md:flex space-x-8">
                        <a href="/admin/dashboard" class="text-gray-700 hover:text-indigo-600">Dashboard</a>
                        <a href="/admin/products" class="text-gray-700 hover:text-indigo-600">Sản phẩm</a>
                        <a href="/admin/orders" class="text-gray-700 hover:text-indigo-600">Đơn hàng</a>
                        <a href="/admin/customers" class="text-gray-700 hover:text-indigo-600">Khách hàng</a>
                    </nav>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-700">Xin chào, Admin</span>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                        </svg>
                    </button>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </button>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-3xl sm:truncate">Thêm sản phẩm mới</h1>
                <p class="mt-2 text-sm text-gray-700">Điền thông tin chi tiết để thêm sản phẩm mới vào cửa hàng</p>
            </div>
            <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
                <a href="/admin/products" class="inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Quay lại
                </a>
            </div>
        </div>

        <!-- Form -->
        <form class="mt-8 space-y-6" action="/admin/products/add" method="POST">
            <div class="bg-white shadow overflow-hidden sm:rounded-md">
                <div class="px-4 py-5 sm:p-6 space-y-6">
                    <!-- Basic Information -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Thông tin cơ bản</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="productName" class="block text-sm font-medium text-gray-700 mb-2">Tên sản phẩm *</label>
                                <input type="text" id="productName" name="productName" required
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                                    placeholder="nhập tên sản phẩm">
                            </div>
                            <div>
                                <label for="productCode" class="block text-sm font-medium text-gray-700 mb-2">Mã sản phẩm *</label>
                                <input type="text" id="productCode" name="productCode" required
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                                    placeholder="nhập mã sản phẩm">
                            </div>
                        </div>
                        <div class="mt-6">
                            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">Mô tả sản phẩm *</label>
                            <textarea id="description" name="description" rows="4" required
                                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                                placeholder="Mô tả chi tiết về sản phẩm, chất liệu, đặc điểm nổi bật..."></textarea>
                        </div>
                    </div>

                    <!-- Category and Price -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Danh mục và giá</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label for="category" class="block text-sm font-medium text-gray-700 mb-2">Danh mục *</label>
                                <select id="category" name="category" required
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    <option value="">Chọn danh mục</option>
                                    <% if (categories && categories.length > 0) { %>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>"><%= category.name %></option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="" disabled>Không có danh mục nào</option>
                                    <% } %>
                                </select>
                            </div>
                            <div>
                                <label for="price" class="block text-sm font-medium text-gray-700 mb-2">Giá bán *</label>
                                <input type="number" id="price" name="price" required min="0"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                                    placeholder="599000">
                            </div>
                        </div>
                    </div>

                    <!-- Inventory -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Tồn kho</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Tổng số lượng tồn kho</label>
                                <div class="block w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                                    <span id="totalStock">0</span> sản phẩm
                                </div>
                                <p class="mt-1 text-sm text-gray-500">Tự động tính từ tổng số lượng các biến thể</p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Trạng thái</label>
                                <select id="status" name="status" required
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    <option value="active">Còn hàng</option>
                                    <option value="out_of_stock">Hết hàng</option>
                                    <option value="discontinued">Ngừng kinh doanh</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Product Variants -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Biến thể sản phẩm (Size & Màu sắc)</h3>
                        <div class="space-y-4">
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h4 class="text-sm font-medium text-gray-700 mb-3">Thêm biến thể sản phẩm</h4>
                                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Size</label>
                                        <select id="variantSize" class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                            <option value="">Chọn size</option>
                                            <% if (sizes && sizes.length > 0) { %>
                                                <% sizes.forEach(size => { %>
                                                    <option value="<%= size.id %>"><%= size.name %></option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Màu sắc</label>
                                        <select id="variantColor" class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                            <option value="">Chọn màu</option>
                                            <% if (colors && colors.length > 0) { %>
                                                <% colors.forEach(color => { %>
                                                    <option value="<%= color.id %>"><%= color.name %></option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Số lượng</label>
                                        <input type="number" id="variantStock" min="0" placeholder="0" 
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">&nbsp;</label>
                                        <button type="button" onclick="addVariant()" 
                                            class="w-full bg-indigo-600 text-white px-3 py-2 rounded-md text-sm hover:bg-indigo-700 transition">
                                            Thêm biến thể
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div>
                                <h4 class="text-sm font-medium text-gray-700 mb-2">Danh sách biến thể</h4>
                                <div id="variantsList" class="space-y-2 max-h-60 overflow-y-auto">
                                    <!-- Variants will be added here dynamically -->
                                    <div class="text-gray-500 text-sm text-center py-4 border-2 border-dashed border-gray-300 rounded-lg">
                                        Chưa có biến thể nào được thêm
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Images -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Hình ảnh sản phẩm</h3>
                        <div class="space-y-4">
                            <div>
                                <label for="mainImageUrl" class="block text-sm font-medium text-gray-700 mb-2">URL hình ảnh chính *</label>
                                <div class="flex items-center space-x-4">
                                    <input type="url" id="mainImageUrl" name="mainImageUrl" required
                                        placeholder="https://example.com/image.jpg"
                                        class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    <div class="flex-shrink-0">
                                        <div class="w-20 h-20 bg-gray-200 rounded-lg flex items-center justify-center">
                                            <img id="mainImagePreview" src="" alt="Preview" class="w-full h-full object-cover rounded-lg hidden">
                                            <svg id="mainImagePlaceholder" class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label for="additionalImageUrls" class="block text-sm font-medium text-gray-700 mb-2">URL hình ảnh bổ sung</label>
                                <textarea id="additionalImageUrls" name="additionalImageUrls" rows="3"
                                    placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg&#10;https://example.com/image3.jpg"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                                <p class="mt-1 text-sm text-gray-500">Mỗi URL trên một dòng</p>
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Trạng thái</h3>
                        <div class="flex items-center space-x-4">
                            <label class="flex items-center">
                                <input type="radio" name="status" value="active" checked class="mr-2">
                                <span class="text-sm text-gray-700">Hoạt động</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="status" value="inactive" class="mr-2">
                                <span class="text-sm text-gray-700">Không hoạt động</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="featured" class="mr-2">
                                <span class="text-sm text-gray-700">Sản phẩm nổi bật</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
                    <button type="button" onclick="window.location.href='/admin/products'" 
                        class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3">
                        Hủy
                    </button>
                    <button type="submit" 
                        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Thêm sản phẩm
                    </button>
                </div>
            </div>
        </form>
    </main>

    <script>
        // Product Variants Management
        let variants = [];
        let variantIdCounter = 0;
        
        // Get size and color names from dropdowns
        function getSizeName(sizeId) {
            const select = document.getElementById('variantSize');
            const option = select.querySelector(`option[value="${sizeId}"]`);
            return option ? option.textContent : '';
        }
        
        function getColorName(colorId) {
            const select = document.getElementById('variantColor');
            const option = select.querySelector(`option[value="${colorId}"]`);
            return option ? option.textContent : '';
        }
        
        function addVariant() {
            const sizeId = document.getElementById('variantSize').value;
            const colorId = document.getElementById('variantColor').value;
            const stock = document.getElementById('variantStock').value || 0;
            
            if (!sizeId || !colorId) {
                alert('Vui lòng chọn size và màu sắc!');
                return;
            }
            
            // Check for duplicate
            const exists = variants.find(v => v.sizeId === sizeId && v.colorId === colorId);
            if (exists) {
                alert('Biến thể này đã tồn tại!');
                return;
            }
            
            const variant = {
                id: ++variantIdCounter,
                sizeId: sizeId,
                colorId: colorId,
                stock: stock,
                sizeName: getSizeName(sizeId),
                colorName: getColorName(colorId)
            };
            
            variants.push(variant);
            renderVariants();
            updateTotalStock();
            
            // Clear form
            document.getElementById('variantSize').value = '';
            document.getElementById('variantColor').value = '';
            document.getElementById('variantStock').value = '';
        }
        
        function removeVariant(id) {
            variants = variants.filter(v => v.id !== id);
            renderVariants();
            updateTotalStock();
        }
        
        function updateTotalStock() {
            const totalStock = variants.reduce((sum, variant) => sum + parseInt(variant.stock || 0), 0);
            document.getElementById('totalStock').textContent = totalStock;
        }
        
        function renderVariants() {
            const container = document.getElementById('variantsList');
            
            if (variants.length === 0) {
                container.innerHTML = `
                    <div class="text-gray-500 text-sm text-center py-4 border-2 border-dashed border-gray-300 rounded-lg">
                        Chưa có biến thể nào được thêm
                    </div>
                `;
                return;
            }
            
            container.innerHTML = variants.map(variant => `
                <div class="flex items-center justify-between bg-white p-3 border rounded-lg">
                    <div class="flex items-center space-x-4">
                        <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded">${variant.sizeName}</span>
                        <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded">${variant.colorName}</span>
                        <span class="text-sm text-gray-600">SL: ${variant.stock}</span>
                    </div>
                    <button type="button" onclick="removeVariant(${variant.id})" 
                        class="text-red-500 hover:text-red-700">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <input type="hidden" name="variants[]" value="${JSON.stringify(variant)}">
            `).join('');
        }
        
        // Preview image from URL
        document.getElementById('mainImageUrl').addEventListener('input', function(e) {
            const url = e.target.value.trim();
            const preview = document.getElementById('mainImagePreview');
            const placeholder = document.getElementById('mainImagePlaceholder');
            
            if (url) {
                // Test if URL is valid image
                const img = new Image();
                img.onload = function() {
                    preview.src = url;
                    preview.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                };
                img.onerror = function() {
                    preview.classList.add('hidden');
                    placeholder.classList.remove('hidden');
                };
                img.src = url;
            } else {
                preview.classList.add('hidden');
                placeholder.classList.remove('hidden');
            }
        });

        // Form validation and submission
        document.querySelector('form').addEventListener('submit', function(e) {
            console.log('🚀 Form submit triggered');
            
            // Add variants data to form
            const variantsInput = document.createElement('input');
            variantsInput.type = 'hidden';
            variantsInput.name = 'variants';
            variantsInput.value = JSON.stringify(variants);
            this.appendChild(variantsInput);
            
            console.log('📋 Variants data added:', variants);
            
            const required = this.querySelectorAll('[required]');
            let valid = true;
            
            console.log('📋 Required fields count:', required.length);
            
            required.forEach((field, index) => {
                console.log(`📋 Field ${index + 1}:`, {
                    name: field.name,
                    value: field.value,
                    valid: !!field.value.trim()
                });
                
                if (!field.value.trim()) {
                    field.classList.add('border-red-500');
                    valid = false;
                    console.log('❌ Invalid field:', field.name);
                } else {
                    field.classList.remove('border-red-500');
                    console.log('✅ Valid field:', field.name);
                }
            });

            if (variants.length === 0) {
                console.log('❌ No variants added');
                alert('Vui lòng thêm ít nhất một biến thể sản phẩm!');
                e.preventDefault();
                return;
            }

            if (!valid) {
                console.log('❌ Form validation failed');
                e.preventDefault();
                alert('Vui lòng điền đầy đủ các trường bắt buộc!');
                return;
            }
            
            console.log('✅ Form validation passed, submitting...');
        });
    </script>
</body>
</html>
