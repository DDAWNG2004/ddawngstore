<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cài đặt - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <!-- Navigation -->
    <%- include('partials/header') %>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Sidebar -->
                <div class="lg:col-span-1">
                    <div class="bg-white shadow rounded-lg p-6">
                        <div class="text-center mb-6">
                            <div class="w-20 h-20 rounded-full mx-auto mb-4 overflow-hidden border-2 border-gray-200">
                                <img src="<%= customer.avatar || '/images/avatardefault.jpg' %>" alt="Avatar"
                                    class="w-full h-full object-cover">
                            </div>
                            <h3 class="text-lg font-medium text-gray-900">
                                <%= customer.full_name || customer.name || 'Khách hàng' %>
                            </h3>
                            <p class="text-sm text-gray-500">
                                <%= customer.email || '' %>
                            </p>
                        </div>

                        <nav class="space-y-1">
                            <a href="/customer/profile"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Tài khoản
                            </a>
                            <a href="/customer/orders"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                Đơn hàng
                            </a>
                            <a href="/customer/settings"
                                class="bg-indigo-50 text-indigo-700 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-indigo-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                Cài đặt
                            </a>
                            <a href="/customer/logout"
                                class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none"
                                    stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Đăng xuất
                            </a>
                        </nav>
                    </div>
                </div>

                <!-- Content -->
                <div class="lg:col-span-3">
                    <div class="bg-white shadow rounded-lg p-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-6">Cài đặt tài khoản</h2>

                        <form class="space-y-6">
                            <!-- Personal Information -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Thông tin cá nhân</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="fullName" class="block text-sm font-medium text-gray-700">Họ
                                            tên</label>
                                        <input type="text" id="fullName" name="fullName"
                                            value="<%= customer.full_name %>"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    </div>
                                    <div>
                                        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                                        <input type="email" id="email" name="email" value="<%= customer.email %>"
                                            disabled
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm bg-gray-100 sm:text-sm">
                                        <p class="mt-1 text-sm text-gray-500">Email không thể thay đổi</p>
                                    </div>
                                    <div>
                                        <label for="phone" class="block text-sm font-medium text-gray-700">Điện
                                            thoại</label>
                                        <input type="tel" id="phone" name="phone" value="<%= customer.phone || '' %>"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    </div>
                                    <div>
                                        <label for="address" class="block text-sm font-medium text-gray-700">Địa
                                            chỉ</label>
                                        <textarea id="address" name="address" rows="3"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"><%= customer.address || '' %></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Password Change -->
                            <div class="border-t pt-6">
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Đổi mật khẩu</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label for="currentPassword" class="block text-sm font-medium text-gray-700">Mật
                                            khẩu hiện tại</label>
                                        <input type="password" id="currentPassword" name="currentPassword"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    </div>
                                    <div>
                                        <label for="newPassword" class="block text-sm font-medium text-gray-700">Mật
                                            khẩu mới</label>
                                        <input type="password" id="newPassword" name="newPassword"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    </div>
                                    <div class="md:col-span-2">
                                        <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Xác
                                            nhận mật khẩu mới</label>
                                        <input type="password" id="confirmPassword" name="confirmPassword"
                                            class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                    </div>
                                </div>
                            </div>

                            <!-- Notification Preferences -->
                            <div class="border-t pt-6">
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Cài đặt thông báo</h3>
                                <div class="space-y-3">
                                    <div class="flex items-center">
                                        <input type="checkbox" id="emailNotifications" name="emailNotifications" checked
                                            class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                                        <label for="emailNotifications" class="ml-2 block text-sm text-gray-700">
                                            Nhận thông báo qua email về đơn hàng
                                        </label>
                                    </div>
                                    <div class="flex items-center">
                                        <input type="checkbox" id="smsNotifications" name="smsNotifications"
                                            class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                                        <label for="smsNotifications" class="ml-2 block text-sm text-gray-700">
                                            Nhận thông báo qua SMS
                                        </label>
                                    </div>
                                    <div class="flex items-center">
                                        <input type="checkbox" id="promotionalEmails" name="promotionalEmails" checked
                                            class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                                        <label for="promotionalEmails" class="ml-2 block text-sm text-gray-700">
                                            Nhận email khuyến mãi và tin tức
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Privacy Settings -->
                            <div class="border-t pt-6">
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Quyền riêng tư</h3>
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-medium text-gray-700">Hiển thị thông tin công khai
                                            </p>
                                            <p class="text-sm text-gray-500">Cho phép khách hàng khác xem thông tin cơ
                                                bản của bạn</p>
                                        </div>
                                        <button type="button"
                                            class="relative inline-flex flex-shrink-0 h-6 w-11 border-2 border-gray-200 bg-gray-200 rounded-full cursor-pointer transition-colors ease-in-out duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                            <span
                                                class="translate-x-0 inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition ease-in-out duration-200"></span>
                                        </button>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-sm font-medium text-gray-700">Lịch sử hoạt động</p>
                                            <p class="text-sm text-gray-500">Lưu lại lịch sử mua sắm và hoạt động</p>
                                        </div>
                                        <button type="button"
                                            class="relative inline-flex flex-shrink-0 h-6 w-11 border-2 border-indigo-600 bg-indigo-600 rounded-full cursor-pointer transition-colors ease-in-out duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                            <span
                                                class="translate-x-5 inline-block h-5 w-5 rounded-full bg-white shadow transform ring-0 transition ease-in-out duration-200"></span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="border-t pt-6">
                                <div class="flex justify-end space-x-4">
                                    <button type="button"
                                        class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md text-sm font-medium">
                                        Hủy
                                    </button>
                                    <button type="submit"
                                        class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">
                                        Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Danger Zone -->
                    <div class="mt-6 bg-white shadow rounded-lg p-6">
                        <h3 class="text-lg font-medium text-red-600 mb-4">Vùng nguy hiểm</h3>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-medium text-gray-900">Xóa tài khoản</p>
                                    <p class="text-sm text-gray-500">Xóa vĩnh viễn tài khoản và tất cả dữ liệu liên quan
                                    </p>
                                </div>
                                <button type="button"
                                    class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">
                                    Xóa tài khoản
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
</body>

</html>