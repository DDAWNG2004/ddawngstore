<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cập nhật sản phẩm - DDAWNG Store Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-indigo-600">DDAWNG Admin</h1>
                    <nav class="hidden md:flex space-x-8">
                        <a href="/admin/dashboard" class="text-gray-700 hover:text-indigo-600">Dashboard</a>
                        <a href="/admin/products" class="text-gray-700 hover:text-indigo-600">Sản phẩm</a>
                        <a href="/admin/orders" class="text-gray-700 hover:text-indigo-600">Đơn hàng</a>
                        <a href="/admin/customers" class="text-gray-700 hover:text-indigo-600">Khách hàng</a>
                    </nav>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-700">Xin chào, Admin</span>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                        </svg>
                    </button>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </button>
                    <button class="text-gray-500 hover:text-gray-700">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-3xl sm:truncate">Cập nhật sản phẩm</h1>
                <p class="mt-2 text-sm text-gray-700">Chỉnh sửa thông tin chi tiết của sản phẩm</p>
            </div>
            <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
                <a href="/admin/products" class="inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Quay lại
                </a>
            </div>
        </div>

        <!-- Product Info -->
        <div class="mt-6 bg-white shadow overflow-hidden sm:rounded-md">
            <div class="px-4 py-5 sm:p-6">
                <div class="flex items-center space-x-4">
                    <div class="flex-shrink-0">
                        <img src="<%= images && images.length > 0 ? images[0].image_url : (product.image_url || 'https://picsum.photos/seed/' + (product ? product.id : 'default') + '/200/200.jpg') %>" alt="<%= product ? product.name : 'Sản phẩm' %>" class="w-24 h-24 object-cover rounded-lg">
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900"><%= product ? product.name : 'Sản phẩm' %></h2>
                        <p class="text-sm text-gray-500">Mã sản phẩm: PRD<%= product ? product.id : '000' %></p>
                        <div class="mt-2 flex items-center space-x-2">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= product && product.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= product && product.status === 'active' ? 'Hoạt động' : 'Ngừng hoạt động' %>
                            </span>
                            <% if (product && product.category_name) { %>
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-indigo-100 text-indigo-800">
                                    <%= product.category_name %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form -->
        <% if (product) { %>
        <form class="mt-8 space-y-6" action="/admin/products/edit/<%= product.id %>" method="POST">
            <div class="bg-white shadow overflow-hidden sm:rounded-md">
                <div class="px-4 py-5 sm:p-6 space-y-6">
                    <!-- Basic Information -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Thông tin cơ bản</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="productName" class="block text-sm font-medium text-gray-700 mb-2">Tên sản phẩm *</label>
                                <input type="text" id="productName" name="productName" required
                                    value="<%= product.name %>"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <div>
                                <label for="productCode" class="block text-sm font-medium text-gray-700 mb-2">Mã sản phẩm *</label>
                                <input type="text" id="productCode" name="productCode" required
                                    value="PRD<%= product.id %>"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                        </div>
                        <div class="mt-6">
                            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">Mô tả sản phẩm *</label>
                            <textarea id="description" name="description" rows="4" required
                                class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"><%= product.description || '' %></textarea>
                        </div>
                    </div>

                    <!-- Category and Price -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Danh mục và giá</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="category" class="block text-sm font-medium text-gray-700 mb-2">Danh mục *</label>
                                <select id="category" name="category" required
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    <option value="">Chọn danh mục</option>
                                    <% if (categories && categories.length > 0) { %>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>" <%= product.category_id === category.id ? 'selected' : '' %>><%= category.name %></option>
                                        <% }); %>
                                    <% } else { %>
                                        <option value="" disabled>Không có danh mục nào</option>
                                    <% } %>
                                </select>
                            </div>
                            <div>
                                <label for="price" class="block text-sm font-medium text-gray-700 mb-2">Giá bán *</label>
                                <input type="number" id="price" name="price" required min="0"
                                    value="<%= product.price %>"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                        </div>
                    </div>

                    <!-- Inventory -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Tồn kho</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="sku" class="block text-sm font-medium text-gray-700 mb-2">SKU</label>
                                <input type="text" id="sku" name="sku"
                                    value="SKU<%= product.id %>"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">Tổng số lượng tồn kho</label>
                                <div class="block w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-sm font-medium text-gray-700" id="totalStock">
                                    <%= product.stock_quantity || 0 %>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">Tổng số lượng được tính tự động từ các biến thể</p>
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Trạng thái</h3>
                        <div class="flex items-center space-x-4">
                            <label class="flex items-center">
                                <input type="radio" name="status" value="active" <%= product.status === 'active' ? 'checked' : '' %> class="mr-2">
                                <span class="text-sm text-gray-700">Hoạt động</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="status" value="inactive" <%= product.status === 'inactive' ? 'checked' : '' %> class="mr-2">
                                <span class="text-sm text-gray-700">Ngừng hoạt động</span>
                            </label>
                        </div>
                    </div>

                    <!-- Product Variants -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Biến thể sản phẩm (Size & Màu sắc)</h3>
                        <div class="space-y-4">
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h4 class="text-sm font-medium text-gray-700 mb-3">Thêm biến thể sản phẩm</h4>
                                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Size</label>
                                        <select id="variantSize" class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                            <option value="">Chọn size</option>
                                            <% if (sizes && sizes.length > 0) { %>
                                                <% sizes.forEach(size => { %>
                                                    <option value="<%= size.id %>"><%= size.name %></option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Màu sắc</label>
                                        <select id="variantColor" class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                            <option value="">Chọn màu</option>
                                            <% if (colors && colors.length > 0) { %>
                                                <% colors.forEach(color => { %>
                                                    <option value="<%= color.id %>"><%= color.name %></option>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Số lượng</label>
                                        <input type="number" id="variantStock" min="0" placeholder="0" 
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">&nbsp;</label>
                                        <button type="button" onclick="addVariant()" 
                                            class="w-full bg-indigo-600 text-white px-3 py-2 rounded-md text-sm hover:bg-indigo-700 transition">
                                            Thêm biến thể
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div>
                                <h4 class="text-sm font-medium text-gray-700 mb-2">Danh sách biến thể hiện tại</h4>
                                <div id="variantsList" class="space-y-2 max-h-60 overflow-y-auto">
                                    <% if (variants && variants.length > 0) { %>
                                        <% variants.forEach(variant => { %>
                                            <div class="flex items-center justify-between bg-white p-3 border rounded-lg">
                                                <div class="flex items-center space-x-4">
                                                    <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded"><%= variant.size_name %></span>
                                                    <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded flex items-center">
                                                        <% if (variant.hex_code) { %>
                                                            <span class="w-3 h-3 rounded-full mr-1 color-dot" data-color="<%= variant.hex_code %>"></span>
                                                        <% } %>
                                                        <%= variant.color_name %>
                                                    </span>
                                                    <span class="text-sm text-gray-600">SL: <%= variant.stock_quantity %></span>
                                                    <span class="text-xs text-gray-500">SKU: <%= variant.sku %></span>
                                                </div>
                                                <div class="flex items-center space-x-2">
                                                    <button type="button" data-variant-id="<%= variant.id %>" onclick="editVariant(this.dataset.variantId)" 
                                                        class="text-blue-500 hover:text-blue-700">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                        </svg>
                                                    </button>
                                                    <button type="button" data-variant-id="<%= variant.id %>" onclick="removeVariant(this.dataset.variantId)" 
                                                        class="text-red-500 hover:text-red-700">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L4 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                        </svg>
                                                    </button>
                                                </div>
                                            </div>
                                            <input type="hidden" name="existing_variants[]" value="<%= JSON.stringify(variant) %>">
                                        <% }); %>
                                    <% } else { %>
                                        <div class="text-gray-500 text-sm text-center py-4 border-2 border-dashed border-gray-300 rounded-lg">
                                            Chưa có biến thể nào
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Images -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Hình ảnh sản phẩm</h3>
                        <div class="space-y-4">
                            <div>
                                <label for="mainImageUrl" class="block text-sm font-medium text-gray-700 mb-2">URL hình ảnh chính</label>
                                <div class="flex items-center space-x-4">
                                    <input type="url" id="mainImageUrl" name="mainImageUrl"
                                        placeholder="https://example.com/image.jpg"
                                        value="<%= images && images.length > 0 ? images[0].image_url : (product.image_url || '') %>"
                                        class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    <div class="flex-shrink-0">
                                        <div class="w-20 h-20 bg-gray-200 rounded-lg overflow-hidden">
                                            <img id="mainImagePreview" src="<%= images && images.length > 0 ? images[0].image_url : (product.image_url || 'https://picsum.photos/seed/' + product.id + '/200/200.jpg') %>" alt="Current image" class="w-full h-full object-cover">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label for="additionalImageUrls" class="block text-sm font-medium text-gray-700 mb-2">URL hình ảnh bổ sung</label>
                                <textarea id="additionalImageUrls" name="additionalImageUrls" rows="3"
                                    placeholder="https://example.com/image1.jpg&#10;https://example.com/image2.jpg&#10;https://example.com/image3.jpg"
                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"><% if (additionalImages && additionalImages.length > 0) { %><%= additionalImages.map(img => img.image_url).join('\n') %><% } %></textarea>
                                <p class="mt-1 text-sm text-gray-500">Mỗi URL trên một dòng</p>
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div>
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Trạng thái</h3>
                        <div class="flex items-center space-x-4">
                            <label class="flex items-center">
                                <input type="radio" name="status" value="active" checked class="mr-2">
                                <span class="text-sm text-gray-700">Hoạt động</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="status" value="inactive" class="mr-2">
                                <span class="text-sm text-gray-700">Không hoạt động</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="featured" checked class="mr-2">
                                <span class="text-sm text-gray-700">Sản phẩm nổi bật</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
                    <button type="button" onclick="window.location.href='/admin/products'" 
                        class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3">
                        Hủy
                    </button>
                    <button type="submit" 
                        class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Cập nhật sản phẩm
                    </button>
                </div>
            </div>
        </form>
    <% } else { %>
        <!-- Error Message -->
        <div class="bg-red-50 border border-red-200 rounded-md p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800">Không tìm thấy sản phẩm</h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>Sản phẩm bạn muốn chỉnh sửa không tồn tại hoặc đã bị xóa.</p>
                    </div>
                    <div class="mt-4">
                        <div class="flex">
                            <button onclick="window.location.href='/admin/products'" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition">
                                Quay lại danh sách sản phẩm
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
    </main>

    <script>
        // Product Variants Management
        let newVariants = [];
        let newVariantIdCounter = 1000; // Start from high number to avoid conflicts
        
        // Get size and color names from dropdowns
        function getSizeName(sizeId) {
            const select = document.getElementById('variantSize');
            const option = select.querySelector(`option[value="${sizeId}"]`);
            return option ? option.textContent : '';
        }
        
        function getColorName(colorId) {
            const select = document.getElementById('variantColor');
            const option = select.querySelector(`option[value="${colorId}"]`);
            return option ? option.textContent : '';
        }
        
        function addVariant() {
            const sizeId = document.getElementById('variantSize').value;
            const colorId = document.getElementById('variantColor').value;
            const stock = document.getElementById('variantStock').value || 0;
            
            if (!sizeId || !colorId) {
                alert('Vui lòng chọn size và màu sắc!');
                return;
            }
            
            // Check for duplicate with existing variants
            const existingVariants = document.querySelectorAll('input[name="existing_variants[]"]');
            for (let input of existingVariants) {
                const variant = JSON.parse(input.value);
                if (variant.size_id == sizeId && variant.color_id == colorId) {
                    alert('Biến thể này đã tồn tại!');
                    return;
                }
            }
            
            // Check for duplicate with new variants
            const exists = newVariants.find(v => v.sizeId === sizeId && v.colorId === colorId);
            if (exists) {
                alert('Biến thể này đã tồn tại!');
                return;
            }
            
            const variant = {
                id: ++newVariantIdCounter,
                sizeId: sizeId,
                colorId: colorId,
                stock: stock,
                sizeName: getSizeName(sizeId),
                colorName: getColorName(colorId)
            };
            
            newVariants.push(variant);
            renderNewVariants();
            
            // Clear form
            document.getElementById('variantSize').value = '';
            document.getElementById('variantColor').value = '';
            document.getElementById('variantStock').value = '';
            
            // Update total stock
            updateTotalStock();
        }
        
        function removeNewVariant(id) {
            newVariants = newVariants.filter(v => v.id !== id);
            renderNewVariants();
            
            // Update total stock
            updateTotalStock();
        }
        
        function renderNewVariants() {
            // Find or create container for new variants
            let container = document.getElementById('newVariantsList');
            if (!container) {
                const variantsList = document.getElementById('variantsList');
                container = document.createElement('div');
                container.id = 'newVariantsList';
                container.className = 'mt-4 border-t pt-4';
                variantsList.parentNode.appendChild(container);
            }
            
            if (newVariants.length === 0) {
                container.innerHTML = '';
                return;
            }
            
            container.innerHTML = `
                <h4 class="text-sm font-medium text-gray-700 mb-2">Biến thể mới sẽ được thêm:</h4>
                <div class="space-y-2">
                    ${newVariants.map(variant => `
                        <div class="flex items-center justify-between bg-green-50 p-3 border rounded-lg">
                            <div class="flex items-center space-x-4">
                                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">${variant.sizeName}</span>
                                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">${variant.colorName}</span>
                                <span class="text-sm text-gray-600">SL: ${variant.stock}</span>
                            </div>
                            <button type="button" onclick="removeNewVariant(${variant.id})" 
                                class="text-red-500 hover:text-red-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                        <input type="hidden" name="variants[]" value="${JSON.stringify(variant)}">
                    `).join('')}
                </div>
            `;
        }
        
        function editVariant(variantId) {
            // Find the variant in existing variants
            const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
            let targetVariant = null;
            
            for (let input of existingInputs) {
                const variant = JSON.parse(input.value);
                if (variant.id == variantId) {
                    targetVariant = variant;
                    break;
                }
            }
            
            if (targetVariant) {
                // Fill the form with variant data for editing
                document.getElementById('variantSize').value = targetVariant.size_id;
                document.getElementById('variantColor').value = targetVariant.color_id;
                document.getElementById('variantStock').value = targetVariant.stock_quantity;
                
                // Remove from existing and add to new for editing
                removeExistingVariant(variantId);
                
                // Add to new variants with updated data
                const variant = {
                    id: ++newVariantIdCounter,
                    sizeId: targetVariant.size_id,
                    colorId: targetVariant.color_id,
                    stock: targetVariant.stock_quantity,
                    sizeName: targetVariant.size_name,
                    colorName: targetVariant.color_name
                };
                
                newVariants.push(variant);
                renderNewVariants();
                
                // Update total stock
                updateTotalStock();
            }
        }
        
        function removeExistingVariant(variantId) {
            const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
            for (let input of existingInputs) {
                const variant = JSON.parse(input.value);
                if (variant.id == variantId) {
                    input.remove();
                    // Remove the display element
                    const displayElement = input.closest('.flex').parentElement;
                    if (displayElement) {
                        displayElement.remove();
                    }
                    break;
                }
            }
            
            // Update total stock
            updateTotalStock();
        }
        
        function removeVariant(variantId) {
            // Try to remove from existing variants first
            removeExistingVariant(variantId);
            
            // If not found, remove from new variants
            const index = newVariants.findIndex(v => v.id == variantId);
            if (index !== -1) {
                newVariants.splice(index, 1);
                renderNewVariants();
            }
            
            // Update total stock
            updateTotalStock();
        }
        
        // Preview image
        const mainImageInput = document.getElementById('mainImage');
        if (mainImageInput) {
            mainImageInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const preview = document.querySelector('.w-20.h-20 img');
                        if (preview) {
                            preview.src = e.target.result;
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Remove image
        document.querySelectorAll('.group button').forEach(button => {
            button.addEventListener('click', function() {
                const imageContainer = this.closest('.relative');
                imageContainer.remove();
            });
        });

        // Update total stock when variants change
        function updateTotalStock() {
            let totalStock = 0;
            
            // Calculate from existing variants
            const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
            existingInputs.forEach(input => {
                const variant = JSON.parse(input.value);
                totalStock += parseInt(variant.stock_quantity) || 0;
            });
            
            // Calculate from new variants
            newVariants.forEach(variant => {
                totalStock += parseInt(variant.stock) || 0;
            });
            
            // Update display
            const totalStockElement = document.getElementById('totalStock');
            if (totalStockElement) {
                totalStockElement.textContent = totalStock;
            }
        }
        
        // Add event listeners to update total stock
        document.addEventListener('DOMContentLoaded', function() {
            // Update total stock initially
            updateTotalStock();
            
            // Add event listeners for variant stock changes
            document.getElementById('variantStock')?.addEventListener('input', updateTotalStock);
            
            // Update total stock when new variants are added/removed
            const observer = new MutationObserver(function(mutations) {
                updateTotalStock();
            });
            
            const variantsList = document.getElementById('variantsList');
            if (variantsList) {
                observer.observe(variantsList, { childList: true, subtree: true });
            }
        });

        // Preview image from URL
        document.getElementById('mainImageUrl')?.addEventListener('input', function(e) {
            const url = e.target.value.trim();
            const preview = document.getElementById('mainImagePreview');
            
            if (url && preview) {
                // Test if URL is valid image
                const img = new Image();
                img.onload = function() {
                    preview.src = url;
                };
                img.onerror = function() {
                    // Keep current image if URL is invalid
                    console.log('Invalid image URL:', url);
                };
                img.src = url;
            }
        });

        // Form validation and submission
        console.log('🔍 JavaScript loaded, looking for form...');
        const form = document.querySelector('form');
        console.log('🔍 Form found:', form);
        if (form) {
            console.log('🔍 Adding submit listener to form...');
            form.addEventListener('submit', function(e) {
                console.log('🚀 Form submit triggered');
                
                try {
                    console.log('📋 Form action:', form.action);
                    console.log('📋 Form method:', form.method);
                    
                    const required = this.querySelectorAll('[required]');
                    let valid = true;
                    
                    console.log('📋 Required fields count:', required.length);
                    
                    required.forEach((field, index) => {
                        console.log(`📋 Field ${index + 1}:`, {
                            name: field.name,
                            type: field.type,
                            value: field.value,
                            required: field.required,
                            valid: !!field.value.trim()
                        });
                        
                        if (!field.value.trim()) {
                            field.classList.add('border-red-500');
                            valid = false;
                            console.log('❌ Invalid field:', field.name);
                        } else {
                            field.classList.remove('border-red-500');
                            console.log('✅ Valid field:', field.name);
                        }
                    });

                    if (!valid) {
                        console.log('❌ Form validation failed');
                        e.preventDefault();
                        // alert('Vui lòng điền đầy đủ các trường bắt buộc!');
                        return;
                    }
                    
                    console.log('✅ Form validation passed, submitting...');
                    
                    // Prevent default and submit via AJAX for better debugging
                    e.preventDefault();
                    
                    // Simple form data collection without complex parsing
                    const submitDataObj = {};
                    const submitFormData = new FormData(form);
                    
                    // Add all regular fields
                    for (let [key, value] of submitFormData.entries()) {
                        if (key !== 'variants[]' && key !== 'existing_variants[]') {
                            submitDataObj[key] = value;
                        }
                    }
                    
                    // Handle variants safely
                    try {
                        const submitVariants = [];
                        const submitVariantInputs = document.querySelectorAll('input[name="variants[]"]');
                        console.log('📋 Found variant inputs:', submitVariantInputs.length);
                        
                        submitVariantInputs.forEach((input) => {
                            console.log('📋 Variant input value:', input.value);
                            if (input.value && input.value.trim()) {
                                try {
                                    const variant = JSON.parse(input.value);
                                    submitVariants.push(variant);
                                    console.log('✅ Parsed variant:', variant);
                                } catch (e) {
                                    console.log('❌ Error parsing variant:', input.value, e.message);
                                }
                            }
                        });
                        
                        submitDataObj.variants = submitVariants;
                        console.log('📋 Final variants array:', submitVariants);
                    } catch (e) {
                        console.log('❌ Error in variants processing:', e.message);
                        submitDataObj.variants = [];
                    }
                    
                    // Handle existing variants safely
                    try {
                        const submitExistingVariants = [];
                        const submitExistingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
                        console.log('📋 Found existing variant inputs:', submitExistingInputs.length);
                        
                        submitExistingInputs.forEach((input) => {
                            console.log('📋 Existing variant input value:', input.value);
                            if (input.value && input.value.trim()) {
                                try {
                                    const variant = JSON.parse(input.value);
                                    submitExistingVariants.push(variant);
                                    console.log('✅ Parsed existing variant:', variant);
                                } catch (e) {
                                    console.log('❌ Error parsing existing variant:', input.value, e.message);
                                }
                            }
                        });
                        
                        submitDataObj.existing_variants = submitExistingVariants;
                        console.log('📋 Final existing variants array:', submitExistingVariants);
                    } catch (e) {
                        console.log('❌ Error in existing variants processing:', e.message);
                        submitDataObj.existing_variants = [];
                    }
                    
                    console.log('📤 Submitting JSON data via AJAX...');
                    console.log('📤 Final data object:', submitDataObj);
                    
                    // Call real update route directly
                    console.log('🚀 Calling real update route:', form.action);
                    
                    // Add timeout fallback redirect
                    setTimeout(() => {
                        console.log('⏰ Timeout fallback - redirecting to products page');
                        window.location.href = '/admin/products';
                    }, 5000); // 5 seconds fallback
                    
                    fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(submitDataObj)
                    })
                    .then(response => {
                        console.log('📡 Real response status:', response.status);
                        console.log('📡 Real response headers:', [...response.headers.entries()]);
                        console.log('📡 Real response content-type:', response.headers.get('content-type'));
                        
                        const contentType = response.headers.get('content-type');
                        if (contentType && contentType.includes('application/json')) {
                            return response.json();
                        } else {
                            return response.text().then(text => {
                                console.log('❌ Real: Received non-JSON response:', text);
                                console.log('⚠️ Backend returned HTML instead of JSON, but product was likely updated');
                                // Don't throw error, just continue with fallback redirect
                                return { success: true, message: 'Product updated (HTML response)' };
                            });
                        }
                    })
                    .then(result => {
                        console.log('📦 Real response result:', result);
                        if (result.success) {
                            console.log('✅ Update successful:', result.message);
                            // Clear timeout and redirect immediately
                            clearTimeout(window.redirectTimeout);
                            window.location.href = '/admin/products';
                        } else {
                            console.log('❌ Update failed:', result.message);
                        }
                    })
                    .catch(error => {
                        console.error('❌ Real AJAX Error:', error);
                        console.error('❌ Real Error details:', error.message);
                        console.error('❌ Real Error stack:', error.stack);
                        console.log('⚠️ AJAX failed, but product might still be updated. Will redirect in 5 seconds...');
                    });
                    
                    // Store timeout reference so we can clear it
                    window.redirectTimeout = setTimeout(() => {
                        console.log('⏰ Timeout fallback - redirecting to products page');
                        window.location.href = '/admin/products';
                    }, 5000);
                    
                } catch (error) {
                    console.error('❌ JavaScript Error:', error);
                    console.error('❌ Error details:', error.message);
                    console.error('❌ Error stack:', error.stack);
                    // alert('JavaScript error: ' + error.message);
                }
            });
        }
        
        // Apply colors to color dots
        document.addEventListener('DOMContentLoaded', function() {
            const colorDots = document.querySelectorAll('.color-dot');
            colorDots.forEach(dot => {
                const color = dot.dataset.color;
                if (color) {
                    dot.style.backgroundColor = color;
                }
            });
        });
        
        console.log('🔍 JavaScript setup completed');
    </script>
</body>
</html>
