<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cập nhật sản phẩm - DDAWNG Store Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <%- include('partials/admin-header', { activePage: 'products' }) %>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Header -->
            <div class="sm:flex sm:items-center">
                <div class="sm:flex-auto">
                    <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-3xl sm:truncate">Cập nhật sản phẩm
                    </h1>
                    <p class="mt-2 text-sm text-gray-700">Chỉnh sửa thông tin chi tiết của sản phẩm</p>
                </div>
                <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
                    <a href="/admin/products"
                        class="inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Quay lại
                    </a>
                </div>
            </div>

            <!-- Product Info -->
            <div class="mt-6 bg-white shadow overflow-hidden sm:rounded-md">
                <div class="px-4 py-5 sm:p-6">
                    <div class="flex items-center space-x-4">
                        <div class="flex-shrink-0">
                            <% let imageUrl=images && images.length> 0 ? images[0].image_url : (product.image_url ||
                                'https://picsum.photos/seed/' + (product ? product.id : 'default') + '/200/200.jpg');
                                let altText = product ? product.name : 'Sản phẩm';
                                %>
                                <img src="<%= imageUrl %>" alt="<%= altText %>"
                                    class="w-24 h-24 object-cover rounded-lg">
                        </div>
                        <div>
                            <h2 class="text-xl font-semibold text-gray-900">
                                <%= product ? product.name : 'Sản phẩm' %>
                            </h2>
                            <p class="text-sm text-gray-500">Mã sản phẩm: PRD<%= product ? product.id : '000' %>
                            </p>
                            <div class="mt-2 flex items-center space-x-2">
                                <span
                                    class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= product && product.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                    <%= product && product.status==='active' ? 'Hoạt động' : 'Ngừng hoạt động' %>
                                </span>
                                <% if (product && product.category_name) { %>
                                    <span
                                        class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-indigo-100 text-indigo-800">
                                        <%= product.category_name %>
                                    </span>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <% if (product) { %>
                <form class="mt-8 space-y-6" action="/admin/products/edit/<%= product.id %>" method="POST"
                    enctype="multipart/form-data">
                    <div class="bg-white shadow overflow-hidden sm:rounded-md">
                        <div class="px-4 py-5 sm:p-6 space-y-6">
                            <!-- Basic Information -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Thông tin cơ bản</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label for="productName"
                                            class="block text-sm font-medium text-gray-700 mb-2">Tên sản phẩm *</label>
                                        <input type="text" id="productName" name="productName" required
                                            value="<%= product.name %>"
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Mã sản phẩm</label>
                                        <div
                                            class="block w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-gray-700">
                                            PRD<%= product.id %>
                                        </div>
                                        <p class="mt-1 text-sm text-gray-500">Mã sản phẩm tự động theo định dạng:
                                            PRD[ID]</p>
                                    </div>
                                </div>
                                <div class="mt-6">
                                    <label for="description" class="block text-sm font-medium text-gray-700 mb-2">Mô tả
                                        sản phẩm *</label>
                                    <textarea id="description" name="description" rows="4" required
                                        class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"><%= product.description || '' %></textarea>
                                </div>
                            </div>

                            <!-- Category and Price -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Danh mục và giá</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label for="category" class="block text-sm font-medium text-gray-700 mb-2">Danh
                                            mục *</label>
                                        <select id="category" name="category" required
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                            <option value="">Chọn danh mục</option>
                                            <% if (categories && categories.length> 0) { %>
                                                <% categories.forEach(category=> { %>
                                                    <option value="<%= category.id %>"
                                                        <%=product.category_id===category.id ? 'selected' : '' %>><%=
                                                            category.name %>
                                                    </option>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <option value="" disabled>Không có danh mục nào</option>
                                                            <% } %>
                                        </select>
                                    </div>
                                    <div>
                                        <label for="price" class="block text-sm font-medium text-gray-700 mb-2">Giá bán
                                            *</label>
                                        <input type="number" id="price" name="price" required min="0"
                                            value="<%= product.price %>"
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    </div>
                                </div>
                            </div>

                            <!-- Inventory -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Tồn kho</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div>
                                        <label for="sku"
                                            class="block text-sm font-medium text-gray-700 mb-2">SKU</label>
                                        <input type="text" id="sku" name="sku" value="SKU<%= product.id %>"
                                            class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Tổng số lượng tồn
                                            kho</label>
                                        <div class="block w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md text-sm font-medium text-gray-700"
                                            id="totalStock">
                                            <%= product.calculated_stock || 0 %>
                                        </div>
                                        <p class="text-xs text-gray-500 mt-1">Tổng số lượng được tính tự động từ các
                                            biến thể</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Status -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Trạng thái</h3>
                                <div class="flex items-center space-x-4">
                                    <label class="flex items-center">
                                        <input type="radio" name="status" value="active" <%=product.status==='active'
                                            ? 'checked' : '' %> class="mr-2">
                                        <span class="text-sm text-gray-700">Còn hàng</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="radio" name="status" value="out_of_stock"
                                            <%=product.status==='out_of_stock' ? 'checked' : '' %> class="mr-2">
                                        <span class="text-sm text-gray-700">Hết hàng</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="radio" name="status" value="discontinued"
                                            <%=product.status==='discontinued' ? 'checked' : '' %> class="mr-2">
                                        <span class="text-sm text-gray-700">Ngừng kinh doanh</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Product Variants -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Biến thể sản phẩm (Size & Màu sắc)
                                </h3>
                                <div class="space-y-4">
                                    <div class="bg-gray-50 p-4 rounded-lg">
                                        <h4 class="text-sm font-medium text-gray-700 mb-3">Thêm biến thể sản phẩm</h4>
                                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-1">Size</label>
                                                <select id="variantSize"
                                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                                    <option value="">Chọn size</option>
                                                    <% if (sizes && sizes.length> 0) { %>
                                                        <% sizes.forEach(size=> { %>
                                                            <option value="<%= size.id %>">
                                                                <%= size.name %>
                                                            </option>
                                                            <% }); %>
                                                                <% } %>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-1">Màu
                                                    sắc</label>
                                                <select id="variantColor"
                                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                                    <option value="">Chọn màu</option>
                                                    <% if (colors && colors.length> 0) { %>
                                                        <% colors.forEach(color=> { %>
                                                            <option value="<%= color.id %>">
                                                                <%= color.name %>
                                                            </option>
                                                            <% }); %>
                                                                <% } %>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-gray-700 mb-1">Số
                                                    lượng</label>
                                                <input type="number" id="variantStock" min="0" placeholder="0"
                                                    class="block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                                            </div>
                                            <div>
                                                <label
                                                    class="block text-sm font-medium text-gray-700 mb-1">&nbsp;</label>
                                                <button type="button" onclick="addVariant()"
                                                    class="w-full bg-indigo-600 text-white px-3 py-2 rounded-md text-sm hover:bg-indigo-700 transition">
                                                    Thêm biến thể
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <h4 class="text-sm font-medium text-gray-700 mb-2">Danh sách biến thể hiện tại
                                        </h4>
                                        <div id="variantsList" class="space-y-2 max-h-60 overflow-y-auto">
                                            <% if (variants && variants.length> 0) { %>
                                                <% variants.forEach(variant=> { %>
                                                    <div
                                                        class="flex items-center justify-between bg-white p-3 border rounded-lg">
                                                        <div class="flex items-center space-x-4">
                                                            <span
                                                                class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded">
                                                                <%= variant.size_name %>
                                                            </span>
                                                            <span
                                                                class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded flex items-center">
                                                                <% if (variant.hex_code) { %>
                                                                    <span class="w-3 h-3 rounded-full mr-1 color-dot"
                                                                        data-color="<%= variant.hex_code %>"></span>
                                                                    <% } %>
                                                                        <%= variant.color_name %>
                                                            </span>
                                                            <span class="text-sm text-gray-600">SL: <%=
                                                                    variant.stock_quantity %></span>
                                                            <span class="text-xs text-gray-500">SKU: <%= variant.sku %>
                                                            </span>
                                                        </div>
                                                        <div class="flex items-center space-x-2">
                                                            <button type="button" data-variant-id="<%= variant.id %>"
                                                                onclick="editVariant(this.dataset.variantId)"
                                                                class="text-blue-500 hover:text-blue-700">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                                </svg>
                                                            </button>
                                                            <button type="button" data-variant-id="<%= variant.id %>"
                                                                onclick="removeVariant(this.dataset.variantId)"
                                                                class="text-red-500 hover:text-red-700">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L4 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <input type="hidden" name="existing_variants[]"
                                                        value="<%= JSON.stringify(variant) %>">
                                                    <% }); %>
                                                        <% } else { %>
                                                            <div
                                                                class="text-gray-500 text-sm text-center py-4 border-2 border-dashed border-gray-300 rounded-lg">
                                                                Chưa có biến thể nào
                                                            </div>
                                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Images -->
                            <div>
                                <h3 class="text-lg font-medium text-gray-900 mb-4">Hình ảnh sản phẩm</h3>
                                <div class="space-y-4">
                                    <!-- Hình ảnh chính -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Hình ảnh chính *
                                            (Chọn ảnh mới để thay thế ảnh cũ)</label>
                                        <div class="flex items-center space-x-4">
                                            <label for="mainImage" class="cursor-pointer flex-1">
                                                <div
                                                    class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-indigo-400 transition">
                                                    <svg class="mx-auto h-8 w-8 text-gray-400" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                                    </svg>
                                                    <p class="mt-1 text-sm text-gray-600">Nhấn để chọn ảnh chính mới</p>
                                                    <p class="text-xs text-gray-400">JPG, PNG, GIF (tối đa 5MB)</p>
                                                </div>
                                                <input type="file" id="mainImage" name="mainImage" accept="image/*"
                                                    class="hidden">
                                            </label>
                                            <div class="flex-shrink-0">
                                                <div
                                                    class="w-24 h-24 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden border border-gray-200">
                                                    <img id="mainImagePreview"
                                                        src="<%= images && images.length > 0 ? images[0].image_url : (product.image_url || 'https://picsum.photos/seed/' + product.id + '/200/200.jpg') %>"
                                                        alt="Current main image" class="w-full h-full object-cover">
                                                </div>
                                                <p class="text-xs text-center text-gray-500 mt-1">Ảnh hiện tại</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hình ảnh bổ sung -->
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Hình ảnh bổ sung
                                            hiện có</label>
                                        <div id="existingAdditionalImages" class="flex flex-wrap gap-3 mb-4">
                                            <% if (images && images.length> 1) { %>
                                                <% images.slice(1).forEach((img, index)=> { %>
                                                    <div
                                                        class="relative w-20 h-20 rounded-lg border border-gray-200 overflow-hidden group existing-image-item">
                                                        <img src="<%= img.image_url %>"
                                                            alt="Additional image <%= index + 1 %>"
                                                            class="w-full h-full object-cover">
                                                        <button type="button"
                                                            onclick="this.closest('.existing-image-item').remove()"
                                                            class="absolute top-1 right-1 bg-red-500 text-white rounded-full p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                            </svg>
                                                        </button>
                                                        <input type="hidden" name="keptAdditionalImageUrls[]"
                                                            value="<%= img.image_url %>">
                                                    </div>
                                                    <% }); %>
                                                        <% } else { %>
                                                            <p class="text-sm text-gray-500 italic">Không có hình ảnh bổ
                                                                sung.</p>
                                                            <% } %>
                                        </div>

                                        <label class="block text-sm font-medium text-gray-700 mb-2">Thêm hình ảnh bổ
                                            sung mới</label>
                                        <label for="additionalImages" class="cursor-pointer block">
                                            <div
                                                class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center hover:border-indigo-400 transition">
                                                <svg class="mx-auto h-8 w-8 text-gray-400" fill="none"
                                                    stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                <p class="mt-1 text-sm text-gray-600">Nhấn để tải lên ảnh mới (có thể
                                                    chọn nhiều)</p>
                                                <p class="text-xs text-gray-400">JPG, PNG, GIF (tối đa 5MB mỗi ảnh)</p>
                                            </div>
                                            <input type="file" id="additionalImages" name="additionalImages"
                                                accept="image/*" multiple class="hidden">
                                        </label>
                                        <div id="additionalImagesPreview" class="mt-3 flex flex-wrap gap-3"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
                                <button type="button" onclick="window.location.href='/admin/products'"
                                    class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-3">
                                    Hủy
                                </button>
                                <button type="submit"
                                    class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor"
                                        viewBox="0 0 20 20">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M5 13l4 4L19 7" />
                                    </svg>
                                    Cập nhật sản phẩm
                                </button>
                            </div>
                        </div>
                </form>
                <% } else { %>
                    <!-- Error Message -->
                    <div class="bg-red-50 border border-red-200 rounded-md p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-red-800">Không tìm thấy sản phẩm</h3>
                                <div class="mt-2 text-sm text-red-700">
                                    <p>Sản phẩm bạn muốn chỉnh sửa không tồn tại hoặc đã bị xóa.</p>
                                </div>
                                <div class="mt-4">
                                    <div class="flex">
                                        <button onclick="window.location.href='/admin/products'"
                                            class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 transition">
                                            Quay lại danh sách sản phẩm
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
        </main>

        <script>
            // Product Variants Management
            let newVariants = [];
            let newVariantIdCounter = 1000; // Start from high number to avoid conflicts

            // Get size and color names from dropdowns
            function getSizeName(sizeId) {
                const select = document.getElementById('variantSize');
                const option = select.querySelector(`option[value="${sizeId}"]`);
                return option ? option.textContent : '';
            }

            function getColorName(colorId) {
                const select = document.getElementById('variantColor');
                const option = select.querySelector(`option[value="${colorId}"]`);
                return option ? option.textContent : '';
            }

            function addVariant() {
                const sizeId = document.getElementById('variantSize').value;
                const colorId = document.getElementById('variantColor').value;
                const stock = document.getElementById('variantStock').value || 0;

                if (!sizeId || !colorId) {
                    alert('Vui lòng chọn size và màu sắc!');
                    return;
                }

                // Check for duplicate with existing variants
                const existingVariants = document.querySelectorAll('input[name="existing_variants[]"]');
                for (let input of existingVariants) {
                    const variant = JSON.parse(input.value);
                    if (variant.size_id == sizeId && variant.color_id == colorId) {
                        alert('Biến thể này đã tồn tại!');
                        return;
                    }
                }

                // Check for duplicate with new variants
                const exists = newVariants.find(v => v.sizeId === sizeId && v.colorId === colorId);
                if (exists) {
                    alert('Biến thể này đã tồn tại!');
                    return;
                }

                const variant = {
                    id: ++newVariantIdCounter,
                    sizeId: sizeId,
                    colorId: colorId,
                    stock: stock,
                    sizeName: getSizeName(sizeId),
                    colorName: getColorName(colorId)
                };

                newVariants.push(variant);
                renderNewVariants();

                // Clear form
                document.getElementById('variantSize').value = '';
                document.getElementById('variantColor').value = '';
                document.getElementById('variantStock').value = '';

                // Update total stock
                updateTotalStock();
            }

            function removeNewVariant(id) {
                newVariants = newVariants.filter(v => v.id !== id);
                renderNewVariants();

                // Update total stock
                updateTotalStock();
            }

            function renderNewVariants() {
                // Find or create container for new variants
                let container = document.getElementById('newVariantsList');
                if (!container) {
                    const variantsList = document.getElementById('variantsList');
                    container = document.createElement('div');
                    container.id = 'newVariantsList';
                    container.className = 'mt-4 border-t pt-4';
                    variantsList.parentNode.appendChild(container);
                }

                if (newVariants.length === 0) {
                    container.innerHTML = '';
                    return;
                }

                container.innerHTML = `
                <h4 class="text-sm font-medium text-gray-700 mb-2">Biến thể mới sẽ được thêm:</h4>
                <div class="space-y-2">
                    ${newVariants.map(variant => {
                    const escapedJson = JSON.stringify(variant).replace(/"/g, '&quot;');
                    return `
                        <div class="flex items-center justify-between bg-green-50 p-3 border rounded-lg">
                            <div class="flex items-center space-x-4">
                                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">${variant.sizeName}</span>
                                <span class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">${variant.colorName}</span>
                                <span class="text-sm text-gray-600">SL: ${variant.stock}</span>
                            </div>
                            <button type="button" onclick="removeNewVariant(${variant.id})" 
                                class="text-red-500 hover:text-red-700">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                        <input type="hidden" name="variants[]" value="${escapedJson}">
                    `}).join('')}
                </div>
            `;
            }

            function editVariant(variantId) {
                // Find the variant in existing variants
                const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
                let targetVariant = null;

                for (let input of existingInputs) {
                    const variant = JSON.parse(input.value);
                    if (variant.id == variantId) {
                        targetVariant = variant;
                        break;
                    }
                }

                if (targetVariant) {
                    // Fill the form with variant data for editing
                    document.getElementById('variantSize').value = targetVariant.size_id;
                    document.getElementById('variantColor').value = targetVariant.color_id;
                    document.getElementById('variantStock').value = targetVariant.stock_quantity;

                    // Remove from existing and add to new for editing
                    removeExistingVariant(variantId);

                    // Add to new variants with updated data
                    const variant = {
                        id: ++newVariantIdCounter,
                        sizeId: targetVariant.size_id,
                        colorId: targetVariant.color_id,
                        stock: targetVariant.stock_quantity,
                        sizeName: targetVariant.size_name,
                        colorName: targetVariant.color_name
                    };

                    newVariants.push(variant);
                    renderNewVariants();

                    // Update total stock
                    updateTotalStock();
                }
            }

            // Theo dõi variants bị xóa
            let deletedVariantIds = [];

            function removeExistingVariant(variantId) {
                const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
                for (let input of existingInputs) {
                    const variant = JSON.parse(input.value);
                    if (variant.id == variantId) {
                        // Lưu ID vào danh sách xóa
                        deletedVariantIds.push(variant.id);
                        input.remove();
                        // Remove the display element
                        const displayElement = input.closest('.flex').parentElement;
                        if (displayElement) {
                            displayElement.remove();
                        }
                        break;
                    }
                }

                // Update total stock
                updateTotalStock();
            }

            function removeVariant(variantId) {
                // Try to remove from existing variants first
                removeExistingVariant(variantId);

                // If not found, remove from new variants
                const index = newVariants.findIndex(v => v.id == variantId);
                if (index !== -1) {
                    newVariants.splice(index, 1);
                    renderNewVariants();
                }

                // Update total stock
                updateTotalStock();
            }

            // Preview main image
            const mainImageInput = document.getElementById('mainImage');
            if (mainImageInput) {
                mainImageInput.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const preview = document.getElementById('mainImagePreview');
                            if (preview) {
                                preview.src = e.target.result;
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            // Preview additional images
            const additionalImagesInput = document.getElementById('additionalImages');
            const additionalImagesPreview = document.getElementById('additionalImagesPreview');
            if (additionalImagesInput && additionalImagesPreview) {
                additionalImagesInput.addEventListener('change', function (e) {
                    additionalImagesPreview.innerHTML = ''; // Clear ols previews (không clear existing DB images)
                    const files = e.target.files;

                    if (files && files.length > 0) {
                        Array.from(files).forEach((file, index) => {
                            if (file.type.startsWith('image/')) {
                                const reader = new FileReader();
                                reader.onload = function (e) {
                                    const container = document.createElement('div');
                                    container.className = 'w-20 h-20 rounded-lg bg-gray-100 overflow-hidden border border-gray-200';

                                    const img = document.createElement('img');
                                    img.src = e.target.result;
                                    img.className = 'w-full h-full object-cover';

                                    container.appendChild(img);
                                    additionalImagesPreview.appendChild(container);
                                };
                                reader.readAsDataURL(file);
                            }
                        });
                    }
                });
            }

            // Update total stock when variants change
            function updateTotalStock() {
                let totalStock = 0;

                // Calculate from existing variants
                const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
                existingInputs.forEach(input => {
                    const variant = JSON.parse(input.value);
                    totalStock += parseInt(variant.stock_quantity) || 0;
                });

                // Calculate from new variants
                newVariants.forEach(variant => {
                    totalStock += parseInt(variant.stock) || 0;
                });

                // Update display
                const totalStockElement = document.getElementById('totalStock');
                if (totalStockElement) {
                    totalStockElement.textContent = totalStock;
                }
            }

            // Add event listeners to update total stock
            document.addEventListener('DOMContentLoaded', function () {
                // Update total stock initially
                updateTotalStock();

                // Add event listeners for variant stock changes
                document.getElementById('variantStock')?.addEventListener('input', updateTotalStock);

                // Update total stock when new variants are added/removed
                const observer = new MutationObserver(function (mutations) {
                    updateTotalStock();
                });

                const variantsList = document.getElementById('variantsList');
                if (variantsList) {
                    observer.observe(variantsList, { childList: true, subtree: true });
                }
            });

            // Form validation and submission
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    // Validate required fields
                    const required = this.querySelectorAll('[required]');
                    let valid = true;
                    required.forEach(field => {
                        if (!field.value.trim()) {
                            field.classList.add('border-red-500');
                            valid = false;
                        } else {
                            field.classList.remove('border-red-500');
                        }
                    });

                    if (!valid) {
                        alert('Vui lòng điền đầy đủ các trường bắt buộc!');
                        return;
                    }

                    // Thu thập dữ liệu form với FormData (đã bao gồm files từ type="file")
                    const formData = new FormData(form);

                    // Xóa các fields array cũ để build lại dạng JSON string
                    formData.delete('variants[]');
                    formData.delete('existing_variants[]');

                    // Xử lý keptAdditionalImageUrls
                    // Nếu người dùng xóa hết hình ảnh phụ cũ, input name="keptAdditionalImageUrls[]" sẽ biến mất khỏi DOM
                    // Lúc đó formData.getAll('keptAdditionalImageUrls[]') sẽ là mảng rỗng []
                    // FormData không gửi mảng rỗng lên server được (sẽ bị biến mất key), do đó báo backend để xoá
                    const keptImages = formData.getAll('keptAdditionalImageUrls[]');
                    if (keptImages.length === 0) {
                        // Thêm 1 trường rỗng để backend biết là mảng rỗng (đã xoá hết) chứ không phải là undefined
                        formData.append('keptAdditionalImageUrls[]', '');
                    }

                    // Thu thập NEW variants - gửi dạng JSON string
                    const variantsJson = newVariants.map(v => ({
                        sizeId: v.sizeId,
                        colorId: v.colorId,
                        stock: v.stock,
                        sizeName: v.sizeName,
                        colorName: v.colorName
                    }));
                    formData.set('variants_json', JSON.stringify(variantsJson));

                    // Thu thập EXISTING variants (biến thể đã có)
                    const existingInputs = document.querySelectorAll('input[name="existing_variants[]"]');
                    const existingVariantsArr = [];
                    existingInputs.forEach(input => {
                        if (input.value && input.value.trim()) {
                            try {
                                existingVariantsArr.push(JSON.parse(input.value));
                            } catch (err) {
                                console.error('Error parsing existing variant:', err);
                            }
                        }
                    });
                    formData.set('existing_variants_json', JSON.stringify(existingVariantsArr));

                    // Thu thập DELETED variants (biến thể đã xóa)
                    formData.set('deleted_variants_json', JSON.stringify(deletedVariantIds));

                    console.log('📤 Submitting update via FormData');
                    console.log('📦 New variants:', variantsJson.length);
                    console.log('📦 Existing variants:', existingVariantsArr.length);
                    console.log('🗑️ Deleted variants:', deletedVariantIds.length);

                    // Gửi AJAX
                    fetch(form.action, {
                        method: 'POST',
                        body: formData // Không set Content-Type, trình duyệt sẽ tự set multipart/form-data
                    })
                        .then(async response => {
                            if (!response.ok) {
                                const errorText = await response.text();
                                throw new Error(errorText || response.statusText);
                            }
                            const contentType = response.headers.get('content-type');
                            if (contentType && contentType.includes('application/json')) {
                                return response.json();
                            }
                            return { success: true, message: 'Cập nhật thành công' };
                        })
                        .then(result => {
                            if (result.success) {
                                alert('Cập nhật sản phẩm thành công!');
                                window.location.href = '/admin/products';
                            } else {
                                alert('Lỗi: ' + (result.message || 'Không xác định'));
                            }
                        })
                        .catch(error => {
                            console.error('❌ AJAX Error:', error);
                            // Parse HTML error from Express if possible
                            try {
                                const errMatch = error.message.match(/<pre>(.*?)<\/pre>/i) || error.message.match(/Error updating product: (.*?)</i);
                                if (errMatch && errMatch[1]) {
                                    alert('Lỗi máy chủ r: ' + errMatch[1].trim());
                                } else {
                                    alert('Có lỗi xảy ra: ' + error.message.substring(0, 100));
                                }
                            } catch (e) {
                                alert('Lỗi kết nối: ' + error.message.substring(0, 100));
                            }
                        });
                });
            }

            // Apply colors to color dots
            document.addEventListener('DOMContentLoaded', function () {
                const colorDots = document.querySelectorAll('.color-dot');
                colorDots.forEach(dot => {
                    const color = dot.dataset.color;
                    if (color) {
                        dot.style.backgroundColor = color;
                    }
                });
            });
        </script>
</body>

</html>