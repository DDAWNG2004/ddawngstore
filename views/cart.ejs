<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giỏ hàng - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <% var cartList=(typeof cartItems !=='undefined' && cartItems) ? cartItems : (products || []); %>
        <!-- Header -->
        <%- include('partials/header') %>

            <!-- Breadcrumb -->
            <div class="container mx-auto px-4 py-4">
                <nav class="text-sm">
                    <a href="/" class="text-gray-600 hover:text-indigo-600">Trang chủ</a>
                    <span class="text-gray-400 mx-2">/</span>
                    <span class="text-gray-800">Giỏ hàng</span>
                </nav>
            </div>

            <!-- Cart Content -->
            <main class="container mx-auto px-4 py-8 lg:py-12 max-w-7xl">
                <div class="flex items-baseline justify-between mb-8 border-b border-gray-200 pb-6">
                    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Giỏ hàng của bạn</h1>
                    <p class="text-gray-500 font-medium"><span class="cart-count text-indigo-600 font-bold">0</span> sản
                        phẩm</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                    <!-- Left Column: Cart Items -->
                    <div class="lg:col-span-7 xl:col-span-8">
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                            <div class="p-6 bg-gray-50/50 border-b border-gray-100 flex justify-between items-center">
                                <label class="flex items-center space-x-3 cursor-pointer group">
                                    <input type="checkbox" id="selectAll"
                                        class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 transition-colors cursor-pointer">
                                    <span
                                        class="font-semibold text-gray-700 group-hover:text-indigo-600 transition-colors">Chọn
                                        tất cả</span>
                                </label>
                                <button onclick="deleteSelected()"
                                    class="text-red-500 hover:text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-lg text-sm font-semibold flex items-center transition-colors">
                                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L4 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                        </path>
                                    </svg>
                                    Xóa đã chọn
                                </button>
                            </div>

                            <div class="divide-y divide-gray-100">
                                <% if (products && products.length> 0) { %>
                                    <% products.forEach(function(item) { %>
                                        <div class="cart-item p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 hover:bg-gray-50/50 transition-colors"
                                            data-price="<%= item.product_price || item.price || 0 %>"
                                            data-quantity="<%= item.quantity || 1 %>" data-id="<%= item.id %>">

                                            <input type="checkbox"
                                                class="item-checkbox mt-4 sm:mt-0 w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer"
                                                data-id="<%= item.id %>">

                                            <div
                                                class="w-24 h-24 sm:w-28 sm:h-28 bg-gray-50 rounded-xl overflow-hidden flex-shrink-0 border border-gray-100 shadow-sm">
                                                <% if (item.image_url) { %>
                                                    <img src="<%= item.image_url %>" alt="<%= item.product_name %>"
                                                        class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <img src="https://picsum.photos/seed/<%= item.product_id %>/200/200.jpg"
                                                            alt="<%= item.product_name %>"
                                                            class="w-full h-full object-cover">
                                                        <% } %>
                                            </div>

                                            <div class="flex-1 w-full">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <h3 class="font-bold text-lg text-gray-900 line-clamp-2">
                                                            <%= item.product_name %>
                                                        </h3>
                                                        <% if (item.category_name) { %>
                                                            <p class="text-indigo-600 text-sm font-medium mt-1">
                                                                <%= item.category_name %>
                                                            </p>
                                                            <% } %>

                                                                <% if (item.size_name || item.color_name) { %>
                                                                    <div class="flex flex-wrap gap-2 mt-2">
                                                                        <% if (item.size_name) { %>
                                                                            <span
                                                                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                                                                Size: <%= item.size_name %>
                                                                            </span>
                                                                            <% } %>
                                                                                <% if (item.color_name) { %>
                                                                                    <span
                                                                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                                                                                        Màu: <%= item.color_name %>
                                                                                    </span>
                                                                                    <% } %>
                                                                    </div>
                                                                    <% } %>
                                                    </div>
                                                    <button onclick="removeFromCart('<%= item.id %>')"
                                                        class="text-gray-400 hover:text-red-500 hover:bg-red-50 p-2 rounded-lg transition-colors ml-4">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                        </svg>
                                                    </button>
                                                </div>

                                                <% let displayPrice=Number(item.product_price || item.price || 0) +
                                                    Number(item.price_adjustment || 0); %>
                                                    <div class="flex flex-wrap items-center justify-between mt-4 gap-4">
                                                        <span class="text-xl font-extrabold text-gray-900">
                                                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency' ,
                                                                currency: 'VND' }).format(displayPrice) %>
                                                        </span>

                                                        <div
                                                            class="flex items-center border border-gray-200 rounded-lg p-1 bg-white shadow-sm">
                                                            <button
                                                                class="btn-quantity-minus w-8 h-8 rounded-md hover:bg-gray-100 flex items-center justify-center text-gray-600 transition-colors focus:ring-2 focus:ring-indigo-500 outline-none">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2" d="M20 12H4"></path>
                                                                </svg>
                                                            </button>
                                                            <span class="w-10 text-center font-semibold text-gray-900">
                                                                <%= item.quantity || 1 %>
                                                            </span>
                                                            <button
                                                                class="btn-quantity-plus w-8 h-8 rounded-md hover:bg-gray-100 flex items-center justify-center text-gray-600 transition-colors focus:ring-2 focus:ring-indigo-500 outline-none">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="text-center py-16 px-4">
                                                    <div
                                                        class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6">
                                                        <svg class="w-12 h-12 text-gray-400" fill="none"
                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="1.5"
                                                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                                        </svg>
                                                    </div>
                                                    <h3 class="text-xl font-bold text-gray-900 mb-2">Giỏ hàng của bạn
                                                        đang
                                                        trống</h3>
                                                    <p class="text-gray-500 mb-8 max-w-sm mx-auto">Có vẻ như bạn chưa
                                                        thêm
                                                        sản phẩm nào vào giỏ. Khám phá các sản phẩm nổi bật của chúng
                                                        tôi
                                                        nhé!</p>
                                                    <a href="/"
                                                        class="inline-flex items-center px-8 py-3.5 border border-transparent text-base font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm hover:shadow-indigo-200 transition-all">
                                                        Tiếp tục mua sắm
                                                    </a>
                                                </div>
                                                <% } %>
                            </div>
                        </div>

                        <!-- Coupon + Order Summary (below cart items, left column) -->
                        <div class="mt-6 space-y-5">
                            <!-- Coupon Block -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                                <h3 class="font-bold text-base text-gray-900 mb-3 flex items-center">
                                    <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z">
                                        </path>
                                    </svg>
                                    Mã giảm giá
                                </h3>
                                <div class="flex space-x-2">
                                    <input type="text" id="couponCode" placeholder="Nhập mã ưu đãi..."
                                        class="flex-1 px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all font-medium text-sm uppercase placeholder:normal-case">
                                    <button onclick="applyCoupon()"
                                        class="bg-gray-900 text-white px-4 py-2 rounded-xl font-medium text-sm hover:bg-gray-800 shadow-sm transition-colors whitespace-nowrap">
                                        Áp dụng
                                    </button>
                                </div>
                                <!-- Applied Coupon Badge -->
                                <div id="appliedCouponBadge"
                                    class="hidden mt-3 flex items-center justify-between p-2.5 bg-green-50 border border-green-200 rounded-xl">
                                    <div class="flex items-center">
                                        <svg class="w-4 h-4 text-green-600 mr-2 flex-shrink-0" fill="currentColor"
                                            viewBox="0 0 20 20">
                                            <path fill-rule="evenodd"
                                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                clip-rule="evenodd"></path>
                                        </svg>
                                        <div>
                                            <span class="text-sm font-bold text-green-700" id="couponBadgeCode"></span>
                                            <span class="text-xs text-green-600 ml-1" id="couponBadgeDetail"></span>
                                        </div>
                                    </div>
                                    <button onclick="removeCoupon()"
                                        class="text-green-500 hover:text-red-500 transition-colors p-1 rounded-lg hover:bg-red-50">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Order Summary -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-5 bg-gray-50/50 border-b border-gray-100">
                                    <h3 class="font-bold text-base text-gray-900 flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z">
                                            </path>
                                        </svg>
                                        Tóm tắt đơn hàng
                                    </h3>
                                </div>
                                <div class="p-5">
                                    <div class="space-y-3">
                                        <div class="flex justify-between items-center">
                                            <span class="text-gray-500 text-sm font-medium">Tạm tính:</span>
                                            <span id="subtotal" class="font-bold text-gray-900 text-sm">0 đ</span>
                                        </div>
                                        <div class="flex justify-between items-center">
                                            <span class="text-gray-500 text-sm font-medium">Phí vận chuyển:</span>
                                            <span id="shipping" class="font-bold text-gray-900 text-sm">30.000 đ</span>
                                        </div>
                                        <!-- Coupon Discount Row (hidden by default) -->
                                        <div id="couponDiscountRow"
                                            class="hidden flex justify-between items-center text-green-600 bg-green-50/50 -mx-5 px-5 py-2">
                                            <span class="text-sm font-medium flex items-center">
                                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z">
                                                    </path>
                                                </svg>
                                                Mã <span id="couponCodeDisplay" class="font-bold ml-1"></span>:
                                            </span>
                                            <span id="discount" class="font-bold text-sm">- 0 đ</span>
                                        </div>
                                        <!-- Default discount row when no coupon -->
                                        <div id="defaultDiscountRow"
                                            class="flex justify-between items-center text-green-600">
                                            <span class="text-sm font-medium">Giảm giá:</span>
                                            <span id="discountDefault" class="font-bold text-sm">- 0 đ</span>
                                        </div>
                                        <div class="border-t border-gray-200 border-dashed pt-4 mt-3">
                                            <div class="flex justify-between items-end">
                                                <span class="font-bold text-gray-900">Thành tiền:</span>
                                                <div class="text-right">
                                                    <span id="total"
                                                        class="block font-extrabold text-2xl text-indigo-600">0 đ</span>
                                                    <span class="text-xs text-gray-500 font-medium">(Đã bao gồm
                                                        VAT)</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <button onclick="proceedToCheckout()"
                                        class="w-full bg-gradient-to-r from-indigo-600 to-indigo-700 text-white py-3.5 rounded-xl font-bold text-base hover:from-indigo-700 hover:to-indigo-800 shadow-lg shadow-indigo-200 hover:shadow-indigo-300 transition-all transform hover:-translate-y-0.5 mt-5 flex justify-center items-center">
                                        Tiến hành đặt hàng
                                        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                        </svg>
                                    </button>
                                    <a href="/"
                                        class="block w-full text-center py-3 text-sm font-semibold text-gray-500 hover:text-indigo-600 transition-colors mt-1">
                                        Thêm sản phẩm khác
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Shipping & Payment -->
                    <div class="lg:col-span-5 xl:col-span-4">
                        <div class="sticky top-24 space-y-5">

                            <!-- Shipping Form -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-5 bg-gray-50/50 border-b border-gray-100">
                                    <h3 class="font-bold text-lg text-gray-900 flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                            </path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        Thông tin giao hàng
                                    </h3>
                                </div>
                                <div class="p-5">
                                    <form id="customerInfoForm" class="space-y-3">
                                        <div class="grid grid-cols-1 gap-3">
                                            <div>
                                                <label class="block text-sm font-semibold text-gray-700 mb-1">Họ và tên
                                                    <span class="text-red-500">*</span></label>
                                                <input type="text" id="fullName"
                                                    value="<%= customer ? customer.name : '' %>" required
                                                    class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all text-sm"
                                                    placeholder="Nhập họ tên người nhận">
                                            </div>
                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="block text-sm font-semibold text-gray-700 mb-1">Số
                                                        điện thoại <span class="text-red-500">*</span></label>
                                                    <input type="tel" id="phone"
                                                        value="<%= customer ? customer.phone : '' %>" required
                                                        class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all text-sm"
                                                        placeholder="09xx">
                                                </div>
                                                <div>
                                                    <label
                                                        class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                                                    <input type="email" id="email"
                                                        value="<%= customer ? customer.email : '' %>" required
                                                        class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all text-sm"
                                                        placeholder="abc@mail.com">
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-semibold text-gray-700 mb-1">Địa chỉ
                                                    nhận hàng <span class="text-red-500">*</span></label>
                                                <textarea rows="2" id="address" required
                                                    class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all resize-none text-sm"
                                                    placeholder="Nhập địa chỉ chi tiết"><%= customer ? customer.address : '' %></textarea>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-semibold text-gray-700 mb-1">Ghi chú
                                                    thêm</label>
                                                <input type="text" id="notes"
                                                    class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:bg-white transition-all text-sm"
                                                    placeholder="Giao giờ hành chính, gọi trước khi đến...">
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Payment Methods -->
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                                <div class="p-5 bg-gray-50/50 border-b border-gray-100">
                                    <h3 class="font-bold text-lg text-gray-900 flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z">
                                            </path>
                                        </svg>
                                        Phương thức thanh toán
                                    </h3>
                                </div>
                                <div class="p-5">
                                    <div class="space-y-3" id="paymentMethodsContainer">
                                        <!-- COD -->
                                        <label
                                            class="payment-option flex items-start p-4 border-2 border-indigo-500 bg-indigo-50/30 rounded-xl cursor-pointer hover:border-indigo-500 transition-all group relative"
                                            data-method="cod">
                                            <input type="radio" name="paymentMethod" value="cod"
                                                class="mt-1 mr-3 text-indigo-600 focus:ring-indigo-500 border-gray-300"
                                                checked>
                                            <div class="flex-1">
                                                <div class="font-semibold text-gray-900 flex items-center">
                                                    <span
                                                        class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-100 mr-3">
                                                        <svg class="w-5 h-5 text-emerald-600" fill="none"
                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z">
                                                            </path>
                                                        </svg>
                                                    </span>
                                                    Thanh toán khi nhận hàng (COD)
                                                </div>
                                                <div class="text-sm text-gray-500 mt-1 ml-11">Thanh toán bằng tiền
                                                    mặt khi shipper giao sản phẩm</div>
                                            </div>
                                            <div class="payment-check absolute top-4 right-4 text-indigo-600">
                                                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd"
                                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                        clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                        </label>

                                        <!-- Chuyển khoản ngân hàng
                                            <div>
                                                <label
                                                    class="payment-option flex items-start p-4 border-2 border-gray-200 rounded-xl cursor-pointer hover:border-blue-500 transition-all group relative"
                                                    data-method="bank">
                                                    <input type="radio" name="paymentMethod" value="bank"
                                                        class="mt-1 mr-3 text-indigo-600 focus:ring-indigo-500 border-gray-300">
                                                    <div class="flex-1">
                                                        <div
                                                            class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors flex items-center">
                                                            <span
