            <script>
                function updateQuantity(itemId, change) {
                    console.log('Updating quantity:', itemId, change);

                    fetch(`/cart/update/${itemId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ change })
                    })
                        .then(response => response.json())
                        .then(result => {
                            if (result.success) {
                                // Update quantity in DOM
                                const cartItem = document.querySelector(`[data-id="${itemId}"]`);
                                if (cartItem) {
                                    // Update current quantity display
                                    const quantitySpan = cartItem.querySelector('.btn-quantity-minus').nextElementSibling;
                                    quantitySpan.textContent = result.newQuantity;

                                    // Update data attribute for order summary logic
                                    cartItem.dataset.quantity = result.newQuantity;

                                    // Update cart count in header
                                    updateCartCount(result.cartCount);

                                    // Refresh order summary (subtotal, total, etc.)
                                    updateOrderSummary();
                                }
                            } else {
                                showNotification(result.message || 'Lỗi khi cập nhật số lượng', 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error updating quantity:', error);
                            showNotification('Lỗi khi cập nhật số lượng', 'error');
                        });
                }

                function removeFromCart(itemId) {
                    console.log('Removing from cart:', itemId);

                    if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                        fetch(`/cart/remove/${itemId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        })
                            .then(response => response.json())
                            .then(result => {
                                if (result.success) {
                                    // Remove item from DOM
                                    const cartItem = document.querySelector(`[data-id="${itemId}"]`);
                                    if (cartItem) {
                                        cartItem.remove();
                                    }

                                    // Update cart count
                                    updateCartCount(result.cartCount);

                                    // Update order summary
                                    updateOrderSummary();

                                    // Show notification
                                    showNotification('Đã xóa sản phẩm khỏi giỏ hàng', 'success');

                                    // Check if cart is empty
                                    const remainingItems = document.querySelectorAll('.cart-item');
                                    if (remainingItems.length === 0) {
                                        location.reload();
                                    }
                                } else {
                                    showNotification(result.message || 'Lỗi khi xóa sản phẩm', 'error');
                                }
                            })
                            .catch(error => {
                                console.error('Error removing from cart:', error);
                                showNotification('Lỗi khi xóa sản phẩm', 'error');
                            });
                    }
                }

                function deleteSelected() {
                    const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
                    const selectedIds = Array.from(selectedCheckboxes).map(cb => cb.dataset.id);

                    if (selectedIds.length === 0) {
                        showNotification('Vui lòng chọn ít nhất một sản phẩm để xóa', 'warning');
                        return;
                    }

                    if (confirm(`Bạn có chắc muốn xóa ${selectedIds.length} sản phẩm đã chọn?`)) {
                        Promise.all(selectedIds.map(itemId =>
                            fetch(`/cart/remove/${itemId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                }
                            }).then(response => response.json())
                        ))
                            .then(results => {
                                const successCount = results.filter(r => r.success).length;
                                if (successCount > 0) {
                                    showNotification(`Đã xóa ${successCount} sản phẩm đã chọn`, 'success');

                                    // Update cart count
                                    const remainingCount = results.find(r => r.success)?.cartCount || 0;
                                    updateCartCount(remainingCount);

                                    // Reload page to update UI
                                    setTimeout(() => location.reload(), 1000);
                                } else {
                                    showNotification('Lỗi khi xóa sản phẩm', 'error');
                                }
                            })
                            .catch(error => {
                                console.error('Error deleting selected:', error);
                                showNotification('Lỗi khi xóa sản phẩm', 'error');
                            });
                    }
                }

                let currentDiscount = 0;
                let appliedCoupon = null;
                let appliedDiscountType = null;
                let appliedDiscountValue = 0;

                async function applyCoupon() {
                    const input = document.getElementById('couponCode');
                    const code = input.value.trim();
                    if (!code) {
                        showNotification('Vui lòng nhập mã giảm giá', 'warning');
                        return;
                    }

                    try {
                        const response = await fetch('/api/check-coupon', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code })
                        });
                        const result = await response.json();

                        if (result.success) {
                            showNotification(result.message, 'success');
                            appliedCoupon = result.code;
                            appliedDiscountType = result.discountType;
                            appliedDiscountValue = result.discountValue;

                            let tempSubtotal = 0;
                            document.querySelectorAll('.item-checkbox:checked').forEach(function (checkbox) {
                                const cartItem = checkbox.closest('.cart-item');
                                const price = parseFloat(cartItem.dataset.price) || 0;
                                const quantity = parseInt(cartItem.dataset.quantity) || 1;
                                tempSubtotal += price * quantity;
                            });

                            if (result.discountType === 'percent') {
                                currentDiscount = Math.round(tempSubtotal * (result.discountValue / 100));
                            } else if (result.discountType === 'fixed') {
                                currentDiscount = result.discountValue;
                            }

                            if (currentDiscount > tempSubtotal) currentDiscount = tempSubtotal;

                            // Show coupon badge
                            showCouponBadge(result.code, result.discountType, result.discountValue);

                            updateOrderSummary();
                        } else {
                            currentDiscount = 0;
                            appliedCoupon = null;
                            appliedDiscountType = null;
                            appliedDiscountValue = 0;
                            hideCouponBadge();
                            showNotification(result.message, 'error');
                            updateOrderSummary();
                        }
                    } catch (err) {
                        console.error(err);
                        showNotification('Lỗi áp dụng mã', 'error');
                    }
                }

                function showCouponBadge(code, type, value) {
                    const badge = document.getElementById('appliedCouponBadge');
                    const badgeCode = document.getElementById('couponBadgeCode');
                    const badgeDetail = document.getElementById('couponBadgeDetail');
                    badgeCode.textContent = code;
                    badgeDetail.textContent = type === 'percent' ? `(-${value}%)` : `(-${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value)})`;
                    badge.classList.remove('hidden');
                    document.getElementById('couponCode').value = '';
                    document.getElementById('couponCode').disabled = true;
                }

                function hideCouponBadge() {
                    const badge = document.getElementById('appliedCouponBadge');
                    badge.classList.add('hidden');
                    document.getElementById('couponCode').disabled = false;
                }

                function removeCoupon() {
                    currentDiscount = 0;
                    appliedCoupon = null;
                    appliedDiscountType = null;
                    appliedDiscountValue = 0;
                    hideCouponBadge();
                    updateOrderSummary();
                    showNotification('Đã xóa mã giảm giá', 'info');
                }

                function updateOrderSummary() {
                    let subtotal = 0;

                    const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
                    selectedCheckboxes.forEach(function (checkbox) {
                        const cartItem = checkbox.closest('.cart-item');
                        const price = parseFloat(cartItem.dataset.price) || 0;
                        const quantity = parseInt(cartItem.dataset.quantity) || 1;
                        subtotal += price * quantity;
                    });

                    // Re-calculate coupon discount dynamically
                    if (appliedCoupon && appliedDiscountType) {
                        if (appliedDiscountType === 'percent') {
                            currentDiscount = Math.round(subtotal * (appliedDiscountValue / 100));
                        } else {
                            currentDiscount = appliedDiscountValue;
                        }
                    } else if (subtotal === 0) {
                        currentDiscount = 0;
                    }
                    if (currentDiscount > subtotal) currentDiscount = subtotal;

                    const shipping = 30000;
                    const total = subtotal + shipping - currentDiscount;

                    const fmt = (v) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(v);
                    document.getElementById('subtotal').textContent = fmt(subtotal);
                    document.getElementById('shipping').textContent = fmt(shipping);
                    document.getElementById('total').textContent = fmt(total);

                    // Toggle coupon vs default discount row
                    const couponRow = document.getElementById('couponDiscountRow');
                    const defaultRow = document.getElementById('defaultDiscountRow');
                    if (appliedCoupon && currentDiscount > 0) {
                        couponRow.classList.remove('hidden');
                        couponRow.classList.add('flex');
                        defaultRow.classList.add('hidden');
                        document.getElementById('couponCodeDisplay').textContent = appliedCoupon;
                        document.getElementById('discount').textContent = '- ' + fmt(currentDiscount);
                    } else {
                        couponRow.classList.add('hidden');
                        couponRow.classList.remove('flex');
                        defaultRow.classList.remove('hidden');
                        document.getElementById('discountDefault').textContent = '- ' + fmt(currentDiscount);
                    }
                }

                // Update cart count in header
                function updateCartCount(count) {
                    const cartCountElements = document.querySelectorAll('.cart-count');
                    cartCountElements.forEach(element => {
                        element.textContent = count;
                        element.style.display = count > 0 ? 'inline' : 'none';
                    });
                }

                // Show notification
                function showNotification(message, type = 'info') {
                    const notification = document.createElement('div');
                    notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${type === 'success' ? 'bg-green-500 text-white' :
                        type === 'error' ? 'bg-red-500 text-white' :
                            'bg-blue-500 text-white'
                        }`;
                    notification.textContent = message;

                    document.body.appendChild(notification);

                    setTimeout(() => {
                        notification.remove();
                    }, 3000);
                }

                // Load cart count on page load
                async function loadCartCount() {
                    try {
                        const response = await fetch('/cart/count');
                        const result = await response.json();
                        updateCartCount(result.count);
                    } catch (error) {
                        console.error('Error loading cart count:', error);
                    }
                }

                async function proceedToCheckout() {
                    // Lấy id của các sản phẩm đã chọn
                    const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
                    if (selectedCheckboxes.length === 0) {
                        showNotification('Vui lòng chọn ít nhất một sản phẩm để đặt hàng', 'warning');
                        return;
                    }

                    const itemIds = Array.from(selectedCheckboxes).map(cb => {
                        const cartItem = cb.closest('.cart-item');
                        return cartItem.dataset.id; // Cart DB ID
                    });

                    // Validate form thông tin
                    const form = document.getElementById('customerInfoForm');
                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    const inputs = form.querySelectorAll('input, textarea');
                    const customer = {
                        fullName: inputs[0].value,
                        phone: inputs[1].value,
                        email: inputs[2].value,
                        address: inputs[3].value,
                        notes: inputs[4].value
                    };

                    // Lấy phương thức thanh toán
                    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;

                    try {
                        // Hiển thị loading (tùy chọn)
                        const checkoutBtn = document.querySelector('button[onclick="proceedToCheckout()"]');
                        const orgText = checkoutBtn.textContent;
                        checkoutBtn.textContent = 'Đang xử lý...';
                        checkoutBtn.disabled = true;

                        const response = await fetch('/checkout', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                itemIds,
                                customer,
                                paymentMethod,
                                couponCode: appliedCoupon
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            // Đặt hàng thành công thì tự động redirect
                            if (result.cartCount !== undefined) {
                                updateCartCount(result.cartCount);
                            }
                            if (result.payUrl) {
                                window.location.href = result.payUrl;
                            } else {
                                window.location.href = `/checkout/success?orderId=${result.orderId}&method=${paymentMethod}`;
                            }
                        } else {
                            showNotification(result.message || 'Lỗi khi đặt hàng', 'error');
                            checkoutBtn.textContent = orgText;
                            checkoutBtn.disabled = false;
                        }
                    } catch (error) {
                        console.error('Error during checkout:', error);
                        showNotification('Lỗi kết nối. Vui lòng thử lại.', 'error');
                        const checkoutBtn = document.querySelector('button[onclick="proceedToCheckout()"]');
                        checkoutBtn.textContent = 'Đặt hàng';
                        checkoutBtn.disabled = false;
                    }
                }

                // Initialize order summary on page load
                // Payment method toggle logic
                function initPaymentMethodToggle() {
                    const colorMap = {
                        cod: 'indigo',
                        bank: 'blue',
                        momo: 'pink',
                        vnpay: 'red'
                    };

                    document.querySelectorAll('input[name="paymentMethod"]').forEach(function (radio) {
                        radio.addEventListener('change', function () {
                            // Reset all payment options
                            document.querySelectorAll('.payment-option').forEach(function (opt) {
                                opt.classList.remove('border-indigo-500', 'border-blue-500', 'border-pink-500', 'border-red-500', 'bg-indigo-50/30', 'bg-blue-50/30', 'bg-pink-50/30', 'bg-red-50/30');
                                opt.classList.add('border-gray-200');
                                const check = opt.querySelector('.payment-check');
                                if (check) check.classList.add('hidden');
                            });

                            // Hide all info panels
                            document.querySelectorAll('.payment-info-panel').forEach(function (panel) {
                                panel.classList.add('hidden');
                            });

                            // Highlight selected option
                            const selectedOption = this.closest('.payment-option');
                            const method = selectedOption.dataset.method;
                            const color = colorMap[method] || 'indigo';
                            selectedOption.classList.remove('border-gray-200');
                            selectedOption.classList.add(`border-${color}-500`, `bg-${color}-50/30`);
                            const check = selectedOption.querySelector('.payment-check');
                            if (check) check.classList.remove('hidden');

                            // Show info panel if exists (next sibling of parent label)
                            const parentDiv = selectedOption.parentElement;
                            const infoPanel = parentDiv.querySelector('.payment-info-panel');
                            if (infoPanel) {
                                infoPanel.classList.remove('hidden');
                            }
                        });
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    updateOrderSummary();
                    loadCartCount(); // Load cart count on page load
                    initPaymentMethodToggle();

                    // Add event listener for select all checkbox
                    document.getElementById('selectAll').addEventListener('change', function () {
                        const itemCheckboxes = document.querySelectorAll('.item-checkbox');
                        itemCheckboxes.forEach(checkbox => {
                            checkbox.checked = this.checked;
                        });

                        // Update order summary when select all changes
                        updateOrderSummary();
                    });

                    // Add event listeners for item checkboxes
                    document.querySelectorAll('.item-checkbox').forEach(function (checkbox) {
                        checkbox.addEventListener('change', function () {
                            // Update select all checkbox state
                            const allCheckboxes = document.querySelectorAll('.item-checkbox');
                            const checkedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
                            const selectAllCheckbox = document.getElementById('selectAll');

                            if (checkedCheckboxes.length === 0) {
                                selectAllCheckbox.checked = false;
                                selectAllCheckbox.indeterminate = false;
                            } else if (checkedCheckboxes.length === allCheckboxes.length) {
                                selectAllCheckbox.checked = true;
                                selectAllCheckbox.indeterminate = false;
                            } else {
                                selectAllCheckbox.checked = false;
                                selectAllCheckbox.indeterminate = true;
                            }

                            // Update order summary when checkbox changes
                            updateOrderSummary();
                        });
                    });

                    // Add event listeners for quantity buttons
                    document.querySelectorAll('.btn-quantity-minus').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            const cartItem = this.closest('.cart-item');
                            const itemId = cartItem.dataset.id;
                            updateQuantity(itemId, -1);
                        });
                    });

                    document.querySelectorAll('.btn-quantity-plus').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            const cartItem = this.closest('.cart-item');
                            const itemId = cartItem.dataset.id;
                            updateQuantity(itemId, 1);
                        });
                    });
                });
            </script>
</body>

</html>