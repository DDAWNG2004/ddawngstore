<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giỏ hàng - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <% var cartList = (typeof cartItems !== 'undefined' && cartItems) ? cartItems : (products || []); %>
    <!-- Header -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-indigo-600">DDAWNG</h1>
                </div>
                <nav class="hidden md:flex space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600 transition">Trang chủ</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Sản phẩm</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Về chúng tôi</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Liên hệ</a>
                </nav>
                <div class="flex items-center space-x-4">
                    <button class="text-gray-700 hover:text-indigo-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                    <a href="/cart" class="text-gray-700 hover:text-indigo-600 relative">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center cart-count leading-none" style="display: none; align-items: center; justify-content: center; text-align: center; line-height: 1.25;">0</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb -->
    <div class="container mx-auto px-4 py-4">
        <nav class="text-sm">
            <a href="/" class="text-gray-600 hover:text-indigo-600">Trang chủ</a>
            <span class="text-gray-400 mx-2">/</span>
            <span class="text-gray-800">Giỏ hàng</span>
        </nav>
    </div>

    <!-- Cart Content -->
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Giỏ hàng của bạn</h1>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center space-x-4">
                            <input type="checkbox" id="selectAll" class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                            <label for="selectAll" class="font-semibold text-lg">Chọn tất cả</label>
                        </div>
                        <button onclick="deleteSelected()" class="text-red-500 hover:text-red-700 text-sm font-medium flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            Xóa 
                        </button>
                    </div>
                    
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(function(item) { %>
                            <div class="cart-item flex items-center space-x-4 py-6 border-b" 
                                 data-price="<%= item.product_price || item.price || 0 %>" 
                                 data-quantity="<%= item.quantity || 1 %>"
                                 data-id="<%= item.id %>">
                                <input type="checkbox" class="item-checkbox w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" data-id="<%= item.id %>">
                                <div class="w-24 h-24 bg-gray-100 rounded-lg overflow-hidden flex-shrink-0">
                                    <% if (item.image_url) { %>
                                        <img src="<%= item.image_url %>" alt="<%= item.product_name %>" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <img src="https://picsum.photos/seed/<%= item.product_id %>/200/200.jpg" alt="<%= item.product_name %>" class="w-full h-full object-cover">
                                    <% } %>
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-semibold text-lg"><%= item.product_name %></h3>
                                    <% if (item.category_name) { %>
                                        <p class="text-gray-600 text-sm"><%= item.category_name %></p>
                                    <% } %>
                                    <% if (item.size || item.color) { %>
                                        <p class="text-gray-500 text-sm">
                                            <% if (item.size) { %>Size: <%= item.size %><% } %>
                                            <% if (item.color) { %> - Color: <%= item.color %><% } %>
                                        </p>
                                    <% } %>
                                    <div class="flex items-center justify-between mt-2">
                                        <span class="text-lg font-bold text-indigo-600">
                                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.product_price || item.price || 0) %>
                                        </span>
                                        <div class="flex items-center space-x-2">
                                            <button class="btn-quantity-minus w-8 h-8 rounded-full border border-gray-300 hover:border-indigo-500 flex items-center justify-center">-</button>
                                            <span class="w-8 text-center"><%= item.quantity || 1 %></span>
                                            <button class="btn-quantity-plus w-8 h-8 rounded-full border border-gray-300 hover:border-indigo-500 flex items-center justify-center">+</button>
                                        </div>
                                    </div>
                                </div>
                                <button onclick="removeFromCart('<%= item.id %>')" class="text-red-500 hover:text-red-700 p-2 rounded-full hover:bg-red-50 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                </button>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center py-12">
                            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <h3 class="text-lg font-medium text-gray-900 mb-2">Giỏ hàng trống</h3>
                            <p class="text-gray-500">Bạn chưa có sản phẩm nào trong giỏ hàng.</p>
                            <a href="/" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                Tiếp tục mua sắm
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Coupon Code -->
                <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                    <h3 class="font-semibold mb-4">Mã giảm giá</h3>
                    <div class="flex space-x-2">
                        <input type="text" placeholder="Nhập mã giảm giá" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500">
                        <button onclick="applyCoupon()" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition">
                            Áp dụng
                        </button>
                    </div>
                </div>
            </div>

            <!-- Customer Info & Checkout -->
            <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                <h3 class="font-semibold text-lg mb-4">Thông tin nhận hàng</h3>
                <form id="customerInfoForm" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên *</label>
                            <input type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="Nguyễn Văn A">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại *</label>
                            <input type="tel" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="0912345678">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                        <input type="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="email@example.com">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ *</label>
                        <textarea rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="Nhập địa chỉ nhận hàng"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Ghi chú</label>
                        <textarea rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" placeholder="Ghi chú thêm (nếu có)"></textarea>
                    </div>
                </form>

                <!-- Order Summary -->
                <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                    <h3 class="font-semibold text-lg mb-4">Tổng đơn hàng</h3>
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Tạm tính:</span>
                            <span id="subtotal">0 đ</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Phí vận chuyển:</span>
                            <span id="shipping">30.000 đ</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Giảm giá:</span>
                            <span id="discount" class="text-red-500">0 đ</span>
                        </div>
                        <div class="border-t pt-3">
                            <div class="flex justify-between">
                                <span class="font-semibold text-lg">Tổng cộng:</span>
                                <span id="total" class="font-semibold text-lg text-indigo-600">0 đ</span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Methods -->
                    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                        <h3 class="font-semibold text-lg mb-4">Phương thức thanh toán</h3>
                        <div class="space-y-3">
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-indigo-500 transition">
                                <input type="radio" name="paymentMethod" value="cod" class="mr-3" checked>
                                <div class="flex-1">
                                    <div class="font-medium">Thanh toán khi nhận hàng (COD)</div>
                                    <div class="text-sm text-gray-500">Thanh toán bằng tiền mặt khi nhận sản phẩm</div>
                                </div>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-indigo-500 transition">
                                <input type="radio" name="paymentMethod" value="bank" class="mr-3">
                                <div class="flex-1">
                                    <div class="font-medium">Chuyển khoản ngân hàng</div>
                                    <div class="text-sm text-gray-500">Chuyển khoản qua ngân hàng nội địa</div>
                                </div>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-indigo-500 transition">
                                <input type="radio" name="paymentMethod" value="card" class="mr-3">
                                <div class="flex-1">
                                    <div class="font-medium">Thẻ tín dụng/Ghi nợ</div>
                                    <div class="text-sm text-gray-500">Thanh toán qua Visa, Mastercard, JCB</div>
                                </div>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-indigo-500 transition">
                                <input type="radio" name="paymentMethod" value="ewallet" class="mr-3">
                                <div class="flex-1">
                                    <div class="font-medium">Ví điện tử</div>
                                    <div class="text-sm text-gray-500">MoMo, ZaloPay, ShopeePay</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <button onclick="proceedToCheckout()" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-700 transition mt-6">
                        Đặt hàng
                    </button>
                    <a href="/" class="block w-full text-center py-3 text-indigo-600 hover:text-indigo-700 mt-3">
                        ← Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white mt-16">
        <div class="container mx-auto px-4 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h4 class="text-lg font-semibold mb-4">DDAWNG Store</h4>
                    <p class="text-gray-300 text-sm">
                        Cửa hàng thời trang cao cấp với các sản phẩm chất lượng và mẫu mã đa dạng.
                    </p>
                </div>
                <div>
                    <h4 class="text-lg font-semibold mb-4">Sản phẩm</h4>
                    <ul class="space-y-2 text-gray-300 text-sm">
                        <li><a href="#" class="hover:text-white transition">Áo</a></li>
                        <li><a href="#" class="hover:text-white transition">Quần</a></li>
                        <li><a href="#" class="hover:text-white transition">Váy</a></li>
                        <li><a href="#" class="hover:text-white transition">Phụ kiện</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-semibold mb-4">Hỗ trợ</h4>
                    <ul class="space-y-2 text-gray-300 text-sm">
                        <li><a href="#" class="hover:text-white transition">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="hover:text-white transition">Chính sách đổi trả</a></li>
                        <li><a href="#" class="hover:text-white transition">Chính sách bảo mật</a></li>
                        <li><a href="#" class="hover:text-white transition">Vận chuyển</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-semibold mb-4">Liên hệ</h4>
                    <ul class="space-y-2 text-gray-300 text-sm">
                        <li class="flex items-center">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502.842l-2.106-2.106A1 1 0 015 9.5H7a1 1 0 00-1 1v5a1 1 0 001 1h3.28a1 1 0 01.948-.684l1.498-4.493A1 1 0 0112.5 3H7a2 2 0 00-2 2v5a2 2 0 002 2z"></path>
                            </svg>
                            123 Nguyễn Huệ, Q.10, Phú Nhuận, TP.HCM
                        </li>
                        <li class="flex items-center">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502.842l-2.106-2.106A1 1 0 015 9.5H7a1 1 0 00-1 1v5a1 1 0 001 1h3.28a1 1 0 01.948-.684l1.498-4.493A1 1 0 0112.5 3H7a2 2 0 00-2 2v5a2 2 0 002 2z"></path>
                            </svg>
                            (028) 1234 5678
                        </li>
                        <li class="flex items-center">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            support@ddawngstore.com
                        </li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400 text-sm">
                <p>&copy; 2024 DDAWNG Store. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        function updateQuantity(itemId, change) {
            console.log('Updating quantity:', itemId, change);
            // TODO: Implement AJAX call to update quantity
            updateOrderSummary();
        }

        function removeFromCart(itemId) {
            console.log('Removing from cart:', itemId);
            
            if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                fetch(`/cart/remove/${itemId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        // Remove item from DOM
                        const cartItem = document.querySelector(`[data-id="${itemId}"]`);
                        if (cartItem) {
                            cartItem.remove();
                        }
                        
                        // Update cart count
                        updateCartCount(result.cartCount);
                        
                        // Update order summary
                        updateOrderSummary();
                        
                        // Show notification
                        showNotification('Đã xóa sản phẩm khỏi giỏ hàng', 'success');
                        
                        // Check if cart is empty
                        const remainingItems = document.querySelectorAll('.cart-item');
                        if (remainingItems.length === 0) {
                            location.reload();
                        }
                    } else {
                        showNotification(result.message || 'Lỗi khi xóa sản phẩm', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error removing from cart:', error);
                    showNotification('Lỗi khi xóa sản phẩm', 'error');
                });
            }
        }

        function deleteSelected() {
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            const selectedIds = Array.from(selectedCheckboxes).map(cb => cb.dataset.id);
            
            if (selectedIds.length === 0) {
                showNotification('Vui lòng chọn ít nhất một sản phẩm để xóa', 'warning');
                return;
            }
            
            if (confirm(`Bạn có chắc muốn xóa ${selectedIds.length} sản phẩm đã chọn?`)) {
                Promise.all(selectedIds.map(itemId => 
                    fetch(`/cart/remove/${itemId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    }).then(response => response.json())
                ))
                .then(results => {
                    const successCount = results.filter(r => r.success).length;
                    if (successCount > 0) {
                        showNotification(`Đã xóa ${successCount} sản phẩm đã chọn`, 'success');
                        
                        // Update cart count
                        const remainingCount = results.find(r => r.success)?.cartCount || 0;
                        updateCartCount(remainingCount);
                        
                        // Reload page to update UI
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showNotification('Lỗi khi xóa sản phẩm', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error deleting selected:', error);
                    showNotification('Lỗi khi xóa sản phẩm', 'error');
                });
            }
        }

        function applyCoupon() {
            console.log('Applying coupon');
            // TODO: Implement coupon logic
            updateOrderSummary();
        }

        function updateOrderSummary() {
            // Tính toán tổng đơn hàng chỉ cho sản phẩm đã chọn
            let subtotal = 0;
            
            // Lấy dữ liệu từ các sản phẩm đã chọn trong giỏ hàng
            const selectedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
            selectedCheckboxes.forEach(function(checkbox) {
                const cartItem = checkbox.closest('.cart-item');
                const price = parseFloat(cartItem.dataset.price) || 0;
                const quantity = parseInt(cartItem.dataset.quantity) || 1;
                subtotal += price * quantity;
            });
            
            const shipping = 30000;
            const discount = 0;
            const total = subtotal + shipping - discount;
            
            document.getElementById('subtotal').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(subtotal);
            document.getElementById('shipping').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(shipping);
            document.getElementById('discount').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(discount);
            document.getElementById('total').textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total);
        }
        
        // Update cart count in header
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
                element.style.display = count > 0 ? 'inline' : 'none';
            });
        }
        
        // Show notification
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
        
        // Load cart count on page load
        async function loadCartCount() {
            try {
                const response = await fetch('/cart/count');
                const result = await response.json();
                updateCartCount(result.count);
            } catch (error) {
                console.error('Error loading cart count:', error);
            }
        }

        function proceedToCheckout() {
            // TODO: Implement checkout process
            console.log('Proceeding to checkout');
            alert('Chức năng thanh toán đang được phát triển!');
        }

        // Initialize order summary on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateOrderSummary();
            loadCartCount(); // Load cart count on page load
            
            // Add event listener for select all checkbox
            document.getElementById('selectAll').addEventListener('change', function() {
                const itemCheckboxes = document.querySelectorAll('.item-checkbox');
                itemCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
                
                // Update order summary when select all changes
                updateOrderSummary();
            });
            
            // Add event listeners for item checkboxes
            document.querySelectorAll('.item-checkbox').forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    // Update select all checkbox state
                    const allCheckboxes = document.querySelectorAll('.item-checkbox');
                    const checkedCheckboxes = document.querySelectorAll('.item-checkbox:checked');
                    const selectAllCheckbox = document.getElementById('selectAll');
                    
                    if (checkedCheckboxes.length === 0) {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = false;
                    } else if (checkedCheckboxes.length === allCheckboxes.length) {
                        selectAllCheckbox.checked = true;
                        selectAllCheckbox.indeterminate = false;
                    } else {
                        selectAllCheckbox.checked = false;
                        selectAllCheckbox.indeterminate = true;
                    }
                    
                    // Update order summary when checkbox changes
                    updateOrderSummary();
                });
            });
            
            // Add event listeners for quantity buttons
            document.querySelectorAll('.btn-quantity-minus').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const cartItem = this.closest('.cart-item');
                    const itemId = cartItem.dataset.id;
                    updateQuantity(itemId, -1);
                });
            });
            
            document.querySelectorAll('.btn-quantity-plus').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const cartItem = this.closest('.cart-item');
                    const itemId = cartItem.dataset.id;
                    updateQuantity(itemId, 1);
                });
            });
        });
    </script>
</body>
</html>
