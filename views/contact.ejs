<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên hệ - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Hero Banner -->
    <div class="relative bg-gradient-to-r from-indigo-900 via-indigo-800 to-purple-900 py-16 overflow-hidden">
        <!-- Decorative glowing blur elements -->
        <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-purple-500/20 blur-3xl pointer-events-none"></div>
        
        <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
            <nav class="flex justify-center text-sm text-indigo-200/80 mb-4" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="/" class="hover:text-white transition-colors">Trang chủ</a></li>
                    <li><span class="mx-2">/</span></li>
                    <li class="text-white font-medium">Liên hệ</li>
                </ol>
            </nav>
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Liên Hệ Với Chúng Tôi</h1>
            <p class="mt-4 max-w-2xl mx-auto text-lg text-indigo-100/80">Chúng tôi luôn lắng nghe và sẵn sàng hỗ trợ bạn bất cứ lúc nào!</p>
        </div>
    </div>

    <!-- Main Content Grid -->
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-7xl mx-auto">
            <!-- Left Column: Contact details & Map -->
            <div class="space-y-8 flex flex-col justify-between">
                <!-- Contact Info Card -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8 space-y-6 flex-1">
                    <h2 class="text-2xl font-bold text-gray-900 border-b border-gray-100 pb-4 mb-6">Thông tin liên hệ</h2>
                    
                    <div class="flex items-start space-x-4 group">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800 text-lg">Địa chỉ cửa hàng</h3>
                            <p class="text-gray-600 mt-1 leading-relaxed">Số 123 Đường Cầu Giấy, Quận Cầu Giấy, Hà Nội, Việt Nam</p>
                        </div>
                    </div>
                    
                    <div class="flex items-start space-x-4 group">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800 text-lg">Hotline tư vấn</h3>
                            <p class="text-gray-600 mt-1">
                                <a href="tel:0987654321" class="hover:text-indigo-600 transition-colors font-medium">0987.654.321</a> / 
                                <a href="tel:0123456789" class="hover:text-indigo-600 transition-colors font-medium">0123.456.789</a>
                            </p>
                            <p class="text-xs text-gray-400 mt-1">(Hỗ trợ 24/7 đối với đơn hàng trực tuyến)</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4 group">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800 text-lg">Email liên hệ</h3>
                            <p class="text-gray-600 mt-1"><a href="mailto:contact@ddawngstore.com" class="hover:text-indigo-600 transition-colors">contact@ddawngstore.com</a></p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4 group">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 shrink-0 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-sm">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800 text-lg">Giờ mở cửa</h3>
                            <p class="text-gray-600 mt-1">Thứ 2 - Chủ Nhật: 08:30 - 22:00</p>
                        </div>
                    </div>
                </div>

                <!-- Google Map Iframe Container -->
                <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-3 h-[320px] overflow-hidden">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.9242784575994!2d105.7958564!3d21.0357106!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ab3847e8c3b7%3A0xc3b7a5a87ef8d1!2zQ-G6p3UgR2nhuqV5LCBIw6AgTuG7mWksIFZp4buHdCBOYW0!5e0!3m2!1svi!2s!4v1700000000000!5m2!1svi!2s" width="100%" height="100%" style="border:0; border-radius: 1.25rem;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <!-- Right Column: Form -->
            <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
                <h2 class="text-2xl font-bold text-gray-900 border-b border-gray-100 pb-4 mb-6">Gửi tin nhắn cho chúng tôi</h2>
                
                <form id="contactForm" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="fullName" class="block text-sm font-semibold text-gray-700 mb-2">Họ và tên *</label>
                            <input type="text" id="fullName" name="fullName" required class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="Nguyễn Văn A" value="<%= customer ? customer.name : '' %>">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email *</label>
                            <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="example@gmail.com" value="<%= customer ? customer.email : '' %>">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Số điện thoại</label>
                            <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="0987654321" value="<%= customer ? customer.phone : '' %>">
                        </div>
                        <div>
                            <label for="subject" class="block text-sm font-semibold text-gray-700 mb-2">Chủ đề *</label>
                            <input type="text" id="subject" name="subject" required class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none" placeholder="Hỗ trợ đơn hàng / Hỏi đáp...">
                        </div>
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Nội dung lời nhắn *</label>
                        <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none resize-none" placeholder="Nhập nội dung bạn muốn gửi..."></textarea>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full py-4 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold rounded-xl transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 transform active:scale-[0.98]">
                        <span id="btnText">Gửi tin nhắn</span>
                        <svg id="submitIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                        <svg id="loadingSpinner" class="animate-spin h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-20 pt-16 pb-8">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                <div class="col-span-1 md:col-span-1">
                    <h2 class="text-2xl font-bold text-indigo-600 mb-6">DDAWNG</h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6">Thương hiệu thời trang cao cấp mang đến phong cách thanh lịch và hiện đại cho người Việt.</p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-indigo-600 transition-colors">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                            </svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-indigo-600 transition-colors">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                            </svg>
                        </a>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6">Liên kết nhanh</h3>
                    <ul class="space-y-4">
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Về chúng tôi</a></li>
                        <li><a href="/products" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Cửa hàng</a></li>
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Tin tức</a></li>
                        <li><a href="/contact" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Liên hệ</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6">Hỗ trợ khách hàng</h3>
                    <ul class="space-y-4">
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Chính sách đổi trả</a></li>
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Chính sách bảo hành</a></li>
                        <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6">Bản tin</h3>
                    <p class="text-gray-500 text-sm mb-4">Đăng ký để nhận thông tin về các bộ sưu tập mới và ưu đãi đặc biệt.</p>
                    <form class="flex">
                        <input type="email" placeholder="Email của bạn" class="flex-1 min-w-0 px-4 py-2 border border-gray-300 rounded-l-lg text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500">
                        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-r-lg text-sm font-medium hover:bg-indigo-700 transition">Đăng ký</button>
                    </form>
                </div>
            </div>
            <div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
                <p>&copy; 2024 DDAWNG Store. Đã đăng ký bản quyền.</p>
                <div class="flex space-x-6">
                    <a href="#" class="hover:text-indigo-600 transition">Chính sách bảo mật</a>
                    <a href="#" class="hover:text-indigo-600 transition">Điều khoản sử dụng</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Update cart count
            function updateCartCount() {
                $.get('/cart/count', function (data) {
                    if (data.count > 0) {
                        $('.cart-count').text(data.count).show();
                    } else {
                        $('.cart-count').hide();
                    }
                });
            }
            updateCartCount();

            // Contact Form Submission
            $('#contactForm').on('submit', function (e) {
                e.preventDefault();

                const btn = $('#submitBtn');
                const btnText = $('#btnText');
                const submitIcon = $('#submitIcon');
                const loadingSpinner = $('#loadingSpinner');

                // UI Loading state
                btn.prop('disabled', true);
                btnText.text('Đang gửi...');
                submitIcon.addClass('hidden');
                loadingSpinner.removeClass('hidden');

                const formData = {
                    fullName: $('#fullName').val(),
                    email: $('#email').val(),
                    phone: $('#phone').val(),
                    subject: $('#subject').val(),
                    message: $('#message').val()
                };

                $.ajax({
                    url: '/contact',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (res) {
                        // Reset loading state
                        btn.prop('disabled', false);
                        btnText.text('Gửi tin nhắn');
                        submitIcon.removeClass('hidden');
                        loadingSpinner.addClass('hidden');

                        if (res.success) {
                            showNotification(res.message || 'Gửi tin nhắn thành công!', 'success');
                            // Clear message contents
                            $('#subject').val('');
                            $('#message').val('');
                            // Only reset sender details if guest user
                            <% if (!customer) { %>
                                $('#fullName').val('');
                                $('#email').val('');
                                $('#phone').val('');
                            <% } %>
                        } else {
                            showNotification(res.message || 'Có lỗi xảy ra, vui lòng thử lại.', 'error');
                        }
                    },
                    error: function (xhr) {
                        // Reset loading state
                        btn.prop('disabled', false);
                        btnText.text('Gửi tin nhắn');
                        submitIcon.removeClass('hidden');
                        loadingSpinner.addClass('hidden');

                        const errResponse = xhr.responseJSON;
                        showNotification(errResponse?.message || 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.', 'error');
                    }
                });
            });

            // Toast notifications helper
            function showNotification(message, type = 'success') {
                const toast = document.createElement('div');
                toast.className = `fixed bottom-4 right-4 p-4 rounded-xl shadow-lg z-50 text-white font-medium text-sm transition-all duration-300 transform translate-y-10 opacity-0 flex items-center gap-2 ${
                    type === 'success' ? 'bg-emerald-500' : 'bg-red-500'
                }`;
                
                const icon = type === 'success' 
                    ? `<svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                    : `<svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
                
                toast.innerHTML = icon + `<span>${message}</span>`;
                
                document.body.appendChild(toast);
                
                // Animate in
                requestAnimationFrame(() => {
                    toast.classList.remove('translate-y-10', 'opacity-0');
                });
                
                // Remove after 4 seconds
                setTimeout(() => {
                    toast.classList.add('translate-y-10', 'opacity-0');
                    setTimeout(() => {
                        toast.remove();
                    }, 300);
                }, 4000);
            }
        });
    </script>
</body>

</html>
