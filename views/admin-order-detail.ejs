<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - DDAWNG Store Admin
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <%- include('partials/admin-header', { activePage: 'orders' }) %>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Header Actions -->
            <div class="sm:flex sm:items-center mb-6">
                <div class="sm:flex-auto">
                    <h1 class="text-2xl font-bold leading-tight text-gray-900 sm:text-3xl sm:truncate">Chi tiết đơn hàng
                        #<%= order.id %>
                    </h1>
                    <p class="mt-2 text-sm text-gray-600">Đặt ngày: <%= new
                            Date(order.created_at).toLocaleDateString('vi-VN') %>
                    </p>
                </div>
                <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
                    <a href="/admin/orders"
                        class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Quay lại
                    </a>
                    <button onclick="deleteOrder(<%= order.id %>)"
                        class="ml-3 inline-flex items-center justify-center rounded-md border border-transparent bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L4 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Xóa đơn hàng
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Order Information -->
                <div class="lg:col-span-2">
                    <!-- Customer Info -->
                    <div class="bg-white shadow overflow-hidden sm:rounded-md mb-6">
                        <div class="px-4 py-5 sm:px-6">
                            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Thông tin khách hàng</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="flex items-center space-x-4">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        <img class="h-10 w-10 rounded-full object-cover"
                                            src="<%= order.customer_avatar || '/images/avatardefault.jpg' %>"
                                            alt="<%= order.customer_name %>">
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-gray-500">Họ tên</p>
                                        <p class="mt-1 text-sm text-gray-900">
                                            <%= order.customer_name %>
                                        </p>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Email</p>
                                    <p class="mt-1 text-sm text-gray-900">
                                        <%= order.customer_email %>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Điện thoại</p>
                                    <p class="mt-1 text-sm text-gray-900">
                                        <%= order.shipping_phone %>
                                    </p>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-500">Địa chỉ giao hàng</p>
                                    <p class="mt-1 text-sm text-gray-900">
                                        <%= order.shipping_address %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items -->
                    <div class="bg-white shadow overflow-hidden sm:rounded-md">
                        <div class="px-4 py-5 sm:px-6">
                            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Sản phẩm</h3>
                            <div class="overflow-x-auto">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Sản phẩm</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Đơn giá</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Số lượng</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                                Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        <% orderItems.forEach(item=> { %>
                                            <tr>
                                                <td class="px-6 py-4 whitespace-nowrap">
                                                    <div class="flex items-center">
                                                        <div class="flex-shrink-0 h-12 w-12">
                                                            <img class="h-12 w-12 rounded object-cover"
                                                                src="<%= item.image_url || 'https://picsum.photos/seed/' + item.id + '/100/100.jpg' %>"
                                                                alt="<%= item.product_name %>">
                                                        </div>
                                                        <div class="ml-4">
                                                            <div class="text-sm font-medium text-gray-900">
                                                                <%= item.product_name %>
                                                            </div>
                                                            <div class="text-sm text-gray-500">
                                                                <%= item.product_sku || '' %>
                                                            </div>
                                                            <% if (item.variant_info) { let vInfo={}; try {
                                                                vInfo=JSON.parse(item.variant_info); } catch(e){} %>
                                                                <% if (vInfo.size || vInfo.color) { %>
                                                                    <div class="text-xs text-indigo-500 mt-1">
                                                                        <%= vInfo.size ? 'Size: ' + vInfo.size : '' %>
                                                                            <%= (vInfo.size && vInfo.color) ? ' | ' : ''
                                                                                %>
                                                                                <%= vInfo.color ? 'Màu: ' + vInfo.color
                                                                                    : '' %>
                                                                    </div>
                                                                    <% } %>
                                                                        <% } %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                    <%= Number(item.price).toLocaleString('vi-VN') %>đ
                                                </td>
                                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                    <%= item.quantity %>
                                                </td>
                                                <td
                                                    class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                                    <%= Number(item.total).toLocaleString('vi-VN') %>đ
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="lg:col-span-1">
                    <div class="bg-white shadow overflow-hidden sm:rounded-md">
                        <div class="px-4 py-5 sm:px-6">
                            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Tóm tắt đơn hàng</h3>
                            <dl class="space-y-3">
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Mã đơn hàng</dt>
                                    <dd class="text-sm text-gray-900">#<%= order.id %>
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Trạng thái</dt>
                                    <dd>
                                        <div class="flex items-center space-x-2">
                                            <select id="orderStatus"
                                                class="block w-full pl-3 pr-10 py-1.5 text-xs text-gray-900 border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md shadow-sm">
                                                <option value="pending" <%=order.status==='pending' ? 'selected' : '' %>
                                                    >Chờ xử lý</option>
                                                <option value="confirmed" <%=order.status==='confirmed' ? 'selected'
                                                    : '' %>>Đã xác nhận</option>
                                                <option value="processing" <%=order.status==='processing' ? 'selected'
                                                    : '' %>>Đang xử lý</option>
                                                <option value="shipped" <%=order.status==='shipped' ? 'selected' : '' %>
                                                    >Đang giao</option>
                                                <option value="delivered" <%=order.status==='delivered' ? 'selected'
                                                    : '' %>>Đã giao</option>
                                                <option value="cancelled" <%=order.status==='cancelled' ? 'selected'
                                                    : '' %>>Đã hủy</option>
                                            </select>
                                            <button onclick="updateOrderStatus(<%= order.id %>)"
                                                class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded text-indigo-700 bg-indigo-100 hover:bg-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 whitespace-nowrap">
                                                Lưu
                                            </button>
                                        </div>
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Thanh toán</dt>
                                    <dd>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                        <% if (order.payment_status === 'pending') { %>bg-yellow-100 text-yellow-800<% } %>
                                        <% if (order.payment_status === 'paid') { %>bg-green-100 text-green-800<% } %>
                                        <% if (order.payment_status === 'failed') { %>bg-red-100 text-red-800<% } %>
                                    ">
                                            <%= order.payment_status==='pending' ? 'Chờ thanh toán' : '' %>
                                                <%= order.payment_status==='paid' ? 'Đã thanh toán' : '' %>
                                                    <%= order.payment_status==='failed' ? 'Thất bại' : '' %>
                                        </span>
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Phương thức thanh toán</dt>
                                    <dd class="text-sm text-gray-900">
                                        <%= order.payment_method || 'COD' %>
                                    </dd>
                                </div>
                                <hr>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Tạm tính</dt>
                                    <dd class="text-sm text-gray-900">
                                        <%= Number(order.subtotal).toLocaleString('vi-VN') %>đ
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Phí vận chuyển</dt>
                                    <dd class="text-sm text-gray-900">
                                        <%= Number(order.shipping_amount).toLocaleString('vi-VN') %>đ
                                    </dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-sm font-medium text-gray-500">Giảm giá</dt>
                                    <dd class="text-sm text-gray-900">-<%=
                                            Number(order.discount_amount).toLocaleString('vi-VN') %>đ</dd>
                                </div>
                                <hr>
                                <div class="flex justify-between">
                                    <dt class="text-base font-medium text-gray-900">Tổng cộng</dt>
                                    <dd class="text-base font-medium text-gray-900">
                                        <%= Number(order.total_amount).toLocaleString('vi-VN') %>đ
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            function updateOrderStatus(orderId) {
                const status = document.getElementById('orderStatus').value;
                const btn = event.currentTarget;
                const originalText = btn.innerHTML;

                btn.innerHTML = 'Đang lưu...';
                btn.disabled = true;

                fetch(`/admin/orders/${orderId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Cập nhật trạng thái thành công!');
                            window.location.reload();
                        } else {
                            alert(data.message || 'Lỗi khi cập nhật trạng thái');
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Lỗi kết nối khi cập nhật trạng thái');
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
            }

            function deleteOrder(orderId) {
                if (confirm('Bạn có chắc chắn muốn xóa đơn hàng này?')) {
                    fetch(`/admin/orders/${orderId}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert(data.message);
                                window.location.href = '/admin/orders';
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Lỗi khi xóa đơn hàng');
                        });
                }
            }
        </script>
</body>

</html>