<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-indigo-600">DDAWNG</h1>
                </div>
                <nav class="hidden md:flex space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600 transition">Trang chủ</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Sản phẩm</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Về chúng tôi</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Liên hệ</a>
                </nav>
                <div class="flex items-center space-x-4">
                    <button class="text-gray-700 hover:text-indigo-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                    <a href="/cart" class="text-gray-700 hover:text-indigo-600 relative">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center cart-count leading-none" style="display: none;">0</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Breadcrumb -->
    <div class="container mx-auto px-4 py-4">
        <nav class="text-sm">
            <a href="/" class="text-gray-600 hover:text-indigo-600">Trang chủ</a>
            <span class="text-gray-400 mx-2">/</span>
            <a href="#" class="text-gray-600 hover:text-indigo-600">Sản phẩm</a>
            <span class="text-gray-400 mx-2">/</span>
            <span class="text-gray-800">Váy hoa nhí</span>
        </nav>
    </div>

    <!-- Product Detail -->
    <main class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Product Images -->
            <div class="space-y-4">
                <div class="bg-white rounded-lg shadow-md p-4">
                    <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
                        <% if (images && images.length > 0) { %>
                            <img src="<%= images[0].image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover" id="mainImage">
                        <% } else { %>
                            <img src="https://picsum.photos/seed/<%= product.id %>/600/600.jpg" alt="<%= product.name %>" class="w-full h-full object-cover" id="mainImage">
                        <% } %>
                    </div>
                </div>
                <div class="grid grid-cols-4 gap-2">
                    <% if (images && images.length > 0) { %>
                        <% images.forEach((image, index) => { %>
                            <div class="bg-white rounded-lg shadow-md p-2 cursor-pointer <%= index === 0 ? 'border-2 border-indigo-500' : 'hover:border-2 hover:border-indigo-500' %> transition" onclick="changeMainImage('<%= image.image_url %>')">
                                <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                                    <img src="<%= image.image_url %>" alt="<%= product.name %> <%= index + 1 %>" class="w-full h-full object-cover">
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="bg-white rounded-lg shadow-md p-2 cursor-pointer border-2 border-indigo-500">
                            <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                                <img src="https://picsum.photos/seed/<%= product.id %>/600/600.jpg" alt="<%= product.name %>" class="w-full h-full object-cover">
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Product Info -->
            <div class="space-y-6">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= product.name %></h1>
                    <% if (product.category_name) { %>
                        <div class="mb-2">
                            <span class="inline-block bg-indigo-100 text-indigo-800 text-sm px-3 py-1 rounded-full">
                                <%= product.category_name %>
                            </span>
                        </div>
                    <% } %>
                    <div class="flex items-center space-x-4 mb-4">
                        <div class="flex text-yellow-400">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                            <svg class="w-5 h-5 text-gray-300" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                        </div>
                        <span class="text-gray-600">(4.0/5.0 - 128 đánh giá)</span>
                    </div>
                    <div class="flex items-baseline space-x-2">
                        <span class="text-3xl font-bold text-indigo-600">
                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
                        </span>
                        <% if (product.stock_quantity > 0) { %>
                            <span class="text-sm text-green-600">Còn hàng: <%= product.stock_quantity %></span>
                        <% } else { %>
                            <span class="text-sm text-red-600">Hết hàng</span>
                        <% } %>
                    </div>
                </div>

                <div class="border-t border-b border-gray-200 py-4">
                    <h3 class="font-semibold mb-2">Mô tả sản phẩm</h3>
                    <p class="text-gray-600 leading-relaxed">
                        <%= product.description || 'Sản phẩm chất lượng cao, thiết kế hiện đại và phong cách.' %>
                    </p>
                </div>

                <div>
                    <h3 class="font-semibold mb-3">Chọn size</h3>
                    <div class="flex space-x-2">
                        <button class="px-4 py-2 border border-gray-300 rounded hover:border-indigo-500 transition">S</button>
                        <button class="px-4 py-2 border border-gray-300 rounded hover:border-indigo-500 transition">M</button>
                        <button class="px-4 py-2 border border-indigo-500 bg-indigo-50 text-indigo-600 rounded">L</button>
                        <button class="px-4 py-2 border border-gray-300 rounded hover:border-indigo-500 transition">XL</button>
                    </div>
                    <div class="mt-2">
                        <a href="#" class="text-sm text-indigo-600 hover:underline">Hướng dẫn chọn size</a>
                    </div>
                </div>

                <div>
                    <h3 class="font-semibold mb-3">Màu sắc</h3>
                    <div class="flex space-x-2">
                        <button class="w-8 h-8 rounded-full bg-pink-200 border-2 border-indigo-500"></button>
                        <button class="w-8 h-8 rounded-full bg-blue-200 border-2 border-gray-300 hover:border-indigo-500 transition"></button>
                        <button class="w-8 h-8 rounded-full bg-yellow-200 border-2 border-gray-300 hover:border-indigo-500 transition"></button>
                        <button class="w-8 h-8 rounded-full bg-green-200 border-2 border-gray-300 hover:border-indigo-500 transition"></button>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex space-x-4">
                        <div class="flex items-center border border-gray-300 rounded">
                            <button onclick="decreaseQuantity()" class="px-3 py-2 hover:bg-gray-100">-</button>
                            <input type="number" id="quantity" value="1" min="1" class="w-16 text-center border-x border-gray-300 py-2">
                            <button onclick="increaseQuantity()" class="px-3 py-2 hover:bg-gray-100">+</button>
                        </div>
                        <button onclick="addToCart()" class="flex-1 bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-700 transition" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= product.price %>" data-product-stock="<%= product.stock_quantity %>">
                            Thêm vào giỏ hàng
                        </button>
                    </div>
                    <button class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition">
                        Mua ngay
                    </button>
                </div>

                <div class="border-t border-gray-200 pt-4">
                    <div class="grid grid-cols-2 gap-4 text-sm">
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-600">Miễn phí vận chuyển</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-600">Đổi trả trong 7 ngày</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-600">Hàng chính hãng</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-gray-600">Hotline hỗ trợ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Details Tabs -->
        <div class="mt-16">
            <div class="border-b border-gray-200">
                <nav class="flex space-x-8">
                    <button class="py-2 border-b-2 border-indigo-500 text-indigo-600 font-semibold">Chi tiết sản phẩm</button>
                    <button class="py-2 border-b-2 border-transparent text-gray-600 hover:text-gray-800">Đánh giá</button>
                    <button class="py-2 border-b-2 border-transparent text-gray-600 hover:text-gray-800">Hướng dẫn chăm sóc</button>
                </nav>
            </div>
            <div class="py-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h3 class="font-semibold mb-4">Thông tin sản phẩm</h3>
                        <table class="w-full text-sm">
                            <tr class="border-b">
                                <td class="py-2 text-gray-600">Chất liệu</td>
                                <td class="py-2">Lụa tơ tự nhiên</td>
                            </tr>
                            <tr class="border-b">
                                <td class="py-2 text-gray-600">Xuất xứ</td>
                                <td class="py-2">Việt Nam</td>
                            </tr>
                            <tr class="border-b">
                                <td class="py-2 text-gray-600">Thương hiệu</td>
                                <td class="py-2">DDAWNG</td>
                            </tr>
                            <tr class="border-b">
                                <td class="py-2 text-gray-600">Mùa</td>
                                <td class="py-2">Xuân, Hè</td>
                            </tr>
                        </table>
                    </div>
                    <div>
                        <h3 class="font-semibold mb-4">Hướng dẫn chọn size</h3>
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b">
                                    <th class="py-2 text-left">Size</th>
                                    <th class="py-2 text-center">S</th>
                                    <th class="py-2 text-center">M</th>
                                    <th class="py-2 text-center">L</th>
                                    <th class="py-2 text-center">XL</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Vòng ngực (cm)</td>
                                    <td class="py-2 text-center">84</td>
                                    <td class="py-2 text-center">88</td>
                                    <td class="py-2 text-center">92</td>
                                    <td class="py-2 text-center">96</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Vòng eo (cm)</td>
                                    <td class="py-2 text-center">64</td>
                                    <td class="py-2 text-center">68</td>
                                    <td class="py-2 text-center">72</td>
                                    <td class="py-2 text-center">76</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="py-16 bg-gray-50">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center mb-12">Sản phẩm liên quan</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <% relatedProducts.forEach(relatedProduct => { %>
                        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
                            <div class="h-64 bg-gray-200 flex items-center justify-center">
                                <% if (relatedProduct.image_url) { %>
                                    <img src="<%= relatedProduct.image_url %>" alt="<%= relatedProduct.name %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <img src="https://picsum.photos/seed/<%= relatedProduct.id %>/400/500.jpg" alt="<%= relatedProduct.name %>" class="w-full h-full object-cover">
                                <% } %>
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold mb-2"><%= relatedProduct.name %></h3>
                                <p class="text-gray-600 text-sm mb-2"><%= relatedProduct.description || 'Sản phẩm chất lượng cao' %></p>
                                <div class="flex justify-between items-center">
                                    <span class="text-lg font-bold text-indigo-600">
                                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(relatedProduct.price) %>
                                    </span>
                                    <a href="/product/<%= relatedProduct.id %>" class="bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700 transition">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>
    <% } %>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-12 mt-16">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">DDAWNG Store</h3>
                    <p class="text-gray-400">Thời trang cao cấp cho mọi phong cách</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Sản phẩm</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white transition">Váy nữ</a></li>
                        <li><a href="#" class="hover:text-white transition">Áo sơ mi</a></li>
                        <li><a href="#" class="hover:text-white transition">Quần</a></li>
                        <li><a href="#" class="hover:text-white transition">Phụ kiện</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Hỗ trợ</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white transition">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="hover:text-white transition">Chính sách đổi trả</a></li>
                        <li><a href="#" class="hover:text-white transition">Vận chuyển</a></li>
                        <li><a href="#" class="hover:text-white transition">Liên hệ</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Theo dõi chúng tôi</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400">
                <p>&copy; 2024 DDAWNG Store. Tất cả quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>
    
    <script>
        // Get product data from button attributes
        function getProductData(button) {
            return {
                id: parseInt(button.dataset.productId),
                name: button.dataset.productName,
                price: parseFloat(button.dataset.productPrice),
                stock: parseInt(button.dataset.productStock)
            };
        }
        
        // Add to cart function
        async function addToCart() {
            console.log('🛒 Add to cart button clicked');
            
            const button = event.target;
            const productData = getProductData(button);
            
            console.log('📊 Product data:', productData);
            console.log('👤 User logged in:', !!document.querySelector('.customer-info'));
            
            const quantity = parseInt(document.getElementById('quantity').value);
            console.log('📊 Quantity:', quantity);
            
            // Validate
            if (quantity < 1 || quantity > productData.stock) {
                alert('Số lượng không hợp lệ!');
                return;
            }
            
            console.log('🔍 Sending request to /cart/add');
            
            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        productId: productData.id,
                        quantity: quantity,
                        sizeId: selectedSize,
                        colorId: selectedColor
                    })
                });
                
                console.log('📡 Response status:', response.status);
                const result = await response.json();
                console.log('📦 Response result:', result);
                
                if (result.success) {
                    // Show success message
                    showNotification('Đã thêm "' + result.productName + '" vào giỏ hàng!', 'success');
                    
                    // Update cart count if exists
                    updateCartCount(result.cartCount);
                    
                    // Reset quantity
                    document.getElementById('quantity').value = 1;
                } else {
                    if (result.requiresLogin) {
                        // Show login modal or redirect
                        if (confirm('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng. Đăng nhập ngay?')) {
                            window.location.href = '/customer/login';
                        }
                    } else {
                        showNotification(result.message, 'error');
                    }
                }
            } catch (error) {
                console.error('❌ Error adding to cart:', error);
                showNotification('Lỗi khi thêm vào giỏ hàng', 'error');
            }
        }
        
        let selectedSize = null;
        let selectedColor = null;
        
        // Quantity controls
        function increaseQuantity() {
            const input = document.getElementById('quantity');
            const currentValue = parseInt(input.value);
            const button = document.querySelector('[data-product-stock]');
            const maxStock = parseInt(button.dataset.productStock);
            
            if (currentValue < maxStock) {
                input.value = currentValue + 1;
            } else {
                alert('Số lượng vượt quá số lượng trong kho!');
            }
        }
        
        function decreaseQuantity() {
            const input = document.getElementById('quantity');
            const currentValue = parseInt(input.value);
            if (currentValue > 1) {
                input.value = currentValue - 1;
            }
        }
        
        // Size selection
        document.querySelectorAll('button[class*="px-4 py-2 border"]').forEach(button => {
            if (button.textContent.trim().match(/^[SMLXL]+$/)) {
                button.addEventListener('click', function() {
                    // Remove previous selection
                    document.querySelectorAll('button[class*="px-4 py-2 border"]').forEach(btn => {
                        if (btn.textContent.trim().match(/^[SMLXL]+$/)) {
                            btn.classList.remove('border-indigo-500', 'bg-indigo-50', 'text-indigo-600');
                            btn.classList.add('border-gray-300');
                        }
                    });
                    
                    // Add selection to clicked button
                    this.classList.remove('border-gray-300');
                    this.classList.add('border-indigo-500', 'bg-indigo-50', 'text-indigo-600');
                    selectedSize = this.textContent.trim();
                });
            }
        });
        
        // Color selection
        document.querySelectorAll('button[class*="w-8 h-8 rounded-full"]').forEach(button => {
            button.addEventListener('click', function() {
                // Remove previous selection
                document.querySelectorAll('button[class*="w-8 h-8 rounded-full"]').forEach(btn => {
                    btn.classList.remove('border-indigo-500');
                    btn.classList.add('border-gray-300');
                });
                
                // Add selection to clicked button
                this.classList.remove('border-gray-300');
                this.classList.add('border-indigo-500');
                selectedColor = this.className.match(/bg-\w+-200/)[0];
            });
        });
        
        // Update cart count in header
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
                element.style.display = count > 0 ? 'inline' : 'none';
            });
        }
        
        // Show notification
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
                type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                'bg-blue-500 text-white'
            }`;
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.remove();
            }, 3000);
        }
        
        // Load cart count on page load
        async function loadCartCount() {
            try {
                const response = await fetch('/cart/count');
                const result = await response.json();
                updateCartCount(result.count);
            } catch (error) {
                console.error('Error loading cart count:', error);
            }
        }
        
        // Image change function
        function changeMainImage(imageUrl) {
            document.getElementById('mainImage').src = imageUrl;
        }
        
        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadCartCount();
        });
    </script>
</body>
</html>
