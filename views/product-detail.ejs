<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Breadcrumb -->
    <div class="container mx-auto px-4 py-4">
        <nav class="text-sm">
            <a href="/" class="text-gray-600 hover:text-indigo-600">Trang chủ</a>
            <span class="text-gray-400 mx-2">/</span>
            <a href="#" class="text-gray-600 hover:text-indigo-600">Sản phẩm</a>
            <span class="text-gray-400 mx-2">/</span>
            <span class="text-gray-800">Váy hoa nhí</span>
        </nav>
    </div>

    <!-- Product Detail -->
    <main class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <!-- Product Images -->
            <div class="space-y-4">
                <div class="bg-white rounded-lg shadow-md p-4">
                    <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden">
                        <% if (images && images.length> 0) { %>
                            <img src="<%= images[0].image_url %>" alt="<%= product.name %>"
                                class="w-full h-full object-cover" id="mainImage">
                            <% } else { %>
                                <img src="https://picsum.photos/seed/<%= product.id %>/600/600.jpg"
                                    alt="<%= product.name %>" class="w-full h-full object-cover" id="mainImage">
                                <% } %>
                    </div>
                </div>
                <div class="grid grid-cols-4 gap-2">
                    <% if (images && images.length> 0) { %>
                        <% images.forEach((image, index)=> { %>
                            <div class="bg-white rounded-lg shadow-md p-2 cursor-pointer <%= index === 0 ? 'border-2 border-indigo-500' : 'hover:border-2 hover:border-indigo-500' %> transition"
                                onclick="changeMainImage('<%= image.image_url %>')">
                                <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                                    <img src="<%= image.image_url %>" alt="<%= product.name %> <%= index + 1 %>"
                                        class="w-full h-full object-cover">
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div
                                        class="bg-white rounded-lg shadow-md p-2 cursor-pointer border-2 border-indigo-500">
                                        <div class="aspect-square bg-gray-100 rounded overflow-hidden">
                                            <img src="https://picsum.photos/seed/<%= product.id %>/600/600.jpg"
                                                alt="<%= product.name %>" class="w-full h-full object-cover">
                                        </div>
                                    </div>
                                    <% } %>
                </div>
            </div>

            <!-- Product Info -->
            <div class="space-y-6">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">
                        <%= product.name %>
                    </h1>
                    <% if (product.category_name) { %>
                        <div class="mb-2">
                            <span class="inline-block bg-indigo-100 text-indigo-800 text-sm px-3 py-1 rounded-full">
                                <%= product.category_name %>
                            </span>
                        </div>
                        <% } %>
                            <div class="flex items-center space-x-4 mb-4 cursor-pointer hover:opacity-80 transition" onclick="document.querySelector('[data-tab=\'reviews\']').click(); document.getElementById('productTabs').scrollIntoView({behavior: 'smooth'});">
                                <div class="flex text-yellow-400">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <svg class="w-5 h-5 <%= i <= Math.round(stats.avgRating) ? 'fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                                            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                                        </svg>
                                    <% } %>
                                </div>
                                <span class="text-gray-600">(<%= stats.avgRating.toFixed(1) %>/5.0 - <%= stats.reviewCount %> đánh giá)</span>
                                <span class="text-gray-300">|</span>
                                <span class="text-gray-600">Đã bán <%= product.sold_count || 0 %></span>
                            </div>
                            <div class="flex items-baseline space-x-2">
                                <span class="text-3xl font-bold text-indigo-600">
                                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency' , currency: 'VND'
                                        }).format(product.price) %>
                                </span>
                                <% if (product.stock_quantity> 0) { %>
                                    <span class="text-sm text-green-600">Còn hàng: <%= product.stock_quantity %></span>
                                    <% } else { %>
                                        <span class="text-sm text-red-600">Hết hàng</span>
                                        <% } %>
                            </div>
                </div>

                <div class="border-t border-b border-gray-200 py-4">
                    <h3 class="font-semibold mb-2">Mô tả sản phẩm</h3>
                    <p class="text-gray-600 leading-relaxed">
                        <%= product.description || 'Sản phẩm chất lượng cao, thiết kế hiện đại và phong cách.' %>
                    </p>
                </div>

                <% // Tính toán danh sách Size, Color duy nhất có available stock> 0
                    let availableSizes = [];
                    let availableColors = [];
                    let variantsData = [];
                    if (variants && variants.length > 0) {
                    variants.forEach(v => {
                    if (v.stock_quantity > 0) {
                    // Thêm size nếu chưa có
                    if (!availableSizes.find(s => s.id === v.size_id)) {
                    availableSizes.push({ id: v.size_id, name: v.size_name });
                    }
                    // Thêm color nếu chưa có
                    if (!availableColors.find(c => c.id === v.color_id)) {
                    availableColors.push({ id: v.color_id, name: v.color_name, hex: v.color_hex });
                    }
                    // Lưu mảng variants để dùng trong logic JS
                    variantsData.push({
                    id: v.id,
                    size_id: v.size_id,
                    color_id: v.color_id,
                    stock: v.stock_quantity,
                    price_adj: Number(v.price_adjustment) || 0
                    });
                    }
                    });
                    // Sắp xếp size theo tên để dễ nhìn hơn
                    availableSizes.sort((a,b) => a.name.localeCompare(b.name));
                    }
                    %>

                    <% if (variantsData.length> 0) { %>
                        <!-- Chọn Size -->
                        <div>
                            <h3 class="font-semibold mb-3">Chọn size <span id="sizeError"
                                    class="text-red-500 text-sm hidden font-normal ml-2">* Vui lòng chọn size</span>
                            </h3>
                            <div class="flex flex-wrap gap-2" id="sizeContainer">
                                <% availableSizes.forEach(size=> { %>
                                    <button
                                        class="size-btn px-4 py-2 border border-gray-300 rounded hover:border-indigo-500 transition disabled:opacity-50 disabled:cursor-not-allowed"
                                        data-id="<%= size.id %>">
                                        <%= size.name %>
                                    </button>
                                    <% }); %>
                            </div>
                            <div class="mt-2 text-sm text-gray-500" id="selectedVariantInfo">
                                <!-- Thông tin giá động / số lượng kho theo variant sẽ hiện ở đây -->
                            </div>
                        </div>

                        <!-- Chọn Màu Khác -->
                        <div>
                            <h3 class="font-semibold mb-3">Màu sắc <span id="colorError"
                                    class="text-red-500 text-sm hidden font-normal ml-2">* Vui lòng chọn màu</span></h3>
                            <div class="flex flex-wrap gap-2" id="colorContainer">
                                <% availableColors.forEach(color=> { %>
                                    <button
                                        class="color-btn w-8 h-8 rounded-full border-2 border-gray-300 hover:border-indigo-500 transition relative group disabled:opacity-20 disabled:cursor-not-allowed"
                                        style="background-color: <%= color.hex %>;" data-id="<%= color.id %>"
                                        title="<%= color.name %>">
                                    </button>
                                    <% }); %>
                            </div>
                        </div>
                        <% } else { %>
                            <div class="p-4 bg-yellow-50 text-yellow-800 rounded mb-4">
                                Sản phẩm hiện đang tạm hết hàng các tuỳ chọn kích thước / màu sắc.
                            </div>
                            <% } %>

                                <div class="space-y-4">
                                    <div class="flex space-x-4">
                                        <div class="flex items-center border border-gray-300 rounded">
                                            <button onclick="decreaseQuantity()"
                                                class="px-3 py-2 hover:bg-gray-100">-</button>
                                            <input type="number" id="quantity" value="1" min="1"
                                                class="w-16 text-center border-x border-gray-300 py-2">
                                            <button onclick="increaseQuantity()"
                                                class="px-3 py-2 hover:bg-gray-100">+</button>
                                        </div>
                                        <button onclick="addToCart(event)"
                                            class="flex-1 bg-indigo-600 text-white py-3 rounded-lg font-semibold hover:bg-indigo-700 transition"
                                            data-product-id="<%= product.id %>" data-product-name="<%= product.name %>"
                                            data-product-price="<%= product.price %>"
                                            data-product-stock="<%= product.stock_quantity %>">
                                            Thêm vào giỏ hàng
                                        </button>
                                    </div>
                                    <button onclick="buyNow(event)"
                                        class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition">
                                        Mua ngay
                                    </button>
                                </div>

                                <div class="border-t border-gray-200 pt-4">
                                    <div class="grid grid-cols-2 gap-4 text-sm">
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="text-gray-600">Miễn phí vận chuyển</span>
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="text-gray-600">Đổi trả trong 7 ngày</span>
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="text-gray-600">Hàng chính hãng</span>
                                        </div>
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span class="text-gray-600">Hotline hỗ trợ</span>
                                        </div>
                                    </div>
                                </div>
            </div>
        </div>

        <!-- Product Details Tabs -->
        <div class="mt-16">
            <div class="border-b border-gray-200">
                <nav class="flex space-x-8" id="productTabs">
                    <button class="tab-btn py-2 border-b-2 border-indigo-500 text-indigo-600 font-semibold" data-tab="details">Chi tiết sản phẩm</button>
                    <button class="tab-btn py-2 border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="reviews">Đánh giá (<%= stats.reviewCount %>)</button>
                    <button class="tab-btn py-2 border-b-2 border-transparent text-gray-600 hover:text-gray-800" data-tab="care">Hướng dẫn chăm sóc</button>
                </nav>
            </div>
            
            <div id="tabContent" class="py-8">
                <!-- Details Tab -->
                <div id="detailsTab" class="tab-pane">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <h3 class="font-semibold mb-4">Thông tin sản phẩm</h3>
                            <table class="w-full text-sm">
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Chất liệu</td>
                                    <td class="py-2">Lụa tơ tự nhiên</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Xuất xứ</td>
                                    <td class="py-2">Việt Nam</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Thương hiệu</td>
                                    <td class="py-2">DDAWNG</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-2 text-gray-600">Mùa</td>
                                    <td class="py-2">Xuân, Hè</td>
                                </tr>
                            </table>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-4">Hướng dẫn chọn size</h3>
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b">
                                        <th class="py-2 text-left">Size</th>
                                        <th class="py-2 text-center">S</th>
                                        <th class="py-2 text-center">M</th>
                                        <th class="py-2 text-center">L</th>
                                        <th class="py-2 text-center">XL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="border-b">
                                        <td class="py-2 text-gray-600">Vòng ngực (cm)</td>
                                        <td class="py-2 text-center">84</td>
                                        <td class="py-2 text-center">88</td>
                                        <td class="py-2 text-center">92</td>
                                        <td class="py-2 text-center">96</td>
                                    </tr>
                                    <tr class="border-b">
                                        <td class="py-2 text-gray-600">Vòng eo (cm)</td>
                                        <td class="py-2 text-center">64</td>
                                        <td class="py-2 text-center">68</td>
                                        <td class="py-2 text-center">72</td>
                                        <td class="py-2 text-center">76</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Reviews Tab -->
                <div id="reviewsTab" class="tab-pane hidden">
                    <div class="space-y-8">
                        <div class="flex items-start justify-between">
                            <div>
                                <h3 class="text-2xl font-bold text-gray-900 mb-2">Đánh giá từ khách hàng</h3>
                                <div class="flex items-center space-x-4">
                                    <div class="flex text-yellow-400">
                                        <% for(let i = 1; i <= 5; i++) { %>
                                            <svg class="w-6 h-6 <%= i <= Math.round(stats.avgRating) ? 'fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                                                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                                            </svg>
                                        <% } %>
                                    </div>
                                    <span class="text-xl font-semibold"><%= stats.avgRating.toFixed(1) %> / 5.0</span>
                                    <span class="text-gray-500">(<%= stats.reviewCount %> đánh giá)</span>
                                </div>
                            </div>
                        </div>

                        <% if (reviews && reviews.length > 0) { %>
                            <div class="divide-y divide-gray-200">
                                <% reviews.forEach(review => { %>
                                    <div class="py-6">
                                        <div class="flex items-start space-x-4">
                                            <div class="flex-shrink-0">
                                                <img src="<%= review.user_avatar || '/images/avatardefault.jpg' %>" alt="Avatar" class="w-12 h-12 rounded-full border border-gray-200">
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex items-center justify-between mb-1">
                                                    <h4 class="font-bold text-gray-900"><%= review.user_name || 'Khách hàng' %></h4>
                                                    <span class="text-sm text-gray-500"><%= new Date(review.created_at).toLocaleDateString('vi-VN') %></span>
                                                </div>
                                                <div class="flex text-yellow-400 mb-2">
                                                    <% for(let i = 1; i <= 5; i++) { %>
                                                        <svg class="w-4 h-4 <%= i <= review.rating ? 'fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                                                            <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                                                        </svg>
                                                    <% } %>
                                                    <% if (review.is_verified) { %>
                                                        <span class="ml-2 inline-flex items-center text-green-600 text-xs font-medium">
                                                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                                            </svg>
                                                            Đã mua hàng
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <% if (review.title) { %>
                                                    <h5 class="font-semibold text-gray-800 mb-1"><%= review.title %></h5>
                                                <% } %>
                                                <p class="text-gray-600"><%= review.content %></p>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12 bg-gray-50 rounded-lg">
                                <p class="text-gray-500">Chưa có đánh giá nào cho sản phẩm này.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Care Tab -->
                <div id="careTab" class="tab-pane hidden">
                    <div class="prose prose-sm max-w-none text-gray-600">
                        <ul class="list-disc pl-5 space-y-2">
                            <li>Giặt tay bằng nước lạnh để giữ độ bền cho sản phẩm.</li>
                            <li>Không sử dụng chất tẩy mạnh.</li>
                            <li>Phơi trong bóng mát, tránh ánh nắng trực tiếp.</li>
                            <li>Ủi ở nhiệt độ thấp hoặc sử dụng bàn ủi hơi nước.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length> 0) { %>
        <section class="py-16 bg-gray-50">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center mb-12">Sản phẩm liên quan</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <% relatedProducts.forEach(relatedProduct=> { %>
                        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
                            <div class="h-64 bg-gray-200 flex items-center justify-center">
                                <% if (relatedProduct.image_url) { %>
                                    <img src="<%= relatedProduct.image_url %>" alt="<%= relatedProduct.name %>"
                                        class="w-full h-full object-cover">
                                    <% } else { %>
                                        <img src="https://picsum.photos/seed/<%= relatedProduct.id %>/400/500.jpg"
                                            alt="<%= relatedProduct.name %>" class="w-full h-full object-cover">
                                        <% } %>
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold mb-2">
                                    <%= relatedProduct.name %>
                                </h3>
                                <div class="flex items-center text-sm text-yellow-500 mb-2">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                    <span class="ml-1 text-gray-700 font-medium"><%= parseFloat(relatedProduct.avg_rating || 0).toFixed(1) %></span>
                                    <span class="mx-2 text-gray-300">|</span>
                                    <span class="text-gray-500 text-xs">Đã bán <%= relatedProduct.sold_count || 0 %></span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-lg font-bold text-indigo-600">
                                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency' , currency: 'VND'
                                            }).format(relatedProduct.price) %>
                                    </span>
                                    <a href="/product/<%= relatedProduct.id %>"
                                        class="bg-indigo-600 text-white px-3 py-1 rounded hover:bg-indigo-700 transition">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </div>
        </section>
        <% } %>

            <!-- Footer -->
            <footer class="bg-gray-800 text-white py-12 mt-16">
                <div class="container mx-auto px-4">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                        <div>
                            <h3 class="text-xl font-bold mb-4">DDAWNG Store</h3>
                            <p class="text-gray-400">Thời trang cao cấp cho mọi phong cách</p>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-4">Sản phẩm</h4>
                            <ul class="space-y-2 text-gray-400">
                                <li><a href="#" class="hover:text-white transition">Váy nữ</a></li>
                                <li><a href="#" class="hover:text-white transition">Áo sơ mi</a></li>
                                <li><a href="#" class="hover:text-white transition">Quần</a></li>
                                <li><a href="#" class="hover:text-white transition">Phụ kiện</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-4">Hỗ trợ</h4>
                            <ul class="space-y-2 text-gray-400">
                                <li><a href="#" class="hover:text-white transition">Hướng dẫn mua hàng</a></li>
                                <li><a href="#" class="hover:text-white transition">Chính sách đổi trả</a></li>
                                <li><a href="#" class="hover:text-white transition">Vận chuyển</a></li>
                                <li><a href="#" class="hover:text-white transition">Liên hệ</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="font-semibold mb-4">Theo dõi chúng tôi</h4>
                            <div class="flex space-x-4">
                                <a href="#" class="text-gray-400 hover:text-white transition">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                                    </svg>
                                </a>
                                <a href="#" class="text-gray-400 hover:text-white transition">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                                    </svg>
                                </a>
                                <a href="#" class="text-gray-400 hover:text-white transition">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400">
                        <p>&copy; 2024 DDAWNG Store. Tất cả quyền được bảo lưu.</p>
                    </div>
                </div>
            </footer>

            <script>
                // Get product data from button attributes
                function getProductData(button) {
                    return {
                        id: parseInt(button.dataset.productId),
                        name: button.dataset.productName,
                        price: parseFloat(button.dataset.productPrice),
                        stock: parseInt(button.dataset.productStock)
                    };
                }

                // Add to cart function
                const productVariants = JSON.parse(`<%- JSON.stringify(typeof variantsData !== 'undefined' ? variantsData : []) %>`);
                const basePrice = Number(`<%- product.price %>`) || 0;
                let selectedSizeId = null;
                let selectedColorId = null;
                let currentVariant = null;

                // Định dạng tiền tệ
                const formatCurrency = (amount) => {
                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
                };

                // Cập nhật lại UI dựa trên lựa chọn
                function updateVariantUI() {
                    // Xóa hết trạng thái không khả dụng (disabled) ban đầu
                    document.querySelectorAll('.size-btn').forEach(btn => btn.disabled = false);
                    document.querySelectorAll('.color-btn').forEach(btn => btn.disabled = false);

                    // Xóa highlight lỗi nếu có thay đổi
                    document.getElementById('sizeError')?.classList.add('hidden');
                    document.getElementById('colorError')?.classList.add('hidden');

                    // Nếu đã chọn một cái gì đó, cần disabled những option chéo không thuộc variant hợp lệ
                    if (selectedSizeId) {
                        // Liệt kê các color đi kèm size này (và còn hàng)
                        const availableColorIds = productVariants.filter(v => v.size_id == selectedSizeId && v.stock > 0).map(v => parseInt(v.color_id));
                        document.querySelectorAll('.color-btn').forEach(btn => {
                            const cId = parseInt(btn.dataset.id);
                            if (!availableColorIds.includes(cId)) {
                                btn.disabled = true;
                                // Nếu đang chọn đúng color bị mờ, thì bỏ chọn
                                if (selectedColorId == cId) {
                                    selectedColorId = null;
                                    btn.classList.remove('border-indigo-500', 'ring-2', 'ring-indigo-300');
                                    btn.classList.add('border-gray-300');
                                }
                            }
                        });
                    }

                    if (selectedColorId) {
                        // Liệt kê các size đi kèm color này
                        const availableSizeIds = productVariants.filter(v => v.color_id == selectedColorId && v.stock > 0).map(v => parseInt(v.size_id));
                        document.querySelectorAll('.size-btn').forEach(btn => {
                            const sId = parseInt(btn.dataset.id);
                            if (!availableSizeIds.includes(sId)) {
                                btn.disabled = true;
                                if (selectedSizeId == sId) {
                                    selectedSizeId = null;
                                    btn.classList.remove('border-indigo-500', 'bg-indigo-50', 'text-indigo-600');
                                }
                            }
                        });
                    }

                    // Gán lại selected class
                    document.querySelectorAll('.size-btn').forEach(btn => {
                        if (parseInt(btn.dataset.id) == selectedSizeId) {
                            btn.classList.add('border-indigo-500', 'bg-indigo-50', 'text-indigo-600');
                            btn.classList.remove('border-gray-300');
                        } else {
                            btn.classList.remove('border-indigo-500', 'bg-indigo-50', 'text-indigo-600');
                            if (!btn.disabled) btn.classList.add('border-gray-300');
                        }
                    });

                    document.querySelectorAll('.color-btn').forEach(btn => {
                        if (parseInt(btn.dataset.id) == selectedColorId) {
                            btn.classList.add('border-indigo-500', 'ring-2', 'ring-indigo-300');
                            btn.classList.remove('border-gray-300');
                        } else {
                            btn.classList.remove('border-indigo-500', 'ring-2', 'ring-indigo-300');
                            if (!btn.disabled) btn.classList.add('border-gray-300');
                        }
                    });

                    // Nếu đủ màu và kích cỡ, tìm variant và cập nhật giá/tồn kho
                    currentVariant = null;
                    const infoDiv = document.getElementById('selectedVariantInfo');
                    const priceEl = document.querySelector('.text-3xl.font-bold.text-indigo-600');
                    const stockEl = document.querySelector('.text-sm.text-green-600');

                    if (selectedSizeId && selectedColorId) {
                        currentVariant = productVariants.find(v => v.size_id == selectedSizeId && v.color_id == selectedColorId);

                        if (currentVariant) {
                            let finalPrice = basePrice + currentVariant.price_adj;
                            if (priceEl) priceEl.textContent = formatCurrency(finalPrice);
                            if (stockEl) stockEl.textContent = 'Còn hàng: ' + currentVariant.stock;

                            if (infoDiv) infoDiv.innerHTML = `<span class="text-indigo-600 font-medium whitespace-nowrap"><i class="fas fa-check"></i> Có sẵn ${currentVariant.stock} sản phẩm</span>`;

                            // Reset quantity input theo max
                            const maxStock = parseInt(currentVariant.stock);
                            const qInput = document.getElementById('quantity');
                            qInput.setAttribute('max', maxStock);
                            if (parseInt(qInput.value) > maxStock) qInput.value = maxStock;
                        }
                    } else {
                        if (infoDiv) infoDiv.innerHTML = '';
                    }
                }

                // Size selection event
                document.querySelectorAll('.size-btn').forEach(button => {
                    button.addEventListener('click', function (e) {
                        if (this.disabled) return;

                        const cId = parseInt(this.dataset.id);
                        // Toggle chọn/hủy
                        selectedSizeId = (selectedSizeId === cId) ? null : cId;
                        updateVariantUI();
                    });
                });

                // Color selection event
                document.querySelectorAll('.color-btn').forEach(button => {
                    button.addEventListener('click', function (e) {
                        if (this.disabled) return;

                        const cId = parseInt(this.dataset.id);
                        selectedColorId = (selectedColorId === cId) ? null : cId;
                        updateVariantUI();
                    });
                });

                // Setup add to cart with variants constraint
                async function addToCart(e) {
                    // Ràng buộc chọn biến thể (nếu SP bắt buộc có - mảng productVariants > 0)
                    if (productVariants.length > 0) {
                        let isValid = true;
                        if (!selectedSizeId) {
                            document.getElementById('sizeError').classList.remove('hidden');
                            isValid = false;
                        }
                        if (!selectedColorId) {
                            document.getElementById('colorError').classList.remove('hidden');
                            isValid = false;
                        }
                        if (!isValid || !currentVariant) return;
                    }

                    console.log('🛒 Add to cart button clicked');
                    const button = (e && e.currentTarget) ? e.currentTarget : document.querySelector('button[onclick*="addToCart"]');
                    const productData = getProductData(button);

                    const quantity = parseInt(document.getElementById('quantity').value);
                    const stockToCompare = currentVariant ? currentVariant.stock : productData.stock;

                    if (quantity < 1 || quantity > stockToCompare) {
                        alert('Số lượng không hợp lệ! Chỉ còn ' + stockToCompare + ' sản phẩm trong kho.');
                        return;
                    }

                    try {
                        // Disable button
                        button.disabled = true;
                        button.innerHTML = '<span class="animate-pulse">Đang thêm...</span>';

                        const response = await fetch('/cart/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                productId: productData.id,
                                quantity: quantity,
                                variantId: currentVariant ? currentVariant.id : null,
                                // Gui luon cho tuong thich code API cu nếu có
                                sizeId: selectedSizeId,
                                colorId: selectedColorId
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            // Cập nhật thông báo trực tiếp
                            showNotification('Đã thêm "' + result.productName + '" vào giỏ hàng!', 'success');
                            updateCartCount(result.cartCount);
                            document.getElementById('quantity').value = 1;
                        } else {
                            if (result.requiresLogin) {
                                if (confirm('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng. Đăng nhập ngay?')) {
                                    window.location.href = '/customer/login';
                                }
                            } else {
                                showNotification(result.message, 'error');
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error adding to cart:', error);
                        // Redirect nếu buy now lỗi cũng có thể do timeout, chỉ hiện thông báo
                        showNotification('Lỗi khi thao tác', 'error');
                    } finally {
                        button.disabled = false;
                        button.innerHTML = 'Thêm vào giỏ hàng';
                    }
                }

                // Buy Now Button action
                async function buyNow(e) {
                    console.log('⚡ Buy Now clicked');
                    // Nút Mua Ngay không có data-product-*, phải lấy từ nút addToCart
                    const dataBtn = document.querySelector('button[onclick*="addToCart"]');
                    const buyBtn = (e && e.currentTarget) ? e.currentTarget : document.querySelector('button[onclick*="buyNow"]');

                    // Validate variant giống `addToCart`
                    if (productVariants.length > 0) {
                        let isValid = true;
                        if (!selectedSizeId) {
                            document.getElementById('sizeError').classList.remove('hidden');
                            isValid = false;
                        }
                        if (!selectedColorId) {
                            document.getElementById('colorError').classList.remove('hidden');
                            isValid = false;
                        }
                        if (!isValid || !currentVariant) return;
                    }

                    const quantity = parseInt(document.getElementById('quantity').value);
                    const productData = getProductData(dataBtn);
                    const stockToCompare = currentVariant ? currentVariant.stock : productData.stock;

                    if (quantity < 1 || quantity > stockToCompare) {
                        alert('Số lượng không hợp lệ! Chỉ còn ' + stockToCompare + ' sản phẩm trong kho.');
                        return;
                    }

                    try {
                        // Disable Nút Mua ngay
                        if (buyBtn) {
                            buyBtn.disabled = true;
                            buyBtn.innerHTML = '<span class="animate-pulse">Đang chuyển hướng...</span>';
                        }

                        // Gửi request
                        const response = await fetch('/cart/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                productId: productData.id,
                                quantity: quantity,
                                variantId: currentVariant ? currentVariant.id : null,
                                sizeId: selectedSizeId,
                                colorId: selectedColorId
                            })
                        });
                        const result = await response.json();

                        if (result.success) {
                            window.location.href = '/cart';
                        } else {
                            if (buyBtn) {
                                buyBtn.disabled = false;
                                buyBtn.innerHTML = 'Mua ngay';
                            }
                            if (result.requiresLogin) {
                                if (confirm('Vui lòng đăng nhập để mua sản phẩm. Đăng nhập ngay?')) {
                                    window.location.href = '/customer/login';
                                }
                            } else {
                                showNotification(result.message, 'error');
                            }
                        }
                    } catch (error) {
                        console.error('❌ Error Buy Now:', error);
                        showNotification('Lỗi khi thao tác', 'error');
                        if (buyBtn) {
                            buyBtn.disabled = false;
                            buyBtn.innerHTML = 'Mua ngay';
                        }
                    }
                }

                // Tab switching logic
                const tabBtns = document.querySelectorAll('.tab-btn');
                const tabPanes = document.querySelectorAll('.tab-pane');

                tabBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const tabId = btn.getAttribute('data-tab');

                        // Update buttons
                        tabBtns.forEach(b => {
                            b.classList.remove('border-indigo-500', 'text-indigo-600', 'font-semibold');
                            b.classList.add('border-transparent', 'text-gray-600');
                        });
                        btn.classList.add('border-indigo-500', 'text-indigo-600', 'font-semibold');
                        btn.classList.remove('border-transparent', 'text-gray-600');

                        // Update panes
                        tabPanes.forEach(pane => pane.classList.add('hidden'));
                        document.getElementById(`${tabId}Tab`).classList.remove('hidden');
                    });
                });

                // Quantity controls
                function increaseQuantity() {
                    const input = document.getElementById('quantity');
                    const currentValue = parseInt(input.value);

                    // Tìm limit dựa trên variant đang chọn hoặc stock mặc định
                    let maxStock = 1;
                    if (productVariants && productVariants.length > 0) {
                        if (currentVariant) {
                            maxStock = parseInt(currentVariant.stock);
                        } else {
                            maxStock = 0; // if hasn't selected variant, forbid increasing blindly
                        }
                    } else {
                        const button = document.querySelector('[data-product-stock]');
                        maxStock = parseInt(button.dataset.productStock);
                    }

                    if (currentValue < maxStock) {
                        input.value = currentValue + 1;
                    } else {
                        alert('Số lượng lựa chọn đạt tối đa!');
                    }
                }

                function decreaseQuantity() {
                    const input = document.getElementById('quantity');
                    const currentValue = parseInt(input.value);
                    if (currentValue > 1) {
                        input.value = currentValue - 1;
                    }
                }

                // Update cart count in header
                function updateCartCount(count) {
                    const cartCountElements = document.querySelectorAll('.cart-count');
                    cartCountElements.forEach(element => {
                        element.textContent = count;
                        element.style.display = count > 0 ? 'inline' : 'none';
                    });
                }

                // Show notification
                function showNotification(message, type = 'info') {
                    const notification = document.createElement('div');
                    notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${type === 'success' ? 'bg-green-500 text-white' :
                        type === 'error' ? 'bg-red-500 text-white' :
                            'bg-blue-500 text-white'
                        }`;
                    notification.textContent = message;

                    document.body.appendChild(notification);

                    setTimeout(() => {
                        notification.remove();
                    }, 3000);
                }

                // Load cart count on page load
                async function loadCartCount() {
                    try {
                        const response = await fetch('/cart/count');
                        const result = await response.json();
                        updateCartCount(result.count);
                    } catch (error) {
                        console.error('Error loading cart count:', error);
                    }
                }

                // Image change function
                function changeMainImage(imageUrl) {
                    document.getElementById('mainImage').src = imageUrl;
                }

                // Initialize
                document.addEventListener('DOMContentLoaded', function () {
                    loadCartCount();
                });
            </script>
</body>

</html>