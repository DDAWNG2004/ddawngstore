<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DDAWNG Store - Thời trang cao cấp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Banner Carousel -->
    <section class="relative h-[500px] overflow-hidden group" id="banner-carousel">
        <!-- Slide 1: General Promotion -->
        <div class="carousel-item absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100 z-10 bg-gradient-to-r from-indigo-500 to-purple-600">
            <div class="absolute inset-0 bg-black opacity-40"></div>
            <!-- Background Image -->
            <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&q=80&w=2070" class="absolute inset-0 w-full h-full object-cover mix-blend-overlay" alt="Summer Collection">
            <div class="relative container mx-auto px-4 h-full flex items-center">
                <div class="text-white max-w-2xl transform translate-y-0 transition-transform duration-1000">
                    <span class="inline-block px-3 py-1 bg-indigo-500 text-white text-sm font-semibold rounded-full mb-4 shadow-lg border border-indigo-400/50">MỚI NHẤT MÙA HÈ 2024</span>
                    <h2 class="text-5xl font-bold mb-4 leading-tight drop-shadow-md">Bộ sưu tập thời trang<br>hàng đầu</h2>
                    <p class="text-xl mb-8 opacity-90 drop-shadow-sm">Khám phá những thiết kế thời trang đẳng cấp, mang lại sự thoải mái và phong cách vượt trội cho mọi vóc dáng</p>
                    <button onclick="window.scrollTo({top: document.getElementById('categories')?.offsetTop || 500, behavior: 'smooth'})" class="inline-block bg-white text-indigo-600 px-8 py-3 rounded-full font-bold hover:bg-gray-100 transition shadow-lg transform hover:-translate-y-1">
                        Khám phá ngay
                    </button>
                </div>
            </div>
        </div>

        <!-- Slide 2: Hot Product -->
        <% 
            let hotProduct = null;
            if (products && products.length > 0) {
                hotProduct = products[0]; // Sản phẩm hot là sản phẩm đầu tiên
            }
        %>
        <div class="carousel-item absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 z-0 bg-gradient-to-r from-teal-500 to-emerald-600">
            <div class="absolute inset-0 bg-black opacity-50"></div>
            <% if (hotProduct && hotProduct.image_url) { %>
                <img src="<%= hotProduct.image_url %>" class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-30 blur-sm" alt="Hot Product">
            <% } else { %>
                <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&q=80&w=1962" class="absolute inset-0 w-full h-full object-cover mix-blend-overlay" alt="Hot Product Default">
            <% } %>
            
            <div class="relative container mx-auto px-4 h-full flex items-center justify-between">
                <div class="text-white max-w-xl">
                    <div class="inline-flex items-center space-x-2 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold mb-4 animate-pulse shadow-md">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.361 2.014.568.712 1.056 1.322 1.056 3a3 3 0 01-.105.815z" clip-rule="evenodd"></path></svg>
                        <span>SẢN PHẨM HOT</span>
                    </div>
                    <% if (hotProduct) { %>
                        <h2 class="text-5xl font-bold mb-2 leading-tight drop-shadow-lg"><%= hotProduct.name %></h2>
                        <div class="flex flex-wrap items-center gap-4 mb-8 mt-4">
                            <span class="text-3xl font-bold text-yellow-300 drop-shadow-md">
                                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(hotProduct.price) %>
                            </span>
                            <div class="flex items-center bg-black/40 px-3 py-1 rounded-full backdrop-blur-sm border border-white/10">
                                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                <span class="ml-1 text-white font-medium"><%= parseFloat(hotProduct.avg_rating || 5.0).toFixed(1) %></span>
                                <span class="mx-2 text-white/50">|</span>
                                <span class="text-white text-sm">Đã bán <%= hotProduct.sold_count || 120 %></span>
                            </div>
                        </div>
                        <button onclick="buyNowFromBanner(this)" 
                            data-product-id="<%= hotProduct.id %>"
                            data-product-name="<%= hotProduct.name %>"
                            data-product-price="<%= hotProduct.price %>"
                            class="group relative inline-flex items-center justify-center px-8 py-4 font-bold text-white transition-all duration-200 bg-red-600 rounded-xl hover:bg-red-500 hover:shadow-[0_0_20px_rgba(239,68,68,0.5)] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 shadow-xl overflow-hidden transform hover:-translate-y-1">
                            <span class="mr-2 relative z-10 text-lg">Mua Ngay</span>
                            <svg class="w-6 h-6 relative z-10 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </button>
                    <% } else { %>
                        <h2 class="text-5xl font-bold mb-4 leading-tight">Sản phẩm nổi bật</h2>
                        <p class="text-2xl font-bold text-yellow-300 mb-8">Click để khám phá ngay sản phẩm mới nhất</p>
                        <button onclick="window.scrollTo({top: 800, behavior: 'smooth'})" class="bg-red-500 text-white px-8 py-3 rounded-full font-bold hover:bg-red-600 transition shadow-lg shadow-red-500/50">
                            Mua Ngay
                        </button>
                    <% } %>
                </div>
                
                <% if (hotProduct && hotProduct.image_url) { %>
                <div class="hidden md:block w-1/3 h-[350px] relative transform rotate-[-2deg] hover:rotate-0 transition-all duration-500 hover:scale-105">
                    <div class="absolute inset-0 bg-gradient-to-tr from-white/40 to-white/10 rounded-2xl shadow-2xl transform translate-x-4 translate-y-4 backdrop-blur-sm z-0 border border-white/20"></div>
                    <img src="<%= hotProduct.image_url %>" class="absolute inset-0 w-full h-full object-cover rounded-2xl shadow-xl z-10 border border-white/10" alt="<%= hotProduct.name %>" style="box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.3);">
                </div>
                <% } %>
            </div>
        </div>

        <!-- Slide 3: Office Fashion -->
        <div class="carousel-item absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 z-0 bg-gradient-to-r from-gray-800 to-black">
            <div class="absolute inset-0 bg-black opacity-40"></div>
            <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&q=80&w=2070" class="absolute inset-0 w-full h-full object-cover mix-blend-overlay" alt="Office Fashion">
            <div class="relative container mx-auto px-4 h-full flex items-center justify-end">
                <div class="text-white max-w-xl text-right">
                    <h2 class="text-5xl font-bold mb-4 leading-tight drop-shadow-md">Thời trang công sở<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-100 to-yellow-400 drop-shadow-sm">Thanh Lịch</span></h2>
                    <p class="text-xl mb-8 opacity-90 drop-shadow-sm">Phong cách chuyên nghiệp, tự tin tỏa sáng nơi công sở với những thiết kế tinh tế nhất năm nay.</p>
                    <button onclick="window.scrollTo({top: 800, behavior: 'smooth'})" class="inline-block border-2 border-white bg-transparent text-white px-8 py-3 rounded-full font-bold hover:bg-white hover:text-gray-900 transition-all duration-300 shadow-xl backdrop-blur-sm">
                        Xem Bộ Sưu Tập
                    </button>
                </div>
            </div>
        </div>

        <!-- Carousel Navigation Controls -->
        <!-- Prev/Next buttons -->
        <button onclick="prevSlide()" class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black/30 hover:bg-white text-white hover:text-black p-3 rounded-full backdrop-blur-sm transition-all duration-300 opacity-0 group-hover:opacity-100 focus:outline-none z-20 border border-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button onclick="nextSlide()" class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black/30 hover:bg-white text-white hover:text-black p-3 rounded-full backdrop-blur-sm transition-all duration-300 opacity-0 group-hover:opacity-100 focus:outline-none z-20 border border-white/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>

        <!-- Indicators -->
        <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-3 z-20">
            <button onclick="goToSlide(0)" class="carousel-dot w-12 h-1.5 rounded-full bg-white transition-all duration-300 shadow-md box-content border border-black/10" aria-label="Slide 1"></button>
            <button onclick="goToSlide(1)" class="carousel-dot w-12 h-1.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300 shadow-md box-content border border-black/10" aria-label="Slide 2"></button>
            <button onclick="goToSlide(2)" class="carousel-dot w-12 h-1.5 rounded-full bg-white/40 hover:bg-white/70 transition-all duration-300 shadow-md box-content border border-black/10" aria-label="Slide 3"></button>
        </div>
    </section>

    <!-- Categories -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12">Danh mục sản phẩm</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <% if (categories && categories.length> 0) { %>
                    <% categories.forEach((category, index)=> {
                        // Bộ Style Map cho danh mục
                        let icon = '🛍️';
                        let bgClass = 'from-gray-100 to-gray-200';

                        const lowerName = category.name.toLowerCase();
                        if (lowerName.includes('váy') || lowerName.includes('dress')) {
                        icon = '👗';
                        bgClass = 'from-pink-100 to-pink-200';
                        } else if (lowerName.includes('áo') || lowerName.includes('shirt')) {
                        icon = '👔';
                        bgClass = 'from-blue-100 to-blue-200';
                        } else if (lowerName.includes('quần') || lowerName.includes('pant')) {
                        icon = '👖';
                        bgClass = 'from-green-100 to-green-200';
                        } else if (lowerName.includes('phụ kiện') || lowerName.includes('access')) {
                        icon = '👜';
                        bgClass = 'from-yellow-100 to-yellow-200';
                        } else {
                        // Màu mặc định luân phiên ngẫu nhiên
                        const colors = [
                        'from-indigo-100 to-purple-200',
                        'from-red-100 to-orange-200',
                        'from-teal-100 to-cyan-200'
                        ];
                        bgClass = colors[index % colors.length];
                        }
                        %>
                        <div onclick="filterByCategory('<%= category.id %>')"
                            class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                            <div class="h-48 bg-gradient-to-br <%= bgClass %> flex items-center justify-center">
                                <span class="text-6xl">
                                    <%= icon %>
                                </span>
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-semibold mb-2">
                                    <%= category.name %>
                                </h3>
                                <p class="text-gray-600">
                                    <%= category.description || 'Khám phá ngay' %>
                                </p>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <!-- Fallback categories if no data -->
                                <div
                                    class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                                    <div
                                        class="h-48 bg-gradient-to-br from-pink-100 to-pink-200 flex items-center justify-center">
                                        <span class="text-6xl">👗</span>
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-xl font-semibold mb-2">Váy</h3>
                                        <p class="text-gray-600">Thiết kế thanh lịch</p>
                                    </div>
                                </div>
                                <div
                                    class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                                    <div
                                        class="h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
                                        <span class="text-6xl">👔</span>
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-xl font-semibold mb-2">Áo sơ mi</h3>
                                        <p class="text-gray-600">Phong cách công sở và thời trang</p>
                                    </div>
                                </div>
                                <div
                                    class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                                    <div
                                        class="h-48 bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
                                        <span class="text-6xl">👖</span>
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-xl font-semibold mb-2">Quần</h3>
                                        <p class="text-gray-600">Thoải mái và đa dạng kiểu dáng</p>
                                    </div>
                                </div>
                                <% } %>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <% if (currentCategory) { %>
                <div class="mb-6 text-center">
                    <p class="text-lg text-gray-600">
                        Đang hiển thị sản phẩm theo danh mục
                        <button onclick="clearCategoryFilter()"
                            class="ml-2 text-indigo-600 hover:text-indigo-800 underline">
                            Xem tất cả sản phẩm
                        </button>
                    </p>
                </div>
                <% } %>
                    <h2 class="text-3xl font-bold text-center mb-12">Sản phẩm nổi bật</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                        <% if (products && products.length> 0) { %>
                            <% products.forEach((product, index) => { %>
                                <a href="/product/<%= product.id %>"
                                    class="product-item block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 cursor-pointer group <%= index >= 8 ? 'hidden extra-product' : '' %>">
                                    <div class="h-80 bg-gray-50 flex items-center justify-center overflow-hidden relative">
                                        <% if (product.image_url) { %>
                                            <img src="<%= product.image_url %>" alt="<%= product.name %>"
                                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                            <% } else { %>
                                                <img src="https://picsum.photos/seed/<%= product.id %>/400/500.jpg"
                                                    alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                                <% } %>
                                    </div>
                                    <div class="p-4">
                                        <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">
                                            <%= product.name %>
                                        </h3>
                                        <div class="flex items-center text-sm text-yellow-500 mb-2">
                                            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                            <span class="ml-1 text-gray-700 font-medium"><%= parseFloat(product.avg_rating || 0).toFixed(1) %></span>
                                            <span class="mx-2 text-gray-300">|</span>
                                            <span class="text-gray-500 text-xs">Đã bán <%= product.sold_count || 0 %></span>
                                        </div>
                                        <% if (product.category_name) { %>
                                            <span
                                                class="inline-block bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded mb-2">
                                                <%= product.category_name %>
                                            </span>
                                            <% } %>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-lg font-bold text-indigo-600">
                                                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency' ,
                                                            currency: 'VND' }).format(product.price) %>
                                                    </span>
                                                </div>
                                    </div>
                                </a>
                                <% }); %>
                    </div>
                    <% if (products && products.length > 8) { %>
                    <div class="text-center mt-12" id="showMoreContainer">
                        <button onclick="showMoreProducts()" class="px-8 py-3 bg-white border-2 border-indigo-600 text-indigo-600 font-bold rounded-full hover:bg-indigo-600 hover:text-white transition-colors duration-300 shadow-sm hover:shadow-indigo-200 focus:outline-none">
                            Hiển thị thêm sản phẩm
                        </button>
                    </div>
                    <% } %>
                                    <% } else { %>
                                        <!-- Fallback products if no data -->
                                        <a href="/product/1"
                                            class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                                            <div class="h-64 bg-gray-200 flex items-center justify-center">
                                                <img src="https://picsum.photos/seed/product1/400/500.jpg"
                                                    alt="Sản phẩm 1" class="w-full h-full object-cover">
                                            </div>
                                            <div class="p-4">
                                                <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Váy hoa
                                                    nhí</h3>
                                                <div class="flex items-center text-sm text-yellow-500 mb-2">
                                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                                    <span class="ml-1 text-gray-700 font-medium">5.0</span>
                                                    <span class="mx-2 text-gray-300">|</span>
                                                    <span class="text-gray-500 text-xs">Đã bán 120</span>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-lg font-bold text-indigo-600">599.000đ</span>
                                                </div>
                                            </div>
                                        </a>
                                        <a href="/product/2"
                                            class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                                            <div class="h-64 bg-gray-200 flex items-center justify-center">
                                                <img src="https://picsum.photos/seed/product2/400/500.jpg"
                                                    alt="Sản phẩm 2" class="w-full h-full object-cover">
                                            </div>
                                            <div class="p-4">
                                                <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Áo sơ mi
                                                    trắng</h3>
                                                <div class="flex items-center text-sm text-yellow-500 mb-2">
                                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                                    <span class="ml-1 text-gray-700 font-medium">4.8</span>
                                                    <span class="mx-2 text-gray-300">|</span>
                                                    <span class="text-gray-500 text-xs">Đã bán 85</span>
                                                </div>
                                                <div class="flex justify-between items-center">
                                                    <span class="text-lg font-bold text-indigo-600">399.000đ</span>
                                                </div>
                                            </div>
                                        </a>
                                        <a href="/product/3"
                                            class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                                            <div class="h-64 bg-gray-200 flex items-center justify-center">
                                                <img src="https://picsum.photos/seed/product3/400/500.jpg"
                                                    alt="Sản phẩm 3" class="w-full h-full object-cover">
                                            </div>
                                            <div class="p-4">
                                                <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Quần
                                                    jeans</h3>
                                                <div class="flex items-center text-sm text-yellow-500 mb-2">
