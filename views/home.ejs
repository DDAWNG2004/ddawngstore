<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DDAWNG Store - Thời trang cao cấp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <h1 class="text-2xl font-bold text-indigo-600">DDAWNG</h1>
                </div>
                <nav class="hidden md:flex space-x-8">
                    <a href="/" class="text-gray-700 hover:text-indigo-600 transition">Trang chủ</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Sản phẩm</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Về chúng tôi</a>
                    <a href="#" class="text-gray-700 hover:text-indigo-600 transition">Liên hệ</a>
                </nav>
                <div class="flex items-center space-x-4">
                    <!-- Thanh tìm kiếm -->
                    <div class="hidden md:flex items-center bg-gray-100 rounded-lg px-3 py-2">
                        <input type="text" placeholder="Tìm kiếm..." class="bg-transparent outline-none text-sm w-32 lg:w-48">
                        <button class="text-gray-500 hover:text-gray-700 ml-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </button>
                    </div>
                    <!-- Icon tìm kiếm mobile -->
                    <button class="md:hidden text-gray-700 hover:text-indigo-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                    <!-- Account Section -->
                    <% if (typeof customer !== 'undefined' && customer) { %>
                        <!-- Đã đăng nhập -->
                        <div class="relative">
                            <button onclick="toggleAccountMenu()" class="flex items-center space-x-2 text-gray-700 hover:text-indigo-600 transition">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <span class="hidden md:block text-sm"><%= customer.name || customer.email %></span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            
                            <!-- Dropdown Menu -->
                            <div id="accountMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50">
                                <a href="/customer/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        <span>Tài khoản</span>
                                    </div>
                                </a>
                                <a href="/customer/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                                        </svg>
                                        <span>Đơn hàng</span>
                                    </div>
                                </a>
                                <a href="/customer/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        </svg>
                                        <span>Cài đặt</span>
                                    </div>
                                </a>
                                <hr class="my-1">
                                <a href="/customer/logout" class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100">
                                    <div class="flex items-center space-x-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                        </svg>
                                        <span>Đăng xuất</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Chưa đăng nhập -->
                        <div class="hidden md:flex items-center space-x-2">
                            <a href="/customer/login" class="text-gray-700 hover:text-indigo-600 transition text-sm">
                                Đăng nhập
                            </a>
                            <span class="text-gray-400">|</span>
                            <a href="/customer/register" class="text-gray-700 hover:text-indigo-600 transition text-sm">
                                Đăng ký
                            </a>
                        </div>
                        <!-- Icon user mobile -->
                        <button class="md:hidden text-gray-700 hover:text-indigo-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </button>
                    <% } %>
                    <button onclick="window.location.href='/customer/login'" class="md:hidden text-gray-700 hover:text-indigo-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </button>
                    <a href="/cart" class="text-gray-700 hover:text-indigo-600 relative">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center cart-count leading-none" style="display: none; align-items: center; justify-content: center; text-align: center; line-height: 1.25;">0</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Banner -->
    <section class="relative h-96 bg-gradient-to-r from-indigo-500 to-purple-600">
        <div class="absolute inset-0 bg-black opacity-40"></div>
        <div class="relative container mx-auto px-4 h-full flex items-center">
            <div class="text-white max-w-2xl">
                <h2 class="text-5xl font-bold mb-4">Bộ sưu tập mới 2024</h2>
                <p class="text-xl mb-8">Khám phá những thiết kế thời trang đẳng cấp với chất lượng vượt trội</p>
                <button class="bg-white text-indigo-600 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition">
                    Khám phá ngay
                </button>
            </div>
        </div>
    </section>

    <!-- Categories -->
    <section class="py-16">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12">Danh mục sản phẩm</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(category => { %>
                        <div onclick="filterByCategory('<%= category.id %>')" class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                            <div class="h-48 bg-gradient-to-br from-indigo-100 to-purple-200 flex items-center justify-center">
                                <span class="text-6xl">👗</span>
                            </div>
                            <div class="p-6">
                                <h3 class="text-xl font-semibold mb-2"><%= category.name %></h3>
                                <p class="text-gray-600"><%= category.description || 'Khám phá ngay' %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback categories if no data -->
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                        <div class="h-48 bg-gradient-to-br from-pink-100 to-pink-200 flex items-center justify-center">
                            <span class="text-6xl">👗</span>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold mb-2">Váy</h3>
                            <p class="text-gray-600">Thiết kế thanh lịch</p>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                        <div class="h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
                            <span class="text-6xl">👔</span>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold mb-2">Áo sơ mi</h3>
                            <p class="text-gray-600">Phong cách công sở và thời trang</p>
                        </div>
                    </div>
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition cursor-pointer">
                        <div class="h-48 bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
                            <span class="text-6xl">👖</span>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-semibold mb-2">Quần</h3>
                            <p class="text-gray-600">Thoải mái và đa dạng kiểu dáng</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section class="py-16 bg-gray-100">
        <div class="container mx-auto px-4">
            <% if (currentCategory) { %>
                <div class="mb-6 text-center">
                    <p class="text-lg text-gray-600">
                        Đang hiển thị sản phẩm theo danh mục
                        <button onclick="clearCategoryFilter()" class="ml-2 text-indigo-600 hover:text-indigo-800 underline">
                            Xem tất cả sản phẩm
                        </button>
                    </p>
                </div>
            <% } %>
            <h2 class="text-3xl font-bold text-center mb-12">Sản phẩm nổi bật</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <a href="/product/<%= product.id %>" class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                                <div class="h-64 bg-gray-200 flex items-center justify-center">
                                    <% if (product.image_url) { %>
                                        <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <img src="https://picsum.photos/seed/<%= product.id %>/400/500.jpg" alt="<%= product.name %>" class="w-full h-full object-cover">
                                    <% } %>
                                </div>
                                <div class="p-4">
                                    <h3 class="font-semibold mb-2 hover:text-indigo-600 transition"><%= product.name %></h3>
                                    <p class="text-gray-600 text-sm mb-2"><%= product.description || 'Sản phẩm chất lượng cao' %></p>
                                    <% if (product.category_name) { %>
                                        <span class="inline-block bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded mb-2">
                                            <%= product.category_name %>
                                        </span>
                                    <% } %>
                                    <div class="flex justify-between items-center">
                                        <span class="text-lg font-bold text-indigo-600">
                                            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
                                        </span>
                                    </div>
                                </div>
                            </a>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback products if no data -->
                    <a href="/product/1" class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                        <div class="h-64 bg-gray-200 flex items-center justify-center">
                            <img src="https://picsum.photos/seed/product1/400/500.jpg" alt="Sản phẩm 1" class="w-full h-full object-cover">
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Váy hoa nhí</h3>
                            <p class="text-gray-600 text-sm mb-2">Thiết kế vintage</p>
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-bold text-indigo-600">599.000đ</span>
                            </div>
                        </div>
                    </a>
                    <a href="/product/2" class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                        <div class="h-64 bg-gray-200 flex items-center justify-center">
                            <img src="https://picsum.photos/seed/product2/400/500.jpg" alt="Sản phẩm 2" class="w-full h-full object-cover">
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Áo sơ mi trắng</h3>
                            <p class="text-gray-600 text-sm mb-2">Classic style</p>
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-bold text-indigo-600">399.000đ</span>
                            </div>
                        </div>
                    </a>
                    <a href="/product/3" class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                        <div class="h-64 bg-gray-200 flex items-center justify-center">
                            <img src="https://picsum.photos/seed/product3/400/500.jpg" alt="Sản phẩm 3" class="w-full h-full object-cover">
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Quần jeans</h3>
                            <p class="text-gray-600 text-sm mb-2">Modern fit</p>
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-bold text-indigo-600">499.000đ</span>
                            </div>
                        </div>
                    </a>
                    <a href="/product/4" class="block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition cursor-pointer">
                        <div class="h-64 bg-gray-200 flex items-center justify-center">
                            <img src="https://picsum.photos/seed/product4/400/500.jpg" alt="Sản phẩm 4" class="w-full h-full object-cover">
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold mb-2 hover:text-indigo-600 transition">Váy công sở</h3>
                            <p class="text-gray-600 text-sm mb-2">Elegant style</p>
                            <div class="flex justify-between items-center">
                                <span class="text-lg font-bold text-indigo-600">699.000đ</span>
                            </div>
                        </div>
                    </a>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">DDAWNG Store</h3>
                    <p class="text-gray-400">Thời trang cao cấp cho mọi phong cách</p>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Sản phẩm</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white transition">Váy nữ</a></li>
                        <li><a href="#" class="hover:text-white transition">Áo sơ mi</a></li>
                        <li><a href="#" class="hover:text-white transition">Quần</a></li>
                        <li><a href="#" class="hover:text-white transition">Phụ kiện</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Hỗ trợ</h4>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white transition">Hướng dẫn mua hàng</a></li>
                        <li><a href="#" class="hover:text-white transition">Chính sách đổi trả</a></li>
                        <li><a href="#" class="hover:text-white transition">Vận chuyển</a></li>
                        <li><a href="#" class="hover:text-white transition">Liên hệ</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold mb-4">Theo dõi chúng tôi</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400">
                <p>&copy; 2024 DDAWNG Store. Tất cả quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>

<script>
function filterByCategory(categoryId) {
    const url = new URL(window.location);
    url.searchParams.set('category', categoryId);
    window.location.href = url.toString();
}

function clearCategoryFilter() {
    const url = new URL(window.location);
    url.searchParams.delete('category');
    window.location.href = url.toString();
}

function toggleAccountMenu() {
    const menu = document.getElementById('accountMenu');
    menu.classList.toggle('hidden');
}

// Add to cart from home page
async function addToCartFromHome(button) {
    console.log('🛒 Add to cart from home button clicked');
    
    const productData = {
        id: parseInt(button.dataset.productId),
        name: button.dataset.productName,
        price: parseFloat(button.dataset.productPrice),
        stock: parseInt(button.dataset.productStock)
    };
    
    console.log('📊 Product data:', productData);
    
    try {
        const response = await fetch('/cart/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                productId: productData.id,
                quantity: 1, // Default quantity from home page
                sizeId: null,
                colorId: null
            })
        });
        
        console.log('📡 Response status:', response.status);
        const result = await response.json();
        console.log('📦 Response result:', result);
        
        if (result.success) {
            // Show success message
            showNotification('Đã thêm "' + result.productName + '" vào giỏ hàng!', 'success');
            
            // Update cart count if exists
            updateCartCount(result.cartCount);
        } else {
            if (result.requiresLogin) {
                // Show login modal or redirect
                if (confirm('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng. Đăng nhập ngay?')) {
                    window.location.href = '/customer/login';
                }
            } else {
                showNotification(result.message, 'error');
            }
        }
    } catch (error) {
        console.error('❌ Error adding to cart:', error);
        showNotification('Lỗi khi thêm vào giỏ hàng', 'error');
    }
}

// Show notification
function showNotification(message, type = 'info') {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
        type === 'success' ? 'bg-green-500 text-white' :
        type === 'error' ? 'bg-red-500 text-white' :
        'bg-blue-500 text-white'
    }`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.remove();
    }, 3000);
}

// Update cart count in header
function updateCartCount(count) {
    const cartCountElements = document.querySelectorAll('.cart-count');
    cartCountElements.forEach(element => {
        element.textContent = count;
        element.style.display = count > 0 ? 'inline' : 'none';
    });
}

// Load cart count on page load
async function loadCartCount() {
    try {
        const response = await fetch('/cart/count');
        const result = await response.json();
        updateCartCount(result.count);
    } catch (error) {
        console.error('Error loading cart count:', error);
    }
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
    loadCartCount();
});

// Close dropdown when clicking outside
document.addEventListener('click', function(event) {
    const menu = document.getElementById('accountMenu');
    const button = event.target.closest('button[onclick="toggleAccountMenu()"]');
    
    if (!button && !menu.contains(event.target)) {
        menu.classList.add('hidden');
    }
});
</script>
</body>
</html>
