    <script>
        function filterByCategory(categoryId) {
            const url = new URL(window.location);
            url.searchParams.set('category', categoryId);
            window.location.href = url.toString();
        }

        function clearCategoryFilter() {
            const url = new URL(window.location);
            url.searchParams.delete('category');
            window.location.href = url.toString();
        }

        function toggleAccountMenu() {
            const menu = document.getElementById('accountMenu');
            menu.classList.toggle('hidden');
        }

        // Add to cart from home page
        async function addToCartFromHome(button) {
            console.log('🛒 Add to cart from home button clicked');

            const productData = {
                id: parseInt(button.dataset.productId),
                name: button.dataset.productName,
                price: parseFloat(button.dataset.productPrice),
                stock: parseInt(button.dataset.productStock)
            };

            console.log('📊 Product data:', productData);

            try {
                const response = await fetch('/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        productId: productData.id,
                        quantity: 1, // Default quantity from home page
                        sizeId: null,
                        colorId: null
                    })
                });

                console.log('📡 Response status:', response.status);
                const result = await response.json();
                console.log('📦 Response result:', result);

                if (result.success) {
                    // Show success message
                    showNotification('Đã thêm "' + result.productName + '" vào giỏ hàng!', 'success');

                    // Update cart count if exists
                    updateCartCount(result.cartCount);
                } else {
                    if (result.requiresLogin) {
                        // Show login modal or redirect
                        if (confirm('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng. Đăng nhập ngay?')) {
                            window.location.href = '/customer/login';
                        }
                    } else {
                        showNotification(result.message, 'error');
                    }
                }
            } catch (error) {
                console.error('❌ Error adding to cart:', error);
                showNotification('Lỗi khi thêm vào giỏ hàng', 'error');
            }
        }

        // Show notification
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${type === 'success' ? 'bg-green-500 text-white' :
                type === 'error' ? 'bg-red-500 text-white' :
                    'bg-blue-500 text-white'
                }`;
            notification.textContent = message;

            document.body.appendChild(notification);

            setTimeout(() => {
                notification.remove();
            }, 3000);
        }

        // Update cart count in header
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
                element.style.display = count > 0 ? 'inline' : 'none';
            });
        }

        // Load cart count on page load
        async function loadCartCount() {
            try {
                const response = await fetch('/cart/count');
                const result = await response.json();
                updateCartCount(result.count);
            } catch (error) {
                console.error('Error loading cart count:', error);
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function () {
            loadCartCount();
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            const menu = document.getElementById('accountMenu');
            const button = event.target.closest('button[onclick="toggleAccountMenu()"]');

            if (menu && !button && !menu.contains(event.target)) {
                menu.classList.add('hidden');
            }
        });

        // Carousel Logic
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-item');
        const dots = document.querySelectorAll('.carousel-dot');
        const totalSlides = slides.length;
        let slideInterval;

        function updateSlideStates() {
            slides.forEach((slide, index) => {
                if (index === currentSlide) {
                    slide.classList.remove('opacity-0', 'z-0');
                    slide.classList.add('opacity-100', 'z-10');
                } else {
                    slide.classList.remove('opacity-100', 'z-10');
                    slide.classList.add('opacity-0', 'z-0');
                }
            });

            dots.forEach((dot, index) => {
                if (index === currentSlide) {
                    dot.classList.remove('bg-white/40');
                    dot.classList.add('bg-white');
                } else {
                    dot.classList.remove('bg-white');
                    dot.classList.add('bg-white/40');
                }
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % totalSlides;
            updateSlideStates();
            resetInterval();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
            updateSlideStates();
            resetInterval();
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlideStates();
            resetInterval();
        }

        function resetInterval() {
            clearInterval(slideInterval);
            slideInterval = setInterval(nextSlide, 5000); // 5 seconds interval
        }

        // Initialize carousel interval
        if (totalSlides > 0) {
            resetInterval();
            updateSlideStates();
        }

        // Buy Now / View Details Logic from Banner
        function buyNowFromBanner(button) {
            console.log('🔗 Redirecting to product details from banner');
            const productId = parseInt(button.dataset.productId);
            
            if (productId) {
                // Thêm hiệu ứng loading nhỏ ở nút bấm (tuỳ chọn)
                const originalBtnHtml = button.innerHTML;
                button.innerHTML = '<svg class="animate-spin h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
                button.disabled = true;

                // Redirect immediately to the product page
                window.location.href = '/product/' + productId;
            }
        }

        // Show More Products Logic
        function showMoreProducts() {
            const hiddenProducts = document.querySelectorAll('.extra-product.hidden');
            hiddenProducts.forEach(el => {
                el.classList.remove('hidden');
                // Simple fade-in animation
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                
                requestAnimationFrame(() => {
                    el.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                    
                    // Cleanup inline styles after animation to restore normal CSS classes behavior
                    setTimeout(() => {
                        el.style.opacity = '';
                        el.style.transform = '';
                        el.style.transition = '';
                    }, 500);
                });
            });
            document.getElementById('showMoreContainer').style.display = 'none';
        }
    </script>
