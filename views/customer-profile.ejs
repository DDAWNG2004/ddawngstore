<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tài khoản - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white shadow rounded-lg p-6">
                    <div class="text-center mb-6">
                        <form id="avatarForm" action="/customer/profile/avatar" method="POST" enctype="multipart/form-data" class="inline-block">
                            <label for="avatarInput" class="cursor-pointer group relative inline-block">
                                <div class="w-20 h-20 rounded-full mx-auto mb-2 overflow-hidden border-2 border-gray-200 group-hover:border-indigo-400 transition">
                                    <img src="<%= customer.avatar || '/images/avatardefault.jpg' %>" alt="Avatar" class="w-full h-full object-cover">
                                </div>
                                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                                    <span class="bg-black bg-opacity-50 text-white text-xs px-2 py-1 rounded-full">Đổi ảnh</span>
                                </div>
                                <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden" onchange="document.getElementById('avatarForm').submit()">
                            </label>
                        </form>
                        <h3 class="text-lg font-medium text-gray-900"><%= customer.full_name %></h3>
                        <p class="text-sm text-gray-500"><%= customer.email %></p>
                    </div>
                    
                    <nav class="space-y-1">
                        <a href="/customer/profile" class="bg-indigo-50 text-indigo-700 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Tài khoản
                        </a>
                        <a href="/customer/orders" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            Đơn hàng
                        </a>
                        <a href="/customer/settings" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            Cài đặt
                        </a>
                        <a href="/customer/logout" class="text-gray-700 hover:bg-gray-50 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Đăng xuất
                        </a>
                    </nav>
                </div>
            </div>

            <!-- Content -->
            <div class="lg:col-span-3">
                <div class="bg-white shadow rounded-lg p-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Thông tin tài khoản</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-lg font-medium text-gray-900 mb-4">Thông tin cá nhân</h3>
                            <dl class="space-y-3">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Họ tên</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= customer.full_name %></dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Email</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= customer.email %></dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Điện thoại</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= customer.phone || 'Chưa cập nhật' %></dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Địa chỉ</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= customer.address || 'Chưa cập nhật' %></dd>
                                </div>
                            </dl>
                        </div>
                        
                        <div>
                            <h3 class="text-lg font-medium text-gray-900 mb-4">Thống kê</h3>
                            <dl class="space-y-3">
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Tổng đơn hàng</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= orders.length %></dd>
                                </div>
                                <div>
                                    <dt class="text-sm font-medium text-gray-500">Ngày tham gia</dt>
                                    <dd class="mt-1 text-sm text-gray-900"><%= new Date(customer.created_at).toLocaleDateString('vi-VN') %></dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                    
                    <!-- Update Personal Information -->
                    <div class="mt-8 border-t pt-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Cập nhật thông tin cá nhân</h3>
                        <form action="/customer/profile" method="POST" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label for="updateFullName" class="block text-sm font-medium text-gray-700">Họ tên</label>
                                    <input type="text" id="updateFullName" name="fullName" value="<%= customer.full_name %>" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                </div>
                                <div>
                                    <label for="updateEmail" class="block text-sm font-medium text-gray-700">Email</label>
                                    <input type="email" id="updateEmail" name="email" value="<%= customer.email %>" disabled class="mt-1 block w-full border-gray-300 rounded-md shadow-sm bg-gray-100 sm:text-sm">
                                    <p class="mt-1 text-sm text-gray-500">Email không thể thay đổi</p>
                                </div>
                                <div>
                                    <label for="updatePhone" class="block text-sm font-medium text-gray-700">Điện thoại</label>
                                    <input type="tel" id="updatePhone" name="phone" value="<%= customer.phone || '' %>" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                </div>
                                <div>
                                    <label for="updateAddress" class="block text-sm font-medium text-gray-700">Địa chỉ</label>
                                    <textarea id="updateAddress" name="address" rows="3" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"><%= customer.address || '' %></textarea>
                                </div>
                            </div>
                            <div class="flex justify-end">
                                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">
                                    Cập nhật thông tin
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <% if (orders.length > 0) { %>
                        <div class="mt-8">
                            <h3 class="text-lg font-medium text-gray-900 mb-4">Đơn hàng gần đây</h3>
                            <div class="space-y-4">
                                <% orders.slice(0, 3).forEach(order => { %>
                                    <div class="border rounded-lg p-4">
                                        <div class="flex justify-between items-start">
                                            <div>
                                                <p class="font-medium text-gray-900">Đơn hàng #<%= order.id %></p>
                                                <p class="text-sm text-gray-500">Ngày đặt: <%= new Date(order.created_at).toLocaleDateString('vi-VN') %></p>
                                                <p class="text-sm text-gray-500">Tổng tiền: <%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</p>
                                            </div>
                                            <span class="px-2 py-1 text-xs font-medium rounded-full 
                                                <% if (order.status === 'pending') { %>bg-yellow-100 text-yellow-800<% } %>
                                                <% if (order.status === 'confirmed') { %>bg-blue-100 text-blue-800<% } %>
                                                <% if (order.status === 'processing') { %>bg-purple-100 text-purple-800<% } %>
                                                <% if (order.status === 'shipped') { %>bg-indigo-100 text-indigo-800<% } %>
                                                <% if (order.status === 'delivered') { %>bg-green-100 text-green-800<% } %>
                                                <% if (order.status === 'cancelled') { %>bg-red-100 text-red-800<% } %>
                                            ">
                                                <%= order.status === 'pending' ? 'Chờ xử lý' : '' %>
                                                <%= order.status === 'confirmed' ? 'Đã xác nhận' : '' %>
                                                <%= order.status === 'processing' ? 'Đang xử lý' : '' %>
                                                <%= order.status === 'shipped' ? 'Đang giao' : '' %>
                                                <%= order.status === 'delivered' ? 'Đã giao' : '' %>
                                                <%= order.status === 'cancelled' ? 'Đã hủy' : '' %>
                                            </span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <% if (orders.length > 3) { %>
                                <div class="mt-4 text-center">
                                    <a href="/customer/orders" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                                        Xem tất cả đơn hàng →
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="mt-8 text-center py-8 bg-gray-50 rounded-lg">
                            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <h3 class="text-lg font-medium text-gray-900 mb-2">Chưa có đơn hàng</h3>
                            <p class="text-gray-500">Bạn chưa đặt đơn hàng nào. Hãy mua sắm ngay!</p>
                            <div class="mt-6">
                                <a href="/products" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                    Mua sắm ngay
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
