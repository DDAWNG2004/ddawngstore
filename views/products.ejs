<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sản phẩm - DDAWNG Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Custom scrollbar for filters if needed */
        .filter-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .filter-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .filter-scroll::-webkit-scrollbar-thumb {
            background: #c7c7cc;
            border-radius: 4px;
        }
    </style>
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <%- include('partials/header') %>

    <!-- Page Content -->
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Breadcrumb & Page Title -->
        <div class="mb-8 border-b border-gray-200 pb-6">
            <nav class="flex text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="/" class="hover:text-indigo-600 transition-colors">Trang chủ</a></li>
                    <li><span class="mx-2">/</span></li>
                    <li class="text-gray-900 font-medium" aria-current="page">Sản phẩm</li>
                </ol>
            </nav>
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 font-serif">
                        <%= query.search ? ' Kết quả tìm kiếm cho "' + query.search + '"' : ' Tất cả sản phẩm' %>
                                        </h1>
                                        <p class="mt-2 text-sm text-gray-500">Hiển thị <%= products.length %> kết quả
                                        </p>
                        </div>

                        <!-- Mobile Filter Toggle & Sort (Desktop) -->
                        <div class="flex items-center gap-4">
                            <button id="mobileFilterBtn"
                                class="md:hidden flex items-center gap-2 bg-white border border-gray-300 px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50">
                                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4">
                                    </path>
                                </svg>
                                Bộ lọc
                            </button>

                            <div class="relative inline-block w-full md:w-auto">
                                <select form="filterForm" name="sort"
                                    onchange="document.getElementById('filterForm').submit()"
                                    class="block w-full bg-white border border-gray-300 text-gray-700 py-2.5 px-4 pr-8 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 appearance-none text-sm font-medium cursor-pointer shadow-sm transition-all">
                                    <option value="newest" <%=!query.sort || query.sort==='newest' ? 'selected' : '' %>
                                        >Mới nhất</option>
                                    <option value="price_asc" <%=query.sort==='price_asc' ? 'selected' : '' %>>Giá: Thấp
                                        đến Cao</option>
                                    <option value="price_desc" <%=query.sort==='price_desc' ? 'selected' : '' %>>Giá:
                                        Cao đến Thấp</option>
                                </select>
                                <div
                                    class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>
                </div>
            </div>

            <div class="flex flex-col md:flex-row gap-8">

                <!-- Filter Sidebar -->
                <aside id="filterSidebar" class="w-full md:w-1/4 lg:w-1/5 hidden md:block">
                    <form id="filterForm" action="/products" method="GET"
                        class="sticky top-24 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="text-lg font-bold text-gray-900">Bộ lọc</h2>
                            <% if(Object.keys(query).length> 0) { %>
                                <a href="/products"
                                    class="text-sm text-indigo-600 hover:text-indigo-800 font-medium transition-colors">Xóa
                                    lọc</a>
                                <% } %>
                        </div>

                        <% if(query.search) { %>
                            <input type="hidden" name="search" value="<%= query.search %>">
                            <% } %>

                                <!-- Mục lục Sản phẩm (Categories) -->
                                <div class="mb-8">
                                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Danh mục
                                    </h3>
                                    <div class="space-y-3 filter-scroll max-h-48 overflow-y-auto pr-2">
                                        <% categories.forEach(category=> {
                                            let isChecked = false;
                                            if(query.category) {
                                            if(Array.isArray(query.category)) isChecked =
                                            query.category.includes(category.id.toString());
                                            else isChecked = query.category === category.id.toString();
                                            }
                                            %>
                                            <div class="flex items-center group">
                                                <input type="checkbox" id="cat-<%= category.id %>" name="category"
                                                    value="<%= category.id %>" <%=isChecked ? 'checked' : '' %>
                                                class="w-4 h-4 text-indigo-600 bg-gray-100 border-gray-300 rounded
                                                focus:ring-indigo-500 focus:ring-2 cursor-pointer transition-colors
                                                transition-transform group-hover:scale-110">
                                                <label for="cat-<%= category.id %>"
                                                    class="ml-3 text-sm text-gray-600 group-hover:text-gray-900 cursor-pointer flex-1 transition-colors">
                                                    <%= category.name %>
                                                </label>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>

                                <div class="w-full h-px bg-gray-200 mb-8"></div>

                                <!-- Mức Giá (Price Range) -->
                                <div class="mb-8">
                                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Mức giá
                                    </h3>
                                    <div class="flex items-center gap-3">
                                        <div class="relative flex-1">
                                            <input type="number" name="minPrice" placeholder="Từ"
                                                value="<%= query.minPrice || '' %>"
                                                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none">
                                        </div>
                                        <span class="text-gray-400 font-medium">-</span>
                                        <div class="relative flex-1">
                                            <input type="number" name="maxPrice" placeholder="Đến"
                                                value="<%= query.maxPrice || '' %>"
                                                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none">
                                        </div>
                                    </div>
                                </div>

                                <div class="w-full h-px bg-gray-200 mb-8"></div>

                                <!-- Kích thước (Sizes) -->
                                <div class="mb-8">
                                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Kích thước
                                    </h3>
                                    <div class="grid grid-cols-3 gap-2">
                                        <% sizes.forEach(size=> {
                                            let isChecked = false;
                                            if(query.size) {
                                            if(Array.isArray(query.size)) isChecked =
                                            query.size.includes(size.id.toString());
                                            else isChecked = query.size === size.id.toString();
                                            }
                                            %>
                                            <div class="relative block">
                                                <input type="checkbox" id="size-<%= size.id %>" name="size"
                                                    value="<%= size.id %>" class="peer sr-only" <%=isChecked ? 'checked'
                                                    : '' %>>
                                                <label for="size-<%= size.id %>"
                                                    class="flex items-center justify-center py-2 px-1 text-xs font-semibold uppercase border rounded-lg cursor-pointer bg-white border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-gray-300 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 peer-focus:ring-2 peer-focus:ring-offset-2 peer-focus:ring-indigo-500 transition-all">
                                                    <%= size.name %>
                                                </label>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>

                                <div class="w-full h-px bg-gray-200 mb-8"></div>

                                <!-- Màu sắc (Colors) -->
                                <div class="mb-8">
                                    <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">Màu sắc
                                    </h3>
                                    <div class="flex flex-wrap gap-3">
                                        <% colors.forEach(color=> {
                                            let isChecked = false;
                                            if(query.color) {
                                            if(Array.isArray(query.color)) isChecked =
                                            query.color.includes(color.id.toString());
                                            else isChecked = query.color === color.id.toString();
                                            }
                                            %>
                                            <div class="relative group">
                                                <input type="checkbox" id="color-<%= color.id %>" name="color"
                                                    value="<%= color.id %>" class="peer sr-only" <%=isChecked
                                                    ? 'checked' : '' %>>
                                                <label for="color-<%= color.id %>"
                                                    class="block w-8 h-8 rounded-full border border-gray-200 cursor-pointer peer-focus:ring-2 peer-focus:ring-offset-2 peer-focus:ring-indigo-500 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-indigo-600 transition-all transform group-hover:scale-110 shadow-sm"
                                                    style="background-color: <%= color.hex_code %>; <%= color.hex_code.toUpperCase() === '#FFFFFF' ? 'border-color: #E5E7EB;' : 'border-color: rgba(0,0,0,0.1);' %>"
                                                    title="<%= color.name %>">
                                                </label>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>

                                <button type="submit"
                                    class="w-full bg-indigo-600 text-white font-semibold py-3 px-4 rounded-xl hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all shadow-md hover:shadow-lg flex justify-center items-center gap-2">
                                    <span>Áp dụng bộ lọc</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                    </svg>
                                </button>

                                <!-- Mobile Close Filter Button -->
                                <button type="button" id="closeFilterBtn"
                                    class="mt-4 w-full bg-white text-gray-700 font-medium py-3 px-4 rounded-xl hover:bg-gray-50 border border-gray-200 transition-all md:hidden">
                                    Đóng bộ lọc
                                </button>
                    </form>
                </aside>

                <!-- Product Grid -->
                <section class="w-full md:w-3/4 lg:w-4/5">
                    <% if (products.length===0) { %>
                        <div
                            class="text-center py-20 bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center justify-center">
                            <div class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mb-6">
                                <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                    </path>
                                </svg>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-800 mb-2 font-serif">Không tìm thấy sản phẩm</h2>
                            <p class="text-gray-500 mb-8 max-w-sm">Chúng tôi không thể tìm thấy sản phẩm phù hợp với
                                tiêu chí của bạn. Hãy thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
                            <a href="/products"
                                class="bg-indigo-600 text-white px-8 py-3 rounded-full font-medium hover:bg-indigo-700 transition shadow-md hover:shadow-lg">
                                Xóa tất cả bộ lọc
                            </a>
                        </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                                <% products.forEach(product=> { %>
                                    <div
                                        class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-xl transition-all duration-300 group flex flex-col h-full transform hover:-translate-y-1">
                                        <div class="relative overflow-hidden aspect-[4/5] bg-gray-100">
                                            <% if (product.image_url) { %>
                                                <img src="<%= product.image_url %>" alt="<%= product.name %>"
                                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                                                <% } else { %>
                                                    <div
                                                        class="w-full h-full flex items-center justify-center text-gray-300">
                                                        <svg class="w-16 h-16" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="1.5"
                                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                            </path>
                                                        </svg>
                                                    </div>
                                                    <% } %>

                                                        <% if (Math.random()> 0.7) { %>
                                                            <div
                                                                class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wide tracking-wider shadow-sm">
                                                                Mới
                                                            </div>
                                                            <% } %>

                                                                <!-- Quick action overlay -->
                                                                <div
                                                                    class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/50 to-transparent p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out flex justify-between items-center opacity-0 group-hover:opacity-100">
                                                                    <button
                                                                        class="bg-white/90 backdrop-blur-sm text-gray-900 p-2 rounded-full hover:bg-indigo-600 hover:text-white transition-colors"
                                                                        title="Thêm vào yêu thích">
                                                                        <svg class="w-5 h-5" fill="none"
                                                                            stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round"
                                                                                stroke-linejoin="round" stroke-width="2"
                                                                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                                                                            </path>
                                                                        </svg>
                                                                    </button>
                                                                    <a href="/product/<%= product.id %>"
                                                                        class="bg-white/90 backdrop-blur-sm text-gray-900 px-4 py-2 rounded-full text-sm font-semibold hover:bg-indigo-600 hover:text-white transition-colors">
                                                                        Chi tiết
                                                                    </a>
                                                                </div>
                                        </div>

                                        <div class="p-5 flex flex-col flex-grow">
                                            <div
                                                class="text-xs font-semibold text-indigo-600 uppercase tracking-wider mb-2">
                                                <%= product.category_name %>
                                            </div>
                                            <a href="/product/<%= product.id %>"
                                                class="block group-hover:text-indigo-600 transition-colors">
                                                <h3
                                                    class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 leading-tight">
                                                    <%= product.name %>
                                                </h3>
                                            </a>
                                            <div
                                                class="mt-auto flex items-center justify-between pt-4 border-t border-gray-100">
                                                <p class="text-xl font-bold text-gray-900 font-serif">
                                                    <%= new Intl.NumberFormat('vi-VN', { style: 'currency' ,
                                                        currency: 'VND' }).format(product.price) %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>

                            <!-- Pagination (Placeholder) -->
                            <div class="mt-12 flex justify-center">
                                <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px"
                                    aria-label="Pagination">
                                    <a href="#"
                                        class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-indigo-600 transition-colors">
                                        <span class="sr-only">Trang trước</span>
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M15 19l-7-7 7-7"></path>
                                        </svg>
                                    </a>
                                    <a href="#" aria-current="page"
                                        class="z-10 bg-indigo-50 border-indigo-500 text-indigo-600 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
                                        1
                                    </a>
                                    <a href="#"
                                        class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium hover:text-indigo-600 transition-colors">
                                        2
                                    </a>
                                    <a href="#"
                                        class="bg-white border-gray-300 text-gray-500 hover:bg-gray-50 relative inline-flex items-center px-4 py-2 border text-sm font-medium hover:text-indigo-600 transition-colors">
                                        3
                                    </a>
                                    <a href="#"
                                        class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-indigo-600 transition-colors">
                                        <span class="sr-only">Trang sau</span>
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </a>
                                </nav>
                            </div>
                            <% } %>
                </section>
            </div>
            </main>

            <!-- Footer -->
            <footer class="bg-white border-t border-gray-200 mt-20 pt-16 pb-8">
                <div class="container mx-auto px-6 lg:px-8">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
                        <div class="col-span-1 md:col-span-1">
                            <h2 class="text-2xl font-bold text-indigo-600 mb-6 font-serif">DDAWNG</h2>
                            <p class="text-gray-500 text-sm leading-relaxed mb-6">Thương hiệu thời trang cao cấp mang
                                đến phong cách thanh lịch và hiện đại cho người Việt.</p>
                            <div class="flex space-x-4">
                                <a href="#" class="text-gray-400 hover:text-indigo-600 transition-colors"><svg
                                        class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z" />
                                    </svg></a>
                                <a href="#" class="text-gray-400 hover:text-indigo-600 transition-colors"><svg
                                        class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                        <path
                                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                    </svg></a>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6">Liên kết nhanh
                            </h3>
                            <ul class="space-y-4">
                                <li><a href="#" class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Về
                                        chúng tôi</a></li>
                                <li><a href="#"
                                        class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Cửa
                                        hàng</a></li>
                                <li><a href="#"
                                        class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Tin
                                        tức</a></li>
                                <li><a href="#"
                                        class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Liên
                                        hệ</a></li>
                            </ul>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6">Hỗ trợ khách hàng
                            </h3>
                            <ul class="space-y-4">
                                <li><a href="#"
                                        class="text-gray-500 hover:text-indigo-600 transition-colors text-sm">Hướng dẫn
                                        mua hàng</a></li>
                                <li><a href="#"
