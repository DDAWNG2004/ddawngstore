            <!-- Scripts -->
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script>
                $(document).ready(function () {
                    // Cập nhật số lượng giỏ hàng
                    function updateCartCount() {
                        $.get('/api/cart/count', function (data) {
                            if (data.count > 0) {
                                $('.cart-count').text(data.count).show();
                            } else {
                                $('.cart-count').hide();
                            }
                        });
                    }
                    updateCartCount();

                    // Mobile Filter Toggle
                    $('#mobileFilterBtn').on('click', function () {
                        $('#filterSidebar').toggleClass('hidden').toggleClass('fixed inset-0 z-50 bg-white p-6 overflow-y-auto block');
                        $('body').toggleClass('overflow-hidden');
                    });

                    $('#closeFilterBtn').on('click', function () {
                        $('#filterSidebar').addClass('hidden').removeClass('fixed inset-0 z-50 bg-white p-6 overflow-y-auto block');
                        $('body').removeClass('overflow-hidden');
                    });
                });
            </script>
