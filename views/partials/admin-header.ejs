<!-- Header -->
<header class="bg-white shadow-sm relative z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
            <div class="flex items-center">
                <!-- Mobile menu button -->
                <button id="admin-mobile-menu-btn" class="md:hidden p-2 -ml-2 mr-2 text-gray-400 hover:text-gray-500 hover:bg-gray-100 rounded-md focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
                    <span class="sr-only">Mở menu chính</span>
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <h1 class="text-2xl font-bold text-indigo-600">DDAWNG Admin</h1>
                <nav class="hidden md:flex space-x-8 ml-10">
                    <a href="/admin/dashboard"
                        class="<% if (typeof activePage !== 'undefined' && activePage === 'dashboard') { %>text-indigo-600 border-b-2 border-indigo-500 pb-4<% } else { %>text-gray-700 hover:text-indigo-600<% } %>">Dashboard</a>
                    <a href="/admin/products"
                        class="<% if (typeof activePage !== 'undefined' && activePage === 'products') { %>text-indigo-600 border-b-2 border-indigo-500 pb-4<% } else { %>text-gray-700 hover:text-indigo-600<% } %>">Sản
                        phẩm</a>
                    <a href="/admin/orders"
                        class="<% if (typeof activePage !== 'undefined' && activePage === 'orders') { %>text-indigo-600 border-b-2 border-indigo-500 pb-4<% } else { %>text-gray-700 hover:text-indigo-600<% } %>">Đơn
                        hàng</a>
                    <a href="/admin/customers"
                        class="<% if (typeof activePage !== 'undefined' && activePage === 'customers') { %>text-indigo-600 border-b-2 border-indigo-500 pb-4<% } else { %>text-gray-700 hover:text-indigo-600<% } %>">Khách
                        hàng</a>
                    <a href="/admin/coupons"
                        class="<% if (typeof activePage !== 'undefined' && activePage === 'coupons') { %>text-indigo-600 border-b-2 border-indigo-500 pb-4<% } else { %>text-gray-700 hover:text-indigo-600<% } %>">Mã
                        giảm giá</a>
                </nav>
            </div>
            <div class="flex items-center space-x-4">
                <span class="text-sm text-gray-700">Xin chào, Admin</span>
                <div class="relative">
                    <button class="text-gray-500 hover:text-indigo-600 transition relative" id="global-notification-btn"
                        title="Thông báo đơn hàng mới">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <!-- Badge số lượng -->
                        <span id="global-new-orders-badge"
                            class="absolute -top-2 -right-2 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-red-600 rounded-full hidden">
                            0
                        </span>
                    </button>
                    <!-- Popup báo đơn -->
                    <div id="global-notification-dropdown"
                        class="absolute right-0 mt-2 w-80 bg-white rounded-md shadow-lg overflow-hidden z-[100] border border-gray-100 hidden">
                        <div
                            class="py-2 px-4 bg-gray-50 border-b border-gray-100 text-sm font-semibold text-gray-700 flex justify-between items-center">
                            Thông báo mới
                            <span id="global-new-orders-text"
                                class="bg-red-100 text-red-600 text-xs px-2 py-0.5 rounded-full font-bold">0</span>
                        </div>
                        <div id="global-notification-list" class="max-h-64 overflow-y-auto divide-y divide-gray-100">
                            <div class="p-4 text-center text-gray-500 text-sm">Chưa có thông báo nào</div>
                        </div>
                        <!-- <div class="p-2 bg-gray-50 border-t border-gray-100 text-center">
                                <a href="/admin/orders" class="text-indigo-600 text-xs hover:underline">Xem tất cả đơn hàng</a>
                            </div> -->
                    </div>
                </div>
                <a href="/admin/logout" class="text-gray-500 hover:text-red-600 transition" title="Đăng xuất">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
    <!-- Mobile Menu -->
    <div id="admin-mobile-menu" class="hidden md:hidden bg-white border-t border-gray-200 shadow-lg absolute w-full left-0 top-full">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <a href="/admin/dashboard" class="block px-3 py-2 rounded-md text-base font-medium <% if (typeof activePage !== 'undefined' && activePage === 'dashboard') { %>text-indigo-600 bg-indigo-50<% } else { %>text-gray-700 hover:text-indigo-600 hover:bg-gray-50<% } %>">Dashboard</a>
            <a href="/admin/products" class="block px-3 py-2 rounded-md text-base font-medium <% if (typeof activePage !== 'undefined' && activePage === 'products') { %>text-indigo-600 bg-indigo-50<% } else { %>text-gray-700 hover:text-indigo-600 hover:bg-gray-50<% } %>">Sản phẩm</a>
            <a href="/admin/orders" class="block px-3 py-2 rounded-md text-base font-medium <% if (typeof activePage !== 'undefined' && activePage === 'orders') { %>text-indigo-600 bg-indigo-50<% } else { %>text-gray-700 hover:text-indigo-600 hover:bg-gray-50<% } %>">Đơn hàng</a>
            <a href="/admin/customers" class="block px-3 py-2 rounded-md text-base font-medium <% if (typeof activePage !== 'undefined' && activePage === 'customers') { %>text-indigo-600 bg-indigo-50<% } else { %>text-gray-700 hover:text-indigo-600 hover:bg-gray-50<% } %>">Khách hàng</a>
            <a href="/admin/coupons" class="block px-3 py-2 rounded-md text-base font-medium <% if (typeof activePage !== 'undefined' && activePage === 'coupons') { %>text-indigo-600 bg-indigo-50<% } else { %>text-gray-700 hover:text-indigo-600 hover:bg-gray-50<% } %>">Mã giảm giá</a>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const adminMobileMenuBtn = document.getElementById('admin-mobile-menu-btn');
        const adminMobileMenu = document.getElementById('admin-mobile-menu');
        if (adminMobileMenuBtn && adminMobileMenu) {
            adminMobileMenuBtn.addEventListener('click', () => {
                adminMobileMenu.classList.toggle('hidden');
            });
        }

        const notifBtn = document.getElementById('global-notification-btn');
        const dropdown = document.getElementById('global-notification-dropdown');
        const badge = document.getElementById('global-new-orders-badge');
        const textEl = document.getElementById('global-new-orders-text');
        const notifList = document.getElementById('global-notification-list');

        if (!notifBtn || !dropdown) return;

        // Hiển thị dropdown
        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
        });

        function createNotificationItem(order) {
            if (notifList.children.length === 1 && notifList.children[0].textContent.includes('Chưa có thông báo')) {
                notifList.innerHTML = '';
            }

            const item = document.createElement('div');
            item.className = 'p-4 hover:bg-gray-50 flex items-start gap-3 relative transition-colors border-b border-gray-100 last:border-0';
            item.innerHTML = `
                    <div class="flex-shrink-0 pt-1">
                        <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center">
                            <svg class="h-4 w-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0 pr-6 cursor-pointer" onclick="dismissGlobalNotification(${order.id}, this.closest('div.p-4'), '/admin/orders/${order.id}')">
                        <p class="text-sm font-medium text-gray-900 truncate hover:text-indigo-600 transition-colors">Mã đơn #${order.id}</p>
                        <p class="text-xs text-gray-500 mt-0.5"><strong class="font-medium text-gray-800">${order.customer_name || 'Khách vãng lai'}</strong> vừa đặt:</p>
                        <p class="text-xs text-gray-400 mt-0.5" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${order.products_preview}</p>
                    </div>
                    <button class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 focus:outline-none" title="Đóng báo này" onclick="dismissGlobalNotification(${order.id}, this.closest('div.p-4'))">
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </button>
                `;
            notifList.prepend(item);
        }

        window.updateGlobalEmptyState = function () {
            if (notifList.children.length === 0) {
                notifList.innerHTML = '<div class="p-4 text-center text-gray-500 text-sm">Chưa có thông báo nào</div>';
            }
        };

        window.dismissGlobalNotification = function (orderId, element, redirectUrl = null) {
            let dismissed = JSON.parse(localStorage.getItem('dismissedOrders') || '[]');
            if (!dismissed.includes(orderId)) {
                dismissed.push(orderId);
                localStorage.setItem('dismissedOrders', JSON.stringify(dismissed));
            }

            element.remove();
            updateGlobalEmptyState();

            let currentCount = parseInt(textEl.textContent) || 0;
            if (currentCount > 0) {
                currentCount--;
                textEl.textContent = currentCount;
                if (currentCount > 0) {
                    badge.textContent = currentCount > 99 ? '99+' : currentCount;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            if (redirectUrl) {
                window.location.href = redirectUrl;
            }
        };

        let lastOrderId = 0;

        async function fetchGlobalOrderNotifications() {
            try {
                const resLatest = await fetch('/admin/api/orders/latest-notifs?lastId=' + lastOrderId);
                const dataLatest = await resLatest.json();

                let dismissed = JSON.parse(localStorage.getItem('dismissedOrders') || '[]');

                if (dataLatest.success && dataLatest.orders.length > 0) {
                    const maxId = Math.max(...dataLatest.orders.map(o => o.id));
                    const newOrders = dataLatest.orders.filter(o => !dismissed.includes(o.id));
                    newOrders.forEach(order => {
                        createNotificationItem(order);
                    });
                    lastOrderId = Math.max(lastOrderId, maxId);
                }

                let count = Array.from(notifList.children).filter(el => !el.textContent.includes('Chưa có thông báo')).length;
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.classList.remove('hidden');
                    textEl.textContent = count;
                } else {
                    badge.classList.add('hidden');
                    textEl.textContent = '0';
                }
            } catch (e) {
                console.error('Failed to load global notifications:', e);
            }
        }

        fetchGlobalOrderNotifications();
        setInterval(fetchGlobalOrderNotifications, 30000);

        document.addEventListener('click', (e) => {
            if (!notifBtn.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });
    });
</script>